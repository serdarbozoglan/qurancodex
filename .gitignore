# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables (API keys)
.env
.env.*

omer.html

# Cache / embeddings (large binary data)
cache/
*.npy

# Local working documents
todo_v*.md

# Legacy data backups (kept locally, excluded from git + deploy)
.local-data/

# Claude Code runtime (agent scheduling locks, transient state)
.claude/*.lock

# Python bytecode (scripts/ helpers)
__pycache__/
*.pyc

# Work-in-progress experimental components — not in repo until ready
src/components/MihverDemo*.jsx

# Next.js migration workspace — build artifacts only (source committed)
next/.next/
next/out/
next/.vercel/

# Playwright visual audit artifacts — keep report.md, exclude screenshots + raw json
docs/reviews/playwright-*/desktop/
docs/reviews/playwright-*/mobile/
docs/reviews/playwright-*/raw-results.json

# Audit screenshot snapshots — regenerable, large; keep .md reports only
docs/screenshots/

# Meal cache prefetch output — regenerable via `node scripts/prefetch-meals.mjs`
# (~50-80MB after full prefetch). Keep _authors.json registry tracked.
next/public/meal-cache/[0-9]*/

# Ephemeral Playwright test scripts — geliştirme sırasında oluşturulan tek-kullanımlık
# doğrulama helper'ları. Sürüm kontrolüne girmez; her batch yeniden oluşturulur.
next/qc-*.mjs
next/check-*.mjs
qc-*.mjs
check-*.mjs
