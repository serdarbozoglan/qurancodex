{"data":{"id":96,"name":"Alak","name_en":"Al-'Alaq","name_original":"سورة العلق","name_translation_tr":"Asılıp Tutunan","name_translation_en":"The Clot","slug":"alak","verse_count":19,"page_number":597,"audio":{"mp3":"https://audio.acikkuran.com/tr/96.mp3","duration":90,"mp3_en":"https://audio.acikkuran.com/en/096.mp3","duration_en":79},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6107,"surah_id":96,"verse_number":1,"verse":"اِقْرَأْ بِاسْمِ رَبِّكَ الَّذ۪ي خَلَقَۚ","verse_simplified":"اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ","page":597,"juz_number":30,"transcription":"Ikra'bismi rabbikellezi halak.","transcription_en":"Iqra/ bi-ismi rabbika allathee khalaq","translation":{"id":313266,"text":"Yaratan Rabb'inin adıyla duyur.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26713,"text":"Ikra, duyurmak, ilan etmek, iletmek demektir. Vahyin ilk ayeti olduğu kabul gören bu ayetteki \"ıkra\" kelimesine \"oku\" anlamını vermek önemli bir yanılgıdır. Henüz ortada okunacak bir metin olmadığına göre, okumaktan söz etmek doğru değildir. Bu kelime ile ifade edilen şey; sana vahyettiğimiz mesajı, aklında tut, derleyip toparla ve ondan sonra da insanlara duyurmaya, ilan etmeye, ulaştırmaya başla demektir. Ikra, kelime anlamı olarak esasen \"bir şeyleri biriktirip onu dağıtmak, başka yerlere nakletmek\" demektir. Bu ayeti, İslam'ın bilgiye verdiği değeri örneklemek için konu edinmek; \"İslam'ın ilk emri okudur\" türü bir tanımlama yapmak doğru değildir. Zira ayet, okumanın öneminden değil, vahyin insanlara duyurulmasından söz etmektedir. Nasıl ki \"ezan okumak\", \"türkü okumak\" dendiği zaman, okunan bir metinden değil de duyurmaktan, söylemekten söz edilmiş olunuyorsa, ayetteki \"ıkra\" kelimesi de duyurmak anlamındadır.","number":1}]}},{"id":6108,"surah_id":96,"verse_number":2,"verse":"خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ","verse_simplified":"خَلَقَ الْإِنسَانَ مِنْ عَلَقٍ","page":597,"juz_number":30,"transcription":"Halakal insane min alak.","transcription_en":"Khalaqa al-insana min AAalaq","translation":{"id":313267,"text":"İnsanı alaktan[1] yarattı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26714,"text":"Döl yatağına tutunan, döl yatağında asılı olan.","number":1}]}},{"id":6109,"surah_id":96,"verse_number":3,"verse":"اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ","verse_simplified":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ","page":597,"juz_number":30,"transcription":"Ikra' ve rabbukel ekrem.","transcription_en":"Iqra/ warabbuka al-akram","translation":{"id":313268,"text":"Duyur, senin Rabb'in en büyük kerem[1] sahibidir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26715,"text":"En cömert, en şerefli, en saygın.","number":1}]}},{"id":6110,"surah_id":96,"verse_number":4,"verse":"اَلَّذ۪ي عَلَّمَ بِالْقَلَمِۙ","verse_simplified":"الَّذِي عَلَّمَ بِالْقَلَمِ","page":597,"juz_number":30,"transcription":"Ellezi alleme bil kalem.","transcription_en":"Allathee AAallama bilqalam","translation":{"id":313269,"text":"Kalemle öğretendir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6111,"surah_id":96,"verse_number":5,"verse":"عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۜ","verse_simplified":"عَلَّمَ الْإِنسَانَ مَا لَمْ يَعْلَمْ","page":597,"juz_number":30,"transcription":"Allemel insane ma lem ya'lem.","transcription_en":"AAallama al-insana ma lamyaAAlam","translation":{"id":313270,"text":"İnsana bilmediğini öğretti.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6112,"surah_id":96,"verse_number":6,"verse":"كَلَّٓا اِنَّ الْاِنْسَانَ لَيَطْغٰىۙ","verse_simplified":"كَلَّا إِنَّ الْإِنسَانَ لَيَطْغَى","page":597,"juz_number":30,"transcription":"Kella innel insane le yatga.","transcription_en":"Kalla inna al-insana layatgha","translation":{"id":313271,"text":"Bu gerçeğe rağmen insan yine de tuğyan[1] eder.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26716,"text":"Haddi aşma, zulüm, azgınlık, sapkınlık, isyan, küfür.","number":1}]}},{"id":6113,"surah_id":96,"verse_number":7,"verse":"اَنْ رَاٰهُ اسْتَغْنٰىۜ","verse_simplified":"أَن رَّآهُ اسْتَغْنَى","page":597,"juz_number":30,"transcription":"En reahustagna.","transcription_en":"An raahu istaghna","translation":{"id":313272,"text":"Kendisini yeterli gördüğü için.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6114,"surah_id":96,"verse_number":8,"verse":"اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۜ","verse_simplified":"إِنَّ إِلَى رَبِّكَ الرُّجْعَى","page":597,"juz_number":30,"transcription":"İnne ila rabbiker ruc'a.","transcription_en":"Inna ila rabbika arrujAAa","translation":{"id":313273,"text":"Oysaki dönüş Rabb'inedir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6115,"surah_id":96,"verse_number":9,"verse":"اَرَاَيْتَ الَّذ۪ي يَنْهٰىۙ","verse_simplified":"أَرَأَيْتَ الَّذِي يَنْهَى","page":597,"juz_number":30,"transcription":"E reeytellezi yenha.","transcription_en":"Araayta allathee yanha","translation":{"id":313274,"text":"Gördün mü şu alıkoyanı?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6116,"surah_id":96,"verse_number":10,"verse":"عَبْداً اِذَا صَلّٰىۜ","verse_simplified":"عَبْدًا إِذَا صَلَّى","page":597,"juz_number":30,"transcription":"Abden iza salla.","transcription_en":"AAabdan itha salla","translation":{"id":313275,"text":"Salla[1] ederken bir kulu!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26717,"text":"Çağrıda bulunan. Salat kelimesi, ilk bu ayette geçmektedir. Bu surenin, vahyedilen ilk sure olduğu dikkate alındığında, \"salla\" kelimesine namaz anlamı vermek önemli bir yanılgıdır. Bu yanılgı; bundan sonra da bu kelimeye, geçtiği her yerde namaz anlamının verilmesine neden olmaktadır. \"Salla\" kelimesi, bu ayette, \"namaz kılmak\" anlamında değil, yönelmek, destek olmak anlamındadır. İbadete layık yegane ilahın Allah olduğuna inanmak, şirkten arınmış bir bilinçle Allah'a yönelme demektir. Bu yönelme: Sürekli destek olmak, dayanışmak, ilgi duymak, duyarlı olmak, izleyici kalmamak, yanında yer almaktır. Salatın diğer anlamları şunlardır: Ritüel salat (Namaz), dua etmek, din, havra. Salatın hangi anlamı ifade ettiği, içinde yer aldığı ayet ve konu bağlamından rahatlıkla anlaşılabilir. Sallanın karşıtı tevelladır. Tevella süreklilik ifade etmektedir; sürekli karşı çıkmak, ilgisiz ve duyarsız kalmak, köstek olmak, engellemeye çalışmak demektir (75:31, 32).","number":1}]}},{"id":6117,"surah_id":96,"verse_number":11,"verse":"اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىۙ","verse_simplified":"أَرَأَيْتَ إِن كَانَ عَلَى الْهُدَى","page":597,"juz_number":30,"transcription":"E reeyte in kane alel huda.","transcription_en":"Araayta in kana AAala alhuda","translation":{"id":313276,"text":"Gördün mü?[1] Ya o doğru yolda ise!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26718,"text":"Düşünsene.","number":1}]}},{"id":6118,"surah_id":96,"verse_number":12,"verse":"اَوْ اَمَرَ بِالتَّقْوٰىۜ","verse_simplified":"أَوْ أَمَرَ بِالتَّقْوَى","page":597,"juz_number":30,"transcription":"Ev emera bit takva.","transcription_en":"Aw amara bittaqwa","translation":{"id":313277,"text":"Veya takvayı buyuruyorsa?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6119,"surah_id":96,"verse_number":13,"verse":"اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۜ","verse_simplified":"أَرَأَيْتَ إِن كَذَّبَ وَتَوَلَّى","page":597,"juz_number":30,"transcription":"E reeyte in kezzebe ve tevella.","transcription_en":"Araayta in kaththaba watawalla","translation":{"id":313278,"text":"Gördün mü; ya yalanlayıp ve yüz çevirdiyse?[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26719,"text":"Düşünsene, engelleme yapan kimsenin kendisi gerçeği yalanlıyorsa?","number":1}]}},{"id":6120,"surah_id":96,"verse_number":14,"verse":"اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۜ","verse_simplified":"أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَى","page":597,"juz_number":30,"transcription":"E lem ya'lem bi ennellahe yera.","transcription_en":"Alam yaAAlam bi-anna Allaha yara","translation":{"id":313279,"text":"Allah'ın kesinlikle her şeyi gördüğünü bilmiyor mu?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6121,"surah_id":96,"verse_number":15,"verse":"كَلَّا لَئِنْ لَمْ يَنْتَهِ۬ لَنَسْفَعاً بِالنَّاصِيَةِۙ","verse_simplified":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ","page":597,"juz_number":30,"transcription":"Kella le in lem yentehi le nesfean bin nasıyeh.","transcription_en":"Kalla la-in lam yantahi lanasfaAAanbinnasiya","translation":{"id":313280,"text":"Hayır, kesinlikle öyle değil! Eğer gerçekten vazgeçmezse perçeminden[1] yakalarız.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26720,"text":"Yelesinden. Yele; at, aslan gibi hayvanların boyun bölgelerinde bulunan ve onları gösterişli yapan uzun kıllara denmektedir. Perçem/yele bir benzetmedir. Yeleden tutmak, kıskıvrak yakalamak, hakimiyet altına almak anlamındadır.","number":1}]}},{"id":6122,"surah_id":96,"verse_number":16,"verse":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ","verse_simplified":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ","page":597,"juz_number":30,"transcription":"Nasiyetin kazibetin hatıeh.","transcription_en":"Nasiyatin kathibatin khati-a","translation":{"id":313281,"text":"Yalancı ve yanlış yapan perçeminden.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6123,"surah_id":96,"verse_number":17,"verse":"فَلْيَدْعُ نَادِيَهُۙ","verse_simplified":"فَلْيَدْعُ نَادِيَه","page":597,"juz_number":30,"transcription":"Felyed'u nadiyeh.","transcription_en":"FalyadAAu nadiyah","translation":{"id":313282,"text":"Haydi, yardımcılarını çağırsın.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6124,"surah_id":96,"verse_number":18,"verse":"سَنَدْعُ الزَّبَانِيَةَۙ","verse_simplified":"سَنَدْعُ الزَّبَانِيَةَ","page":597,"juz_number":30,"transcription":"Sened'uz zebaniyeh.","transcription_en":"SanadAAu azzabaniya","translation":{"id":313283,"text":"Biz de zebanileri çağıracağız.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6125,"surah_id":96,"verse_number":19,"verse":"كَلَّاۜ  لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ","verse_simplified":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ*","page":597,"juz_number":30,"transcription":"Kella, la tutı'hu vescud vakterib.","transcription_en":"Kalla la tutiAAhu wasjudwaqtarib","translation":{"id":313284,"text":"Hayır, kesinlikle öyle değil! Ona boyun eğme; secde et ve yaklaş.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26721,"text":"Allah'a teslim ol, Allah'a boyun eğerek, saygıyla yönelerek, O'na yakın ol.","number":1}]}}]}}