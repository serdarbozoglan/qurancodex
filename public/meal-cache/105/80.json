ah","translation":{"id":312938,"text":"Sonra onu öldürdü ve kabre koydurdu.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5780,"surah_id":80,"verse_number":22,"verse":"ثُمَّ اِذَا شَٓاءَ اَنْشَرَهُۜ","verse_simplified":"ثُمَّ إِذَا شَاء أَنشَرَهُ","page":584,"juz_number":30,"transcription":"Summe iza şae enşerah.","transcription_en":"Thumma itha shaa ansharah","translation":{"id":312939,"text":"Sonra dilediği zaman onu diriltip ortaya çıkardı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5781,"surah_id":80,"verse_number":23,"verse":"كَلَّا لَمَّا يَقْضِ مَٓا اَمَرَهُۜ","verse_simplified":"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُ","page":584,"juz_number":30,"transcription":"Kella lemma yakdı ma emerah.","transcription_en":"Kalla lamma yaqdi maamarah","translation":{"id":312940,"text":"Hayır! Ona buyurduğu şeyi yerine getirmedi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5782,"surah_id":80,"verse_number":24,"verse":"فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِه۪ۙ","verse_simplified":"فَلْيَنظُرِ الْإِنسَانُ إِلَى طَعَامِهِ","page":584,"juz_number":30,"transcription":"Felyanzuril insanu ila taamih.","transcription_en":"Falyanthuri al-insanuila taAAamih","translation":{"id":312941,"text":"O insan[1] yiyeceğine bir baksın!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26575,"text":"O nankör insan.","number":1}]}},{"id":5783,"surah_id":80,"verse_number":25,"verse":"اَنَّا صَبَبْنَا الْمَٓاءَ صَباًّۙ","verse_simplified":"أَنَّا صَبَبْنَا الْمَاء صَبًّا","page":584,"juz_number":30,"transcription":"Enna sabebnel mae sabba.","transcription_en":"Anna sababna almaasabba","translation":{"id":312942,"text":"Suyu nasıl akıttıkça akıttık.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":