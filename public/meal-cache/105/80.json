{"data":{"id":80,"name":"Abese","name_en":"'Abasa","name_original":"سورة عبس","name_translation_tr":"Surat Asma","name_translation_en":"He frowned","slug":"abese","verse_count":42,"page_number":584,"audio":{"mp3":"https://audio.acikkuran.com/tr/80.mp3","duration":146,"mp3_en":"https://audio.acikkuran.com/en/080.mp3","duration_en":150},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5759,"surah_id":80,"verse_number":1,"verse":"عَبَسَ وَتَوَلّٰىۙ","verse_simplified":"عَبَسَ وَتَوَلَّى","page":584,"juz_number":30,"transcription":"Abese ve tevella.","transcription_en":"AAabasa watawalla","translation":{"id":312918,"text":"Surat astı ve yüz çevirdi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5760,"surah_id":80,"verse_number":2,"verse":"اَنْ جَٓاءَهُ الْاَعْمٰىۜ","verse_simplified":"أَن جَاءهُ الْأَعْمَى","page":584,"juz_number":30,"transcription":"En caehul a'ma.","transcription_en":"An jaahu al-aAAma","translation":{"id":312919,"text":"O gözleri görmeyen geldi diye.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5761,"surah_id":80,"verse_number":3,"verse":"وَمَا يُدْر۪يكَ لَعَلَّهُ يَزَّكّٰىۙ","verse_simplified":"وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّى","page":584,"juz_number":30,"transcription":"Ve ma yudrike leallehu yezzekka.","transcription_en":"Wama yudreeka laAAallahu yazzakka","translation":{"id":312920,"text":"Sen bilemezsin, belki o tezkiye[1] olacak.","author":{"id":105,"name":"Erhan Aktaş","languag