,"verse_simplified":"فِي صُحُفٍ مُّكَرَّمَةٍ","page":584,"juz_number":30,"transcription":"Fi suhufin mukerrameh.","transcription_en":"Fee suhufin mukarrama","translation":{"id":312930,"text":"O şerefli sayfalardadır,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5772,"surah_id":80,"verse_number":14,"verse":"مَرْفُوعَةٍ مُطَهَّرَةٍۙ","verse_simplified":"مَّرْفُوعَةٍ مُّطَهَّرَةٍ","page":584,"juz_number":30,"transcription":"Merfuatin mutahherah.","transcription_en":"MarfooAAatin mutahhara","translation":{"id":312931,"text":"Yüceltilmiş, temizlenmiş,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5773,"surah_id":80,"verse_number":15,"verse":"بِاَيْد۪ي سَفَرَةٍۙ","verse_simplified":"بِأَيْدِي سَفَرَةٍ","page":584,"juz_number":30,"transcription":"Bi eydi seferah.","transcription_en":"Bi-aydee safara","translation":{"id":312932,"text":"Yazıcıların elleriyle,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5774,"surah_id":80,"verse_number":16,"verse":"كِرَامٍ بَرَرَةٍۜ","verse_simplified":"كِرَامٍ بَرَرَةٍ","page":584,"juz_number":30,"transcription":"Kiramin berarah.","transcription_en":"Kiramin barara","translation":{"id":312933,"text":"Şerefli ve birr[1] sahiplerince.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26571,"text":"İyi, yararlı ve doğru olan her şey, bütün iyilikler, bağışlamak, sadakat, samimiyet, doğruluk, adalet, gerçeklik, erdem, gönül.","number":1}]}},{"id":5775,"surah_id":80,"verse_number":17,"verse":"قُتِلَ الْاِنْسَانُ مَٓا اَكْفَرَهُۜ","verse_simplified":"قُتِلَ الْإِنسَانُ مَا أَكْفَرَهُ","page":584,"juz_number":30,"transcription":"Kutilel insanu ma ekferah.","transcription_en":"Qutila al-insanu ma akfarah","translation":{"id":312934,"text":"O insan[1] kendisini mahvetti, o ne kadar da nankördür.","