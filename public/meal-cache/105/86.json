{"data":{"id":86,"name":"Tarık","name_en":"At-Tariq","name_original":"سورة الطارق","name_translation_tr":"Vuruşlu","name_translation_en":"The Morning Star","slug":"tarik","verse_count":17,"page_number":591,"audio":{"mp3":"https://audio.acikkuran.com/tr/86.mp3","duration":74,"mp3_en":"https://audio.acikkuran.com/en/086.mp3","duration_en":70},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5932,"surah_id":86,"verse_number":1,"verse":"وَالسَّمَٓاءِ وَالطَّارِقِۙ","verse_simplified":"وَالسَّمَاء وَالطَّارِقِ","page":590,"juz_number":30,"transcription":"Ves semai vet tarık.","transcription_en":"Wassama-i wattariq","translation":{"id":313091,"text":"Sema'ya[1] ve Tarık'a ant olsun,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26634,"text":"Göğe.","number":1}]}},{"id":5933,"surah_id":86,"verse_number":2,"verse":"وَمَٓا اَدْرٰيكَ مَا الطَّارِقُۙ","verse_simplified":"وَمَا أَدْرَاكَ مَا الطَّارِقُ","page":590,"juz_number":30,"transcription":"Ve ma edrake met tarik.","transcription_en":"Wama adraka ma attariq","translation":{"id":313092,"text":"Tarık'ın ne olduğunu sen ne bileceksin?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5934,"surah_id":86,"verse_number":3,"verse":"اَلنَّجْمُ الثَّاقِبُۙ","verse_simplified":"النَّجْمُ الثَّاقِبُ","page":590,"juz_number":30,"transcription":"En necmus sakıb.","transcription_en":"Annajmu aththaqib","translation":{"id":313093,"text":"O, delici[1] yıldızdır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26635,"text":"Keskin parlaklığı ile karanlığı delen.","number":1}]}},{"id":5935,"surah_id":86,"verse_number":4,"verse":"اِنْ كُلُّ نَفْسٍ لَمَّا عَلَيْهَا حَافِظٌۜ","verse_simplified":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","page":590,"juz_number":30,"transcription":"İn kullu nefsin lemma aleyha hafız.","transcription_en":"In kullu nafsin lamma AAalayha hafith","translation":{"id":313094,"text":"Hiçbir nefs[1] yoktur ki üzerinde koruyucu[2] bulunmasın.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26636,"text":"Kimse, insan.","number":1},{"id":26637,"text":"Gözetleyici.","number":2}]}},{"id":5936,"surah_id":86,"verse_number":5,"verse":"فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَۜ","verse_simplified":"فَلْيَنظُرِ الْإِنسَانُ مِمَّ خُلِقَ","page":590,"juz_number":30,"transcription":"Fel yenzuril insanu mimme hulık.","transcription_en":"Falyanthuri al-insanumimma khuliq","translation":{"id":313095,"text":"İnsan neden yaratıldığına bir baksın.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5937,"surah_id":86,"verse_number":6,"verse":"خُلِقَ مِنْ مَٓاءٍ دَافِقٍۙ","verse_simplified":"خُلِقَ مِن مَّاء دَافِقٍ","page":590,"juz_number":30,"transcription":"Hulika min main dafik.","transcription_en":"Khuliqa min ma-in dafiq","translation":{"id":313096,"text":"Dökülen bir sıvıdan yaratıldı;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5938,"surah_id":86,"verse_number":7,"verse":"يَخْرُجُ مِنْ بَيْنِ الصُّلْبِ وَالتَّرَٓائِبِۜ","verse_simplified":"يَخْرُجُ مِن بَيْنِ الصُّلْبِ وَالتَّرَائِبِ","page":590,"juz_number":30,"transcription":"Yahrucu min beynis sulbi vet teraib.","transcription_en":"Yakhruju min bayni assulbi wattara-ib","translation":{"id":313097,"text":"Omurga ile göğüs kemikleri arasından çıkan[1].","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26638,"text":"Babadan gelen meni sıvısı içerisindeki sperm ile anneden gelen yumurtlama sıvısı içerisindeki yumurta birleşerek insan yaratılmaktadır. Babanın bu sıvısı er bezlerinde (testisler) üretilir. Annenin sıvısı ise yumurtalıklarında üretilir. Ayette insanın yaratılışına dikkat çekilmiştir. Bu nedenle bu sıvıların üretildiği er bezlerinin/yumurtalıkların anne karnındaki ceninin yaratılış evresindeki konumları önemlidir. Er bezlerinin/yumurtalıkların tam da ayette bildirildiği gibi ceninin omurgası ile göğüs kemikleri arasında olduğunu embriyoloji bilimi bize göstermiştir. Cenin","number":1},{"id":26639,"text":"15 haftalıkken bu organlar ayette işaret edilen yerden ceninin kasık bölgesine indirilir. Yumurtalıklar kasık bölgesinde kalırken, er bezleri er bezi torbasına indirilir. Bu süreç cenin","number":8},{"id":26640,"text":"35 haftalıkken gerçekleştirilir. Bu ayet 7:172. ayeti ile birlikte okunmalıdır. Ayetin, insanın omurga ile göğüs kemikleri arasından çıkan bir sıvıdan yaratıldığını söylemesi, Kur'an'ın ilahi bir metin olduğunu açık bir şekilde ortaya koymaktadır. Bu bilgi günümüz tıp bilimi tarafından çok yakın bir döneme kadar bilinmiyordu.","number":25}]}},{"id":5939,"surah_id":86,"verse_number":8,"verse":"اِنَّهُ عَلٰى رَجْعِه۪ لَقَادِرٌۜ","verse_simplified":"إِنَّهُ عَلَى رَجْعِهِ لَقَادِرٌ","page":590,"juz_number":30,"transcription":"İnnehu ala rec'ıhi le kadir.","transcription_en":"Innahu AAala rajAAihi laqadir","translation":{"id":313098,"text":"Kuşkusuz O, onu yeniden diriltmeye elbette kadirdir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5940,"surah_id":86,"verse_number":9,"verse":"يَوْمَ تُبْلَى السَّرَٓائِرُۙ","verse_simplified":"يَوْمَ تُبْلَى السَّرَائِرُ","page":590,"juz_number":30,"transcription":"Yevme tubles serair.","transcription_en":"Yawma tubla assara-ir","translation":{"id":313099,"text":"Bütün gizliliklerin ortaya çıkarıldığı gün,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5941,"surah_id":86,"verse_number":10,"verse":"فَمَا لَهُ مِنْ قُوَّةٍ وَلَا نَاصِرٍۜ","verse_simplified":"فَمَا لَهُ مِن قُوَّةٍ وَلَا نَاصِرٍ","page":590,"juz_number":30,"transcription":"Fema lehu min kuvvetin ve la nasır.","transcription_en":"Fama lahu min quwwatin wala nasir","translation":{"id":313100,"text":"Onun ne bir gücü ne de bir yardımcısı vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5942,"surah_id":86,"verse_number":11,"verse":"وَالسَّمَٓاءِ ذَاتِ الرَّجْعِۙ","verse_simplified":"وَالسَّمَاء ذَاتِ الرَّجْعِ","page":590,"juz_number":30,"transcription":"Ves semai zatir rec'.","transcription_en":"Wassama-i thati arrajAA","translation":{"id":313101,"text":"Dönüş sahibi Semaya ant olsun,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5943,"surah_id":86,"verse_number":12,"verse":"وَالْاَرْضِ ذَاتِ الصَّدْعِۙ","verse_simplified":"وَالْأَرْضِ ذَاتِ الصَّدْعِ","page":590,"juz_number":30,"transcription":"Vel ardı zatis sad'.","transcription_en":"Wal-ardi thati assadAA","translation":{"id":313102,"text":"Yarılma sahibi yeryüzüne ant olsun","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5944,"surah_id":86,"verse_number":13,"verse":"اِنَّهُ لَقَوْلٌ فَصْلٌۙ","verse_simplified":"إِنَّهُ لَقَوْلٌ فَصْلٌ","page":590,"juz_number":30,"transcription":"İnnehu le kavlun fasl.","transcription_en":"Innahu laqawlun fasl","translation":{"id":313103,"text":"Kuşkusuz O, ayırt edici[1] bir sözdür.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26641,"text":"Hakk ile Batıl'ı birbirinden ayıran.","number":1}]}},{"id":5945,"surah_id":86,"verse_number":14,"verse":"وَمَا هُوَ بِالْهَزْلِۜ","verse_simplified":"وَمَا هُوَ بِالْهَزْلِ","page":590,"juz_number":30,"transcription":"Ve ma huve bil hezl.","transcription_en":"Wama huwa bilhazl","translation":{"id":313104,"text":"O, sıradan bir söz değildir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5946,"surah_id":86,"verse_number":15,"verse":"اِنَّهُمْ يَك۪يدُونَ كَيْداًۙ","verse_simplified":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","page":590,"juz_number":30,"transcription":"İnnehum yekidune keyda.","transcription_en":"Innahum yakeedoona kayda","translation":{"id":313105,"text":"Onlar, planlar yapıyorlar,[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26642,"text":"Kur'an'ı geçersiz kılmak için.","number":1}]}},{"id":5947,"surah_id":86,"verse_number":16,"verse":"وَاَ‌ك۪يدُ كَيْداًۚ","verse_simplified":"وَأَكِيدُ كَيْدًا","page":590,"juz_number":30,"transcription":"Ve ekidu keyda.","transcription_en":"Waakeedu kayda","translation":{"id":313106,"text":"Ben de plan yapıyorum.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5948,"surah_id":86,"verse_number":17,"verse":"فَمَهِّلِ الْـكَافِر۪ينَ اَمْهِلْهُمْ رُوَيْداً","verse_simplified":"فَمَهِّلِ الْكَافِرِينَ أَمْهِلْهُمْ رُوَيْدًا","page":590,"juz_number":30,"transcription":"Fe mehhilil kafirine emhilhum ruveyda.","transcription_en":"Famahhili alkafireena amhilhum ruwayda","translation":{"id":313107,"text":"Kafirlere biraz daha süre tanı, onları kendi hallerine bırak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}