{"data":{"id":92,"name":"Leyl","name_en":"Al-Layl","name_original":"سورة الليل","name_translation_tr":"Gece","name_translation_en":"The Night","slug":"leyl","verse_count":21,"page_number":595,"audio":{"mp3":"https://audio.acikkuran.com/tr/92.mp3","duration":98,"mp3_en":"https://audio.acikkuran.com/en/092.mp3","duration_en":82},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6059,"surah_id":92,"verse_number":1,"verse":"وَالَّيْلِ اِذَا يَغْشٰىۙ","verse_simplified":"وَاللَّيْلِ إِذَا يَغْشَى","page":595,"juz_number":30,"transcription":"Vel leyli iza yagşa.","transcription_en":"Wallayli itha yaghsha","translation":{"id":313218,"text":"Örttüğü zaman geceye ant olsun.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6060,"surah_id":92,"verse_number":2,"verse":"وَالنَّهَارِ اِذَا تَجَلّٰىۙ","verse_simplified":"وَالنَّهَارِ إِذَا تَجَلَّى","page":595,"juz_number":30,"transcription":"Ven nehari iza tecella.","transcription_en":"Wannahari itha tajalla","translation":{"id":313219,"text":"Ortaya çıktığı zaman gündüze,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6061,"surah_id":92,"verse_number":3,"verse":"وَمَا خَلَقَ الذَّكَرَ وَالْاُنْثٰىۙ","verse_simplified":"وَمَا خَلَقَ الذَّكَرَ وَالْأُنثَى","page":595,"juz_number":30,"transcription":"Ve ma halakaz zekera vel unsa.","transcription_en":"Wama khalaqa aththakarawal-ontha","translation":{"id":313220,"text":"Erkeği ve dişiyi yaratana,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6062,"surah_id":92,"verse_number":4,"verse":"اِنَّ سَعْيَكُمْ لَشَتّٰىۜ","verse_simplified":"إِنَّ سَعْيَكُمْ لَشَتَّى","page":595,"juz_number":30,"transcription":"İnne sa'yekum le şetta.","transcription_en":"Inna saAAyakum lashatta","translation":{"id":313221,"text":"Çabalarınız çeşit çeşittir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6063,"surah_id":92,"verse_number":5,"verse":"فَاَمَّا مَنْ اَعْطٰى وَاتَّقٰىۙ","verse_simplified":"فَأَمَّا مَن أَعْطَى وَاتَّقَى","page":595,"juz_number":30,"transcription":"Fe emma men a'ta vetteka.","transcription_en":"Faamma man aAAta wattaqa","translation":{"id":313222,"text":"Fakat kim verir ve takva sahibi olursa,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6064,"surah_id":92,"verse_number":6,"verse":"وَصَدَّقَ بِالْحُسْنٰىۙ","verse_simplified":"وَصَدَّقَ بِالْحُسْنَى","page":595,"juz_number":30,"transcription":"Ve saddeka bil husna.","transcription_en":"Wasaddaqa bilhusna","translation":{"id":313223,"text":"En iyiyi doğrularsa,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6065,"surah_id":92,"verse_number":7,"verse":"فَسَنُيَسِّرُهُ لِلْيُسْرٰىۜ","verse_simplified":"فَسَنُيَسِّرُهُ لِلْيُسْرَى","page":595,"juz_number":30,"transcription":"Fe senuyessiruhu lil yusra.","transcription_en":"Fasanuyassiruhu lilyusra","translation":{"id":313224,"text":"Ona en kolayı[1] kolaylaştıracağız.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26691,"text":"Cennet'i.","number":1}]}},{"id":6066,"surah_id":92,"verse_number":8,"verse":"وَاَمَّا مَنْ بَخِلَ وَاسْتَغْنٰىۙ","verse_simplified":"وَأَمَّا مَن بَخِلَ وَاسْتَغْنَى","page":595,"juz_number":30,"transcription":"Ve emma men bahıle vestagna.","transcription_en":"Waamma man bakhila wastaghna","translation":{"id":313225,"text":"Fakat kim cimrilik eder de kendisini müstağni[1] görürse,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26692,"text":"Kendisini yeterli gören, büyüklenen, kibirlenen.","number":1}]}},{"id":6067,"surah_id":92,"verse_number":9,"verse":"وَكَذَّبَ بِالْحُسْنٰىۙ","verse_simplified":"وَكَذَّبَ بِالْحُسْنَى","page":595,"juz_number":30,"transcription":"Ve kezzebe bil husna.","transcription_en":"Wakaththaba bilhusna","translation":{"id":313226,"text":"En iyiyi yalanlarsa,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6068,"surah_id":92,"verse_number":10,"verse":"فَسَنُيَسِّرُهُ لِلْعُسْرٰىۜ","verse_simplified":"فَسَنُيَسِّرُهُ لِلْعُسْرَى","page":595,"juz_number":30,"transcription":"Fe senuyessiruhu lil usra.","transcription_en":"Fasanuyassiruhu lilAAusra","translation":{"id":313227,"text":"Ona en zoru[1] kolaylaştıracağız.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26693,"text":"Cehennem'i.","number":1}]}},{"id":6069,"surah_id":92,"verse_number":11,"verse":"وَمَا يُغْن۪ي عَنْهُ مَالُـهُٓ اِذَا تَرَدّٰىۜ","verse_simplified":"وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّى","page":595,"juz_number":30,"transcription":"Ve ma yugni anhu maluhu iza teredda.","transcription_en":"Wama yughnee AAanhu maluhu ithataradda","translation":{"id":313228,"text":"Düştüğü[1] zaman malı ona yarar sağlamaz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26694,"text":"Helak olduğu, çukura yuvarlandığı, öldüğü, Cehennem'e yuvarlandığı.","number":1}]}},{"id":6070,"surah_id":92,"verse_number":12,"verse":"اِنَّ عَلَيْنَا لَلْهُدٰىۘ","verse_simplified":"إِنَّ عَلَيْنَا لَلْهُدَى","page":595,"juz_number":30,"transcription":"İnne aleyna lel huda.","transcription_en":"Inna AAalayna lalhuda","translation":{"id":313229,"text":"Kuşkusuz doğru yolu göstermek Biz'e aittir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6071,"surah_id":92,"verse_number":13,"verse":"وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُو۫لٰى","verse_simplified":"وَإِنَّ لَنَا لَلْآخِرَةَ وَالْأُولَى","page":595,"juz_number":30,"transcription":"Ve inne lena lel ahırete vel ula.","transcription_en":"Wa-inna lana lal-akhirata wal-oola","translation":{"id":313230,"text":"Kuşkusuz ilk[1] de son[1] da Bizimdir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26695,"text":"Dünyada ahirette.","number":1}]}},{"id":6072,"surah_id":92,"verse_number":14,"verse":"فَاَنْذَرْتُكُمْ نَاراً تَلَظّٰىۚ","verse_simplified":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّى","page":595,"juz_number":30,"transcription":"Fe enzertukum naren telezza.","transcription_en":"Faanthartukum naran talaththa","translation":{"id":313231,"text":"Alev saçan bir ateşe karşı sizi uyardım.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6073,"surah_id":92,"verse_number":15,"verse":"لَا يَصْلٰيهَٓا اِلَّا الْاَشْقٰىۙ","verse_simplified":"لَا يَصْلَاهَا إِلَّا الْأَشْقَى","page":595,"juz_number":30,"transcription":"La yaslaha illel eşka.","transcription_en":"La yaslaha illaal-ashqa","translation":{"id":313232,"text":"Ona şaki[1] olandan başkası girmez.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26696,"text":"İflah olmaz azgın.","number":1}]}},{"id":6074,"surah_id":92,"verse_number":16,"verse":"اَلَّذ۪ي كَذَّبَ وَتَوَلّٰىۜ","verse_simplified":"الَّذِي كَذَّبَ وَتَوَلَّى","page":595,"juz_number":30,"transcription":"Ellezi kezzebe ve tevella.","transcription_en":"Allathee kaththaba watawalla","translation":{"id":313233,"text":"O ki yalanladı ve yüz çevirdi.","author":{"id":105,"name":"Erhan Aktaş","language":