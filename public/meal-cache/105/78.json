{"data":{"id":78,"name":"Nebe","name_en":"An-Naba","name_original":"سورة النبأ","name_translation_tr":"Haber","name_translation_en":"The Announcement","slug":"nebe","verse_count":40,"page_number":581,"audio":{"mp3":"https://audio.acikkuran.com/tr/78.mp3","duration":185,"mp3_en":"https://audio.acikkuran.com/en/078.mp3","duration_en":184},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5673,"surah_id":78,"verse_number":1,"verse":"عَمَّ يَتَسَٓاءَلُونَۚ","verse_simplified":"عَمَّ يَتَسَاءلُونَ","page":581,"juz_number":30,"transcription":"Amme yetesaelun.","transcription_en":"AAamma yatasaaloon","translation":{"id":312832,"text":"Birbirlerine neyi soruyorlar?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5674,"surah_id":78,"verse_number":2,"verse":"عَنِ النَّبَأِ الْعَظ۪يمِۙ","verse_simplified":"عَنِ النَّبَإِ الْعَظِيمِ","page":581,"juz_number":30,"transcription":"Anin nebeil azim.","transcription_en":"AAani annaba-i alAAatheem","translation":{"id":312833,"text":"Büyük haberden mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5675,"surah_id":78,"verse_number":3,"verse":"اَلَّذ۪ي هُمْ ف۪يهِ مُخْتَلِفُونَۜ","verse_simplified":"الَّذِي هُمْ فِيهِ مُخْتَلِفُونَ","page":581,"juz_number":30,"transcription":"Ellezi hum fihi muhtelifun.","transcription_en":"Allathee hum feehi mukhtalifoon","translation":{"id":312834,"text":"Onlar, onun hakkında anlaşmazlık içindeler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5676,"surah_id":78,"verse_number":4,"verse":"كَلَّا سَيَعْلَمُونَۙ","verse_simplified":"كَلَّا سَيَعْلَمُونَ","page":581,"juz_number":30,"transcription":"Kella se ya'lemun.","transcription_en":"Kalla sayaAAlamoon","translation":{"id":312835,"text":"Hayır, yakında bilecekler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5677,"surah_id":78,"verse_number":5,"verse":"ثُمَّ كَلَّا سَيَعْلَمُونَ","verse_simplified":"ثُمَّ كَلَّا سَيَعْلَمُونَ","page":581,"juz_number":30,"transcription":"Summe kella se ya'lemun.","transcription_en":"Thumma kalla sayaAAlamoon","translation":{"id":312836,"text":"Yine hayır, yakında bilecekler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5678,"surah_id":78,"verse_number":6,"verse":"اَلَمْ نَجْعَلِ الْاَرْضَ مِهَاداًۙ","verse_simplified":"أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا","page":581,"juz_number":30,"transcription":"E lem nec'alil arda mihada.","transcription_en":"Alam najAAali al-arda mihada","translation":{"id":312837,"text":"Yeryüzünü bir döşek yapmadık mı?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5679,"surah_id":78,"verse_number":7,"verse":"وَالْجِبَالَ اَوْتَاداًۖ","verse_simplified":"وَالْجِبَالَ أَوْتَادًا","page":581,"juz_number":30,"transcription":"Vel cibale evtada.","transcription_en":"Waljibala awtada","translation":{"id":312838,"text":"Ve dağları da birer kazık?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5680,"surah_id":78,"verse_number":8,"verse":"وَخَلَقْنَاكُمْ اَزْوَاجاًۙ","verse_simplified":"وَخَلَقْنَاكُمْ أَزْوَاجًا","page":581,"juz_number":30,"transcription":"Ve halaknakum ezvaca.","transcription_en":"Wakhalaqnakum azwaja","translation":{"id":312839,"text":"Sizi çiftler halinde yarattık.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5681,"surah_id":78,"verse_number":9,"verse":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتاًۙ","verse_simplified":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","page":581,"juz_number":30,"transcription":"Ve cealna nevmekum subata.","transcription_en":"WajaAAalna nawmakum subata","translation":{"id":312840,"text":"Uykunuzu dinlenme zamanı yaptık.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5682,"surah_id":78,"verse_number":10,"verse":"وَجَعَلْنَا الَّيْلَ لِبَاساًۙ","verse_simplified":"وَجَعَلْنَا اللَّيْلَ لِبَاسًا","page":581,"juz_number":30,"transcription":"Ve cealnel leyle libasa.","transcription_en":"WajaAAalna allayla libasa","translation":{"id":312841,"text":"Ve geceyi bir elbise yaptık.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5683,"surah_id":78,"verse_number":11,"verse":"وَجَعَلْنَا النَّهَارَ مَعَاشاًۖ","verse_simplified":"وَجَعَلْنَا النَّهَارَ مَعَاشًا","page":581,"juz_number":30,"transcription":"Ve cealnen nehare meaşa.","transcription_en":"WajaAAalna annaharamaAAasha","translation":{"id":312842,"text":"Gündüzü geçim zamanı yaptık.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5684,"surah_id":78,"verse_number":12,"verse":"وَبَنَيْنَا فَوْقَـكُمْ سَبْعاً شِدَاداًۙ","verse_simplified":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","page":581,"juz_number":30,"transcription":"Ve beneyna fevkakum seb'an şidada.","transcription_en":"Wabanayna fawqakum sabAAan shidada","translation":{"id":312843,"text":"Üstünüze yedi sağlamı bina ettik.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5685,"surah_id":78,"verse_number":13,"verse":"وَجَعَلْنَا سِرَاجاً وَهَّاجاًۖ","verse_simplified":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","page":581,"juz_number":30,"transcription":"Ve cealna siracen vehhaca.","transcription_en":"WajaAAalna sirajan wahhaja","translation":{"id":312844,"text":"Ve ışık saçan bir kandil.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26551,"text":"Güneş.","number":1}]}},{"id":5686,"surah_id":78,"verse_number":14,"verse":"وَاَنْزَلْنَا مِنَ الْمُعْصِرَاتِ مَٓاءً ثَجَّاجاًۙ","verse_simplified":"وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاء ثَجَّاجًا","page":581,"juz_number":30,"transcription":"Ve enzelna minel mu'sırati maen seccaca.","transcription_en":"Waanzalna mina almuAAsiratimaan thajjaja","translation":{"id":312845,"text":"Ve sıkıştırılmış bulutlardan şırıl şırıl akan su indirdik.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5687,"surah_id":78,"verse_number":15,"verse":"لِنُخْرِجَ بِه۪ حَباًّ وَنَبَاتاًۙ","verse_simplified":"لِنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا","page":581,"juz_number":30,"transcription":"Li nuhrice bihi habben ve nebata.","transcription_en":"Linukhrija bihi habban wanabata","translation":{"id":312846,"text":"Onunla tahıl ve bitkiler yetiştirelim diye;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5688,"surah_id":78,"verse_number":16,"verse":"وَجَنَّاتٍ اَلْفَافاًۜ","verse_simplified":"وَجَنَّاتٍ أَلْفَافًا","page":581,"juz_number":30,"transcription":"Ve cennatin elfafa.","transcription_en":"Wajannatin alfafa","translation":{"id":312847,"text":"İç içe girmiş bağlar bahçeler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5689,"surah_id":78,"verse_number":17,"verse":"اِنَّ يَوْمَ الْفَصْلِ كَانَ م۪يقَاتاًۙ","verse_simplified":"إِنَّ يَوْمَ الْفَصْلِ كَانَ مِيقَاتًا","page":581,"juz_number":30,"transcription":"İnne yevmel faslı kane mikata.","transcription_en":"Inna yawma alfasli kana meeqata","translation":{"id":312848,"text":"Ayırma Günü belirlenmiş bir vakittir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5690,"surah_id":78,"verse_number":18,"verse":"يَوْمَ يُنْفَخُ فِي الصُّورِ فَتَأْتُونَ اَفْوَاجاًۙ","verse_simplified":"يَوْمَ يُنفَخُ فِي الصُّورِ فَتَأْتُونَ أَفْوَاجًا","page":581,"juz_number":30,"transcription":"Yevme yunfehu fis suri fe te'tune efvaca.","transcription_en":"Yawma yunfakhu fee assoorifata/toona afwaja","translation":{"id":312849,"text":"O gün Sur'a üflenir, bölükler halinde gelirsiniz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5691,"surah_id":78,"verse_number":19,"verse":"وَفُتِحَتِ السَّمَٓاءُ فَـكَانَتْ اَبْوَاباًۙ","verse_simplified":"وَفُتِحَتِ السَّمَاء فَكَانَتْ أَبْوَابًا","page":581,"juz_number":30,"transcription":"Ve futihatis semau fe kanet ebvaba.","transcription_en":"Wafutihati assamao fakanatabwaba","translation":{"id":312850,"text":"Gökyüzü açılmış ve kapı kapı olmuştur.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5692,"surah_id":78,"verse_number":20,"verse":"وَسُيِّرَتِ الْجِبَالُ فَـكَانَتْ سَرَاباًۜ","verse_simplified":"وَسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًا","page":581,"juz_number":30,"transcription":"Ve suyyiretil cibalu fe kanet seraba.","transcription_en":"Wasuyyirati aljibalu fakanatsaraba","translation":{"id":312851,"text":"Dağlar yürütülmüş, bir serap olmuştur.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5693,"surah_id":78,"verse_number":21,"verse":"اِنَّ جَهَنَّمَ كَانَتْ مِرْصَاداًۙ","verse_simplified":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","page":581,"juz_number":30,"transcription":"İnne cehenneme kanet mirsada.","transcription_en":"Inna jahannama kanat mirsada","translation":{"id":312852,"text":"Cehennem gözetleme yeri oldu;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5694,"surah_id":78,"verse_number":22,"verse":"لِلطَّاغ۪ينَ مَاٰباًۙ","verse_simplified":"لِلْطَّاغِينَ مَآبًا","page":581,"juz_number":30,"transcription":"Lit tagine meaba.","transcription_en":"Littagheena maaba","translation":{"id":312853,"text":"Haddi aşanlar için varacakları yer olarak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5695,"surah_id":78,"verse_number":23,"verse":"لَابِث۪ينَ ف۪يهَٓا اَحْقَاباًۚ","verse_simplified":"لَابِثِينَ فِيهَا أَحْقَابًا","page":581,"juz_number":30,"transcription":"Labisine fiha ahkaba.","transcription_en":"Labitheena feeha ahqaba","translation":{"id":312854,"text":"Orada \"ahkaben\"[1] kalacaklardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26552,"text":"Bu ayete; çevirilerde, \"Orada uzun süre, yıllarca veya çağlarca kalacaklar.\" şeklinde anlam verilmektedir. Ayetin anlamı \"Orada azap, sıkıntı ve yoksunluk içinde kalacaklardır.\" şeklindedir. \"Ahkaben,\" \"hukubu\" kelimesinin çoğulu olup, kelime anlamı olarak \"uzun süre, seksen yıl\" demek olsa da kelime, kök anlamı (hakibe) itibariyle: \"İdrar tutulmasından dolayı azap ve sıkıntı içinde olmak, yağmur vs. yağmamak.\" anlamına gelmektedir. Bu ayette bir zamandan değil, durumdan söz edilmektedir. Kalınacak yerin sıkıntı verici, darlık ve yoksunluk yeri olduğu ifade edilmektedir. Zaten ayetin devamı da bunu pekiştirmektedir.","number":1}]}},{"id":5696,"surah_id":78,"verse_number":24,"verse":"لَا يَذُوقُونَ ف۪يهَا بَرْداً وَلَا شَرَاباًۙ","verse_simplified":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","page":581,"juz_number":30,"transcription":"La yezukune fiha berden ve la şeraba.","transcription_en":"La yathooqoona feehabardan wala sharaba","translation":{"id":312855,"text":"Orada ne bir serinlik tadacaklar ne de içecek bir şey.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5697,"surah_id":78,"verse_number":25,"verse":"اِلَّا حَم۪يماً وَغَسَّاقاًۙ","verse_simplified":"إِلَّا حَمِيمًا وَغَسَّاقًا","page":581,"juz_number":30,"transcription":"İlla hamimen ve gassaka.","transcription_en":"Illa hameeman waghassaqa","translation":{"id":312856,"text":"Yalnızca kaynar ve kokuşmuş su tadacaklar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5698,"surah_id":78,"verse_number":26,"verse":"جَزَٓاءً وِفَاقاً","verse_simplified":"جَزَاء وِفَاقًا","page":581,"juz_number":30,"transcription":"Cezaen vifaka.","transcription_en":"Jazaan wifaqa","translation":{"id":312857,"text":"Yaptıklarına uygun bir karşılık olarak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5699,"surah_id":78,"verse_number":27,"verse":"اِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَاباًۙ","verse_simplified":"إِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًا","page":581,"juz_number":30,"transcription":"İnnehum kanu la yercune hısaba.","transcription_en":"Innahum kanoo la yarjoona hisaba","translation":{"id":312858,"text":"Onlar, hesap görüleceğini ummuyorlardı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5700,"surah_id":78,"verse_number":28,"verse":"وَكَذَّبُوا بِاٰيَاتِنَا كِذَّاباًۜ","verse_simplified":"وَكَذَّبُوا بِآيَاتِنَا كِذَّابًا","page":581,"juz_number":30,"transcription":"Ve kezzebu bi ayatina kizzaba.","transcription_en":"Wakaththaboo bi-ayatinakiththaba","translation":{"id":312859,"text":"Ayetlerimizi yalanladıkça yalanladılar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5701,"surah_id":78,"verse_number":29,"verse":"وَكُلَّ شَيْءٍ اَحْصَيْنَاهُ كِتَاباً","verse_simplified":"وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ كِتَابًا","page":581,"juz_number":30,"transcription":"Ve kulle şey'in ahsaynahu kitaba.","transcription_en":"Wakulla shay-in ahsaynahu kitaba","translation":{"id":312860,"text":"Oysa Biz, her şeyi yazıp kaydettik.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5702,"surah_id":78,"verse_number":30,"verse":"فَذُوقُوا فَلَنْ نَز۪يدَكُمْ اِلَّا عَذَاباً۟","verse_simplified":"فَذُوقُوا فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","page":581,"juz_number":30,"transcription":"Fe zuku felen nezidekum illa azaba.","transcription_en":"Fathooqoo falan nazeedakum illaAAathaba","translation":{"id":312861,"text":"Şimdi azabı tadın bakalım! Artık size azaptan başka bir şey artırmayacağız.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5703,"surah_id":78,"verse_number":31,"verse":"اِنَّ لِلْمُتَّق۪ينَ مَفَازاًۙ","verse_simplified":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","page":582,"juz_number":30,"transcription":"İnne lil muttekine mefaza.","transcription_en":"Inna lilmuttaqeena mafaza","translation":{"id":312862,"text":"Takva sahipleri için ödül vardır;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5704,"surah_id":78,"verse_number":32,"verse":"حَدَٓائِقَ وَاَعْنَاباًۙ","verse_simplified":"حَدَائِقَ وَأَعْنَابًا","page":582,"juz_number":30,"transcription":"Hadaika ve a'naba.","transcription_en":"Hada-iqa waaAAnaba","translation":{"id":312863,"text":"Bağlar ve bahçeler,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5705,"surah_id":78,"verse_number":33,"verse":"وَكَوَاعِبَ اَتْرَاباًۙ","verse_simplified":"وَكَوَاعِبَ أَتْرَابًا","page":582,"juz_number":30,"transcription":"Ve kevaıbe etraba.","transcription_en":"WakawaAAiba atraba","translation":{"id":312864,"text":"Görkemli, dengi dengine,[1](eşler)","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26553,"text":"Bu ayetin çevirisi, \"Göğüsleri tomurcuklanmış yaşıt kızlar\" veya \"tomurcuk göğüslü aynı yaşta genç kızlar.\" şeklinde yapılmaktadır. Ayet, \"Kevaib\" ve \"Etrab\" olmak üzere iki kelimeden oluşmaktadır. Kevaib; görkemli, göz alıcı, yüce, değerli, yüksek, aşık kemiği, topuk, küp gibi anlamlara gelen \"keab\" kelimesinin kökünden türemiştir. Eril ve dişil cisimlerin her ikisi için de kullanılan bir kelimedir. \"Etrab\" kelimesi ise, dengi dengine, aynı özelliklere sahip, aynı seviyede, eş zamanlı,\" demektir. Dolayısı ile ayetin anlamı, \"birbirine denk, görkemli eşler\"dir. \"Birbiri ile uyumlu üzüm salkımları\" veya \"Topraktan yumrular.\" Yani topraktan çıkan yumru bitkiler anlamı da verilmektedir. Keab kelimesi, 5:97. ayette Kabe, 5:6. ayette ayak topukları anlamında kullanılmaktadır.","number":1}]}},{"id":5706,"surah_id":78,"verse_number":34,"verse":"وَكَأْساً دِهَاقاًۜ","verse_simplified":"وَكَأْسًا دِهَاقًا","page":582,"juz_number":30,"transcription":"Ve ke'sen dihaka.","transcription_en":"Waka/san dihaqa","translation":{"id":312865,"text":"Ve dolu kaseler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5707,"surah_id":78,"verse_number":35,"verse":"لَا يَسْمَعُونَ ف۪يهَا لَغْواً وَلَا كِذَّاباًۚ","verse_simplified":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّابًا","page":582,"juz_number":30,"transcription":"La yes'meune fiha lagven ve la kizzaba.","transcription_en":"La yasmaAAoona feeha laghwanwala kiththaba","translation":{"id":312866,"text":"Orada yalan da boş söz de duymazlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5708,"surah_id":78,"verse_number":36,"verse":"جَزَٓاءً مِنْ رَبِّكَ عَطَٓاءً حِسَاباًۙ","verse_simplified":"جَزَاء مِّن رَّبِّكَ عَطَاء حِسَابًا","page":582,"juz_number":30,"transcription":"Cezaen min rabbike ataen hısaba.","transcription_en":"Jazaan min rabbika AAataan hisaba","translation":{"id":312867,"text":"Bunlar, Rabb'inden hesaba[1] karşılık verilen ödüldür.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26554,"text":"Yapılanların karşılığı olarak. Verilen hesaba göre.","number":1}]}},{"id":5709,"surah_id":78,"verse_number":37,"verse":"رَبِّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَيْنَهُمَاۙ الرَّحْمٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَاباًۙ","verse_simplified":"رَبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرحْمَنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","page":582,"juz_number":30,"transcription":"Rabbis semavati vel ardı ve ma beynehumer rahmani la yemlikune minhu hitaba.","transcription_en":"Rabbi assamawati wal-ardiwama baynahuma arrahmani layamlikoona minhu khitaba","translation":{"id":312868,"text":"O, göklerin, yerin ve ikisinin arasında bulunanların Rabb'idir, Rahman'dır. Ondan bir hitaba,[1] hiç kimse güç yetiremez.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26555,"text":"Karşısında söz söylemeye.","number":1}]}},{"id":5710,"surah_id":78,"verse_number":38,"verse":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلٰٓئِكَةُ صَفاًّۜ  لَا يَتَكَلَّمُونَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَاباً","verse_simplified":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرحْمَنُ وَقَالَ صَوَابًا","page":582,"juz_number":30,"transcription":"Yevme yekumur ruhu vel melaiketu saffa, la yetekellemune illa men ezine lehur rahmanu ve kale sevaba.","transcription_en":"Yawma yaqoomu arroohu walmala-ikatusaffan la yatakallamoona illa man athinalahu arrahmanu waqala sawaba","translation":{"id":312869,"text":"O gün, o ruh ve o melekler saflar halinde hazır bulunur. Rahman'ın izin verdiklerinden başkası konuşamaz. İzin verilen de doğruyu söyler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5711,"surah_id":78,"verse_number":39,"verse":"ذٰلِكَ الْيَوْمُ الْحَقُّۚ فَمَنْ شَٓاءَ اتَّخَذَ اِلٰى رَبِّه۪ مَاٰباً","verse_simplified":"ذَلِكَ الْيَوْمُ الْحَقُّ فَمَن شَاء اتَّخَذَ إِلَى رَبِّهِ مَآبًا","page":582,"juz_number":30,"transcription":"Zalikel yevmul hakk, femen şaettehaze ila rabbihi meaba.","transcription_en":"Thalika alyawmu alhaqqu famanshaa ittakhatha ila rabbihi maaba","translation":{"id":312870,"text":"İşte bu Hakk gündür. Dileyen Rabb'ine varan bir yol edinir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5712,"surah_id":78,"verse_number":40,"verse":"اِنَّٓا اَنْذَرْنَا‌كُمْ عَذَاباً قَر۪يباًۚ يَوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْـكَافِرُ يَا لَيْتَن۪ي كُنْتُ تُرَاباً","verse_simplified":"إِنَّا أَنذَرْنَاكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْكَافِرُ يَا لَيْتَنِي كُنتُ تُرَابًا","page":582,"juz_number":30,"transcription":"İnna enzernakum azaben kariba, yevme yenzurul mer'u ma kaddemet yedahu ve yekulul kafiru ya leyteni kuntu turaba.","transcription_en":"Inna antharnakum AAathabanqareeban yawma yanthuru almaro ma qaddamatyadahu wayaqoolu alkafiru ya laytanee kuntuturaba","translation":{"id":312871,"text":"Sizi yakın bir azapla uyardık. O gün kişi ellerinin yaptıklarıyla[1] karşı karşıya gelecek ve Kafir kimse: \"Keşke toprak olsaydım.\" diyecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26556,"text":"Dünyada yaptıklarının tamamını karşısında bulacaktır.","number":1}]}}]}}