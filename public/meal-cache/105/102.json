{"data":{"id":102,"name":"Tekasür","name_en":"At-Takathur","name_original":"سورة التكاثر","name_translation_tr":"Çoğalma Yarışı","name_translation_en":"Competition","slug":"tekasur","verse_count":8,"page_number":600,"audio":{"mp3":"https://audio.acikkuran.com/tr/102.mp3","duration":40,"mp3_en":"https://audio.acikkuran.com/en/102.mp3","duration_en":44},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6169,"surah_id":102,"verse_number":1,"verse":"اَلْهٰيكُمُ التَّكَاثُرُۙ","verse_simplified":"أَلْهَاكُمُ التَّكَاثُرُ","page":600,"juz_number":30,"transcription":"Elhakumut tekasur.","transcription_en":"Alhakumu attakathur","translation":{"id":313328,"text":"Çoğaltma isteği sizi oyaladı.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26750,"text":"Mal, mülk edinme hırsı, bütün hayatınızı mal edinme peşinde harcamanıza neden oldu.","number":1}]}},{"id":6170,"surah_id":102,"verse_number":2,"verse":"حَتّٰى زُرْتُمُ الْمَقَابِرَۜ","verse_simplified":"حَتَّى زُرْتُمُ الْمَقَابِرَ","page":600,"juz_number":30,"transcription":"Hatta zurtumul mekabir.","transcription_en":"Hatta zurtumu almaqabir","translation":{"id":313329,"text":"Ta ki ölüp kabirlere girinceye kadar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6171,"surah_id":102,"verse_number":3,"verse":"كَلَّا سَوْفَ تَعْلَمُونَۙ","verse_simplified":"كَلَّا سَوْفَ تَعْلَمُونَ","page":600,"juz_number":30,"transcription":"Kella sevfe ta'lemun.","transcription_en":"Kalla sawfa taAAlamoon","translation":{"id":313330,"text":"Hayır, asla bildiğiniz gibi değil; yakında bileceksiniz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6172,"surah_id":102,"verse_number":4,"verse":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۜ","verse_simplified":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","page":600,"juz_number":30,"transcription":"Summe kella sevfe ta'lemun.","transcription_en":"Thumma kalla sawfa taAAlamoon","translation":{"id":313331,"text":"Yine hayır, bildiğiniz gibi değil; yakında bileceksiniz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6173,"surah_id":102,"verse_number":5,"verse":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَق۪ينِۜ","verse_simplified":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ","page":600,"juz_number":30,"transcription":"Kella lev ta'lemune ilmel yakin.","transcription_en":"Kalla law taAAlamoona AAilma alyaqeen","translation":{"id":313332,"text":"Hayır, asla bildiğiniz gibi değil, keşke kesin bilgi ile bilseydiniz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6174,"surah_id":102,"verse_number":6,"verse":"لَتَرَوُنَّ الْجَح۪يمَۙ","verse_simplified":"لَتَرَوُنَّ الْجَحِيمَ","page":600,"juz_number":30,"transcription":"Le terevunnel cahim.","transcription_en":"Latarawunna aljaheem","translation":{"id":313333,"text":"Bilesiniz ki kesinlikle alevli ateşle karşı karşıya kalacaksınız.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6175,"surah_id":102,"verse_number":7,"verse":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَق۪ينِۙ","verse_simplified":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ","page":600,"juz_number":30,"transcription":"Summe le terevunneha aynel yakin.","transcription_en":"Thumma latarawunnaha AAayna alyaqeen","translation":{"id":313334,"text":"Sonra onu gözlerinizle kesin olarak göreceksiniz.","a