{"data":{"id":81,"name":"Tekvir","name_en":"At-Takwir","name_original":"سورة التكوير","name_translation_tr":"Dolama","name_translation_en":"The Overthrowing","slug":"tekvir","verse_count":29,"page_number":585,"audio":{"mp3":"https://audio.acikkuran.com/tr/81.mp3","duration":108,"mp3_en":"https://audio.acikkuran.com/en/081.mp3","duration_en":110},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5801,"surah_id":81,"verse_number":1,"verse":"اِذَا الشَّمْسُ كُـوِّرَتْۙۖ","verse_simplified":"إِذَا الشَّمْسُ كُوِّرَتْ","page":585,"juz_number":30,"transcription":"İzeş şemsu kuvviret.","transcription_en":"Itha ashshamsu kuwwirat","translation":{"id":312960,"text":"Güneş köreltildiği zaman[1],","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26579,"text":"Işığı karartıldığı zaman.","number":1}]}},{"id":5802,"surah_id":81,"verse_number":2,"verse":"وَاِذَا النُّجُومُ انْكَدَرَتْۙۖ","verse_simplified":"وَإِذَا النُّجُومُ انكَدَرَتْ","page":585,"juz_number":30,"transcription":"Ve izen nucumun kederet.","transcription_en":"Wa-itha annujoomu inkadarat","translation":{"id":312961,"text":"Yıldızlar bulanıklaştığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5803,"surah_id":81,"verse_number":3,"verse":"وَاِذَا الْجِبَالُ سُيِّرَتْۙۖ","verse_simplified":"وَإِذَا الْجِبَالُ سُيِّرَتْ","page":585,"juz_number":30,"transcription":"Ve izelcibalu suyyiret.","transcription_en":"Wa-itha aljibalu suyyirat","translation":{"id":312962,"text":"Dağlar yürütüldüğü zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5804,"surah_id":81,"verse_number":4,"verse":"وَاِذَا الْعِشَارُ عُطِّلَتْۙۖ","verse_simplified":"وَإِذَا الْعِشَارُ عُطِّلَتْ","page":585,"juz_number":30,"transcription":"Ve izel ışaru uttılet.","transcription_en":"Wa-itha alAAisharu AAuttilat","translation":{"id":312963,"text":"Gebe develer başıboş bırakıldığı[1] zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26580,"text":"Hiçbir malın öneminin kalmadığı zaman.","number":1}]}},{"id":5805,"surah_id":81,"verse_number":5,"verse":"وَاِذَا الْوُحُوشُ حُشِرَتْۙۖ","verse_simplified":"وَإِذَا الْوُحُوشُ حُشِرَتْ","page":585,"juz_number":30,"transcription":"Ve izel vuhuşu huşiret.","transcription_en":"Wa-itha alwuhooshu hushirat","translation":{"id":312964,"text":"Vahşi hayvanlar bir araya toplandıkları zaman,[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26581,"text":"Korkularından bir araya geldiklerinde.","number":1}]}},{"id":5806,"surah_id":81,"verse_number":6,"verse":"وَاِذَا الْبِحَارُ سُجِّرَتْۙۖ","verse_simplified":"وَإِذَا الْبِحَارُ سُجِّرَتْ","page":585,"juz_number":30,"transcription":"Ve izel biharu succiret.","transcription_en":"Wa-itha albiharu sujjirat","translation":{"id":312965,"text":"Denizler kaynatıldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5807,"surah_id":81,"verse_number":7,"verse":"وَاِذَا النُّفُوسُ زُوِّجَتْۙۖ","verse_simplified":"وَإِذَا النُّفُوسُ زُوِّجَتْ","page":585,"juz_number":30,"transcription":"Ve izen nufusu zuvvicet.","transcription_en":"Wa-itha annufoosu zuwwijat","translation":{"id":312966,"text":"Nefisler eşleştirildiği[1] zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26582,"text":"İnsanlar inançlarına göre gruplara ayrıldığı zaman. İnsanlar yaptıkları ile yüzleştikleri zaman. Ölü, yeniden diriltildiği zaman.","number":1}]}},{"id":5808,"surah_id":81,"verse_number":8,"verse":"وَاِذَا الْمَوْءُ۫دَةُ سُئِلَتْۙ","verse_simplified":"وَإِذَا الْمَوْؤُودَةُ سُئِلَتْ","page":585,"juz_number":30,"transcription":"Ve izel mev'udetu suilet.","transcription_en":"Wa-itha almawoodatu su-ilat","translation":{"id":312967,"text":"O diri diri toprağa gömülen kıza sorulduğu zaman;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5809,"surah_id":81,"verse_number":9,"verse":"بِاَيِّ ذَنْبٍ قُتِلَتْۚ","verse_simplified":"بِأَيِّ ذَنبٍ قُتِلَتْ","page":585,"juz_number":30,"transcription":"Bi eyyi zenbin kutilet.","transcription_en":"Bi-ayyi thanbin qutilat","translation":{"id":312968,"text":"Hangi suçtan dolayı öldürüldüğü!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5810,"surah_id":81,"verse_number":10,"verse":"وَاِذَا الصُّحُفُ نُشِرَتْۙۖ","verse_simplified":"وَإِذَا الصُّحُفُ نُشِرَتْ","page":585,"juz_number":30,"transcription":"Ve izes suhufu nuşiret.","transcription_en":"Wa-itha assuhufunushirat","translation":{"id":312969,"text":"Defterler açıldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5811,"surah_id":81,"verse_number":11,"verse":"وَاِذَا السَّمَٓاءُ كُشِطَتْۙۖ","verse_simplified":"وَإِذَا السَّمَاء كُشِطَتْ","page":585,"juz_number":30,"transcription":"Ve izes semau kuşitat.","transcription_en":"Wa-itha assamao kushitat","translation":{"id":312970,"text":"Gök soyulduğu[1] zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26583,"text":"Tıpkı bir gövdeden derisinin soyulması gibi. Tıpkı bir perde gibi açıldığı, ortadan kalktığı zaman.","number":1}]}},{"id":5812,"surah_id":81,"verse_number":12,"verse":"وَاِذَا الْجَح۪يمُ سُعِّرَتْۙۖ","verse_simplified":"وَإِذَا الْجَحِيمُ سُعِّرَتْ","page":585,"juz_number":30,"transcription":"Ve izel cahimu su'ıret.","transcription_en":"Wa-itha aljaheemu suAAAAirat","translation":{"id":312971,"text":"Cehennem kızıştırıldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5813,"surah_id":81,"verse_number":13,"verse":"وَاِذَا الْجَنَّةُ اُزْلِفَتْۙۖ","verse_simplified":"وَإِذَا الْجَنَّةُ أُزْلِفَتْ","page":585,"juz_number":30,"transcription":"Ve izel cennetu uzlifet.","transcription_en":"Wa-itha aljannatu ozlifat","translation":{"id":312972,"text":"Cennet yaklaştırıldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5814,"surah_id":81,"verse_number":14,"verse":"عَلِمَتْ نَفْسٌ مَٓا اَحْضَرَتْۜ","verse_simplified":"عَلِمَتْ نَفْسٌ مَّا أَحْضَرَتْ","page":585,"juz_number":30,"transcription":"Alimet nefsün ma ahdaret.","transcription_en":"AAalimat nafsun ma ahdarat","translation":{"id":312973,"text":"İnsan, kendisi ile ne getirdiğini görecektir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5815,"surah_id":81,"verse_number":15,"verse":"فَلَٓا اُقْسِمُ بِالْخُنَّسِۙ","verse_simplified":"فَلَا أُقْسِمُ بِالْخُنَّسِ","page":585,"juz_number":30,"transcription":"Fe la uksimu bil hunnes.","transcription_en":"Fala oqsimu bilkhunnas","translation":{"id":312974,"text":"Hayır, ant olsun sinenlere,[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26584,"text":"Gündüz kaybolan yıldızlara.","number":1}]}},{"id":5816,"surah_id":81,"verse_number":16,"verse":"اَلْجَوَارِ الْكُنَّسِۙ","verse_simplified":"الْجَوَارِ الْكُنَّسِ","page":585,"juz_number":30,"transcription":"El cevaril kunnes.","transcription_en":"Aljawari alkunnas","translation":{"id":312975,"text":"Yörüngesinde dönenlere,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5817,"surah_id":81,"verse_number":17,"verse":"وَالَّيْلِ اِذَا عَسْعَسَۙ","verse_simplified":"وَاللَّيْلِ إِذَا عَسْعَسَ","page":585,"juz_number":30,"transcription":"Vel leyli iza as'as.","transcription_en":"Wallayli itha AAasAAas","translation":{"id":312976,"text":"Kararmaya başladığı an geceye,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5818,"surah_id":81,"verse_number":18,"verse":"وَالصُّبْحِ اِذَا تَنَفَّسَۙ","verse_simplified":"وَالصُّبْحِ إِذَا تَنَفَّسَ","page":585,"juz_number":30,"transcription":"Ves subhı iza teneffes.","transcription_en":"Wassubhi ithatanaffas","translation":{"id":312977,"text":"Soluk almaya başladığı zaman sabaha ant olsun ki,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5819,"surah_id":81,"verse_number":19,"verse":"اِنَّهُ لَقَوْلُ رَسُولٍ كَر۪يمٍۙ","verse_simplified":"إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ","page":585,"juz_number":30,"transcription":"İnnehu le kavlu resulin kerim.","transcription_en":"Innahu laqawlu rasoolin kareem","translation":{"id":312978,"text":"Kuşkusuz o[1] çok şerefli bir resul sözüdür;[2]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26585,"text":"Vahiy/Kur'an.","number":1},{"id":26586,"text":"\"Elçi sözü,\" elçilik yapanın kendisine ait sözler değildir. Onu elçi olarak gönderene ait sözlerdir. Söz konusu elçi, Muhammed Nebi'dir. Elçinin \"Cebrail\" olduğu şeklindeki ifadeler doğru değildir. \"Elçi sözü\" ile kastedilen de vahiydir. Resul'ün sözleri vahiydir, Nebi'nin sözleri ise \"hadistir.\"","number":2}]}},{"id":5820,"surah_id":81,"verse_number":20,"verse":"ذ۪ي قُوَّةٍ عِنْدَ ذِي الْعَرْشِ مَك۪ينٍۙ","verse_simplified":"ذِي قُوَّةٍ عِندَ ذِي الْعَرْشِ مَكِينٍ","page":585,"juz_number":30,"transcription":"Zi kuvvetin ınde zil arşi mekin.","transcription_en":"Thee quwwatin AAinda theealAAarshi makeen","translation":{"id":312979,"text":"Güç sahibi, arşın sahibi yanında itibarlıdır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5821,"surah_id":81,"verse_number":21,"verse":"مُطَاعٍ ثَمَّ اَم۪ينٍۜ","verse_simplified":"مُطَاعٍ ثَمَّ أَمِينٍ","page":586,"juz_number":30,"transcription":"Mutaın semme emin.","transcription_en":"MutaAAin thamma ameen","translation":{"id":312980,"text":"Kendisine itaat edilen, orada güvenilendir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5822,"surah_id":81,"verse_number":22,"verse":"وَمَا صَاحِبُكُمْ بِمَجْنُونٍۚ","verse_simplified":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","page":586,"juz_number":30,"transcription":"Ve ma sahıbukum bi mecnun.","transcription_en":"Wama sahibukum bimajnoon","translation":{"id":312981,"text":"Arkadaşınız mecnun[1] değildir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26587,"text":"Cinlenmiş. Aklını kaybetmiş.","number":1}]}},{"id":5823,"surah_id":81,"verse_number":23,"verse":"وَلَقَدْ رَاٰهُ بِالْاُفُقِ الْمُب۪ينِۚ","verse_simplified":"وَلَقَدْ رَآهُ بِالْأُفُقِ الْمُبِينِ","page":586,"juz_number":30,"transcription":"Ve lekad reahu bil ufukıl mubin.","transcription_en":"Walaqad raahu bilofuqialmubeen","translation":{"id":312982,"text":"Ant olsun o, onu açık ufukta gördü.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5824,"surah_id":81,"verse_number":24,"verse":"وَمَا هُوَ عَلَى الْغَيْبِ بِضَن۪ينٍۚ","verse_simplified":"وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِينٍ","page":586,"juz_number":30,"transcription":"Ve ma huve alel gaybi bi danin.","transcription_en":"Wama huwa AAala alghaybi bidaneen","translation":{"id":312983,"text":"O vahyi gizlemez.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26588,"text":"Kelimesi kelimesine: \"O vahiy hakkında cimri değildir.\" O, kimsenin duymadığı, görmediği, bilmediği yolla kendisine vahyolunanı, olduğu gibi muhatabına iletir.","number":1}]}},{"id":5825,"surah_id":81,"verse_number":25,"verse":"وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَج۪يمٍۚ","verse_simplified":"وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَجِيمٍ","page":586,"juz_number":30,"transcription":"Ve ma huve bi kavli şeytanin recim.","transcription_en":"Wama huwa biqawli shaytaninrajeem","translation":{"id":312984,"text":"O, taşlanmış şeytanın sözü değildir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5826,"surah_id":81,"verse_number":26,"verse":"فَاَيْنَ تَذْهَبُونَۜ","verse_simplified":"فَأَيْنَ تَذْهَبُونَ","page":586,"juz_number":30,"transcription":"Fe eyne tezhebun.","transcription_en":"Faayna tathhaboon","translation":{"id":312985,"text":"O halde nereye gidiyorsunuz?[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26589,"text":"Nebi ve vahiy hakkında nasıl bu kadar yanlış düşünüyorsunuz?","number":1}]}},{"id":5827,"surah_id":81,"verse_number":27,"verse":"اِنْ هُوَ اِلَّا ذِكْرٌ لِلْعَالَم۪ينَۙ","verse_simplified":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَالَمِينَ","page":586,"juz_number":30,"transcription":"İn huve illa zikrun lil alemin.","transcription_en":"In huwa illa thikrun lilAAalameen","translation":{"id":312986,"text":"O alemler için zikirden[1] başka bir şey değildir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26590,"text":"Öğütten, hatırlatmaktan.","number":1}]}},{"id":5828,"surah_id":81,"verse_number":28,"verse":"لِمَنْ شَٓاءَ مِنْكُمْ اَنْ يَسْتَق۪يمَ","verse_simplified":"لِمَن شَاء مِنكُمْ أَن يَسْتَقِيمَ","page":586,"juz_number":30,"transcription":"Li men şae minkum en yestekim.","transcription_en":"Liman shaa minkum an yastaqeem","translation":{"id":312987,"text":"Sizden doğru yoldan gitmek isteyenler için.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5829,"surah_id":81,"verse_number":29,"verse":"وَمَا تَشَٓاؤُ۫نَ اِلَّٓا اَنْ يَشَٓاءَ اللّٰهُ رَبُّ الْعَالَم۪ينَ","verse_simplified":"وَمَا تَشَاؤُونَ إِلَّا أَن يَشَاء اللَّهُ رَبُّ الْعَالَمِينَ","page":586,"juz_number":30,"transcription":"Ve ma teşaune illa en yeşaallahu rabbul alemin.","transcription_en":"Wama tashaoona illa anyashaa Allahu rabbu alAAalameen","translation":{"id":312988,"text":"Alemlerin Rabb'i Allah dilemedikçe[1] siz dileyemezsiniz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26591,"text":"Allah sizi doğru yolu tercih etmek zorunda bırakmadıkça, kendiliğinizden doğru yola girmezsiniz. Hidayet ve dalalet konusu, insanın dilemesiyle ilgilidir. Allah, hiç kimseyi hak etmedikçe ne zorla hidayete iletir ne de dalalete düşürür. İman ve inkar konusunda sorumluluk bütünüyle insana aittir. Allah, insana dilediğini seçme hakkı tanımamış olsaydı, hiç kimse dilediğini seçemezdi. Allah, doğru yola iletilmek isteyeni doğru yola iletir; sapkınlıkta kalmak isteyeni de sapkınlıkta bırakır. Bu bağlamda Allah'ın dilemesi, kulunun dilemesine bağlıdır. Diğer bir deyimle Allah, kulunun seçimine müdahale edecek olsa, kul dilediğini yapamaz. Ne var ki kul, Allah tarafından dilediğini seçme sınavı ile baş başa bırakılmıştır. Eğer seçimi Allah yapıyor olsa bir sınavdan söz edilemez.","number":1}]}}]}}