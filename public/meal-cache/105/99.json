{"data":{"id":99,"name":"Zilzal","name_en":"Az-Zalzalah","name_original":"سورة الزلزلة","name_translation_tr":"Deprem","name_translation_en":"The Earthquake","slug":"zilzal","verse_count":8,"page_number":599,"audio":{"mp3":"https://audio.acikkuran.com/tr/99.mp3","duration":48,"mp3_en":"https://audio.acikkuran.com/en/099.mp3","duration_en":39},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6139,"surah_id":99,"verse_number":1,"verse":"اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ","verse_simplified":"إِذَا زُلْزِلَتِ الْأَرْضُ زِلْزَالَهَا","page":599,"juz_number":30,"transcription":"İza zulziletil ardu zilzaleha.","transcription_en":"Itha zulzilati al-ardu zilzalaha","translation":{"id":313298,"text":"Yeryüzü şiddetli sarsıntı ile sarsıldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6140,"surah_id":99,"verse_number":2,"verse":"وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ","verse_simplified":"وَأَخْرَجَتِ الْأَرْضُ أَثْقَالَهَا","page":599,"juz_number":30,"transcription":"Ve ahrecetil ardu eskaleha.","transcription_en":"Waakhrajati al-ardu athqalaha","translation":{"id":313299,"text":"Yeryüzü ağırlıklarını çıkardığı;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6141,"surah_id":99,"verse_number":3,"verse":"وَقَالَ الْاِنْسَانُ مَا لَهَاۚ","verse_simplified":"وَقَالَ الْإِنسَانُ مَا لَهَا","page":599,"juz_number":30,"transcription":"Ve kalel insanu ma leha.","transcription_en":"Waqala al-insanu ma laha","translation":{"id":313300,"text":"Ve insan, \"Ona ne oluyor?\" dediği,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6142,"surah_id":99,"verse_number":4,"verse":"يَوْمَئِذٍ تُحَدِّثُ اَخْبَارَهَاۙ","verse_simplified":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","page":599,"juz_number":30,"transcription":"Yevme izin tuhaddisu ahbareha.","transcription_en":"Yawma-ithin tuhaddithu akhbaraha","translation":{"id":313301,"text":"O Gün,[1] hadislerini[2] anlatacak.[3]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26738,"text":"Hesap sorma günü, yalnızca Allah'ın belirlediği ilke ve kuralların geçerli olduğu gün.","number":1},{"id":26739,"text":"Haberlerini.","number":2},{"id":26740,"text":"O gün yeryüzü hal diliyle olup biteni anlatacak.","number":3}]}},{"id":6143,"surah_id":99,"verse_number":5,"verse":"بِاَنَّ رَبَّكَ اَوْحٰى لَهَاۜ","verse_simplified":"بِأَنَّ رَبَّكَ أَوْحَى لَهَا","page":599,"juz_number":30,"transcription":"Bi enne rabbeke evhaleha.","transcription_en":"Bi-anna rabbaka awha laha","translation":{"id":313302,"text":"Çünkü Rabb'in ona vahyetmiştir.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26741,"text":"Böyle düzen koymuştur.","number":1}]}},{"id":6144,"surah_id":99,"verse_number":6,"verse":"يَوْمَئِذٍ يَصْدُرُ النَّاسُ اَشْتَاتاً لِيُرَوْا اَعْمَالَهُمْۜ","verse_simplified":"يَوْمَئِذٍ يَصْدُرُ النَّاسُ أَشْتَاتًا لِّيُرَوْا أَعْمَالَهُمْ","page":599,"juz_number":30,"transcription":"Yevme izin yasdurun nasu eştaten li yurev a'malehum.","transcription_en":"Yawma-ithin yasduru annasuashtatan liyuraw aAAmalahum","translation":{"id":313303,"text":"O Gün, insanlar amelleri kendilerine gösterilsin diye grup grup ortaya çıkacaklar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6145,"surah_id":99,"verse_number":7,"verse":"فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْراً يَرَهُۜ","verse_simplified":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ","page":599,"juz_number":30,"transcription":"Fe men ya'mel miskale zerretin hayren yereh.","transcription_en":"Faman yaAAmal mithqala tharratinkhayran yarah","translation":{"id":313304,"text":"Artık kim zerre ağırlığınca iyilik yapmışsa onu görür.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6146,"surah_id":99,"verse_number":8,"verse":"وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَراًّ يَرَهُ","verse_simplified":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ","page":599,"juz_number":30,"transcription":"Ve men ya'mel miskale zerretin şerren yereh.","transcription_en":"Waman yaAAmal mithqala tharratinsharran yarah","translation":{"id":313305,"text":"Ve kim zerre ağırlığınca kötülük yapmışsa onu görür.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}