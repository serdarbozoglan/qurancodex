{"data":{"id":87,"name":"Ala","name_en":"Al-A'la","name_original":"سورة الأعلى","name_translation_tr":"Yüce","name_translation_en":"The Most High","slug":"ala","verse_count":19,"page_number":591,"audio":{"mp3":"https://audio.acikkuran.com/tr/87.mp3","duration":78,"mp3_en":"https://audio.acikkuran.com/en/087.mp3","duration_en":83},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5949,"surah_id":87,"verse_number":1,"verse":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلٰىۙ","verse_simplified":"سَبِّحِ اسْمَ رَبِّكَ الْأَعْلَى","page":591,"juz_number":30,"transcription":"Sebbihısme rabbikel a'la.","transcription_en":"Sabbihi isma rabbika al-aAAla","translation":{"id":313108,"text":"Rabb'inin yüce adını tesbih[1] et.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26643,"text":"Allah'ın, her türlü kusur ve eksiklikten arınık, bütün mükemmel niteliklere sahip olduğunu bilmek; Allah'ı kendisine özgü nitelikleri ile tanımak ve tanıtmak demektir. Tesbih, tevhid inancının ve anlayışının kavranmasıdır. Allah'ı şirk içeren her türlü düşünce ve inançtan arındırarak, Kendisine özgü nitelikleri ile yüceltmek demektir (20:130). Tesbihi, bazı sözlerin (Subhanallah, Elhamdulillah vb.) belli sayılarla tekrar edilmesine indirgemek hurafeden başka bir şey değildir.","number":1}]}},{"id":5950,"surah_id":87,"verse_number":2,"verse":"اَلَّذ۪ي خَلَقَ فَسَوّٰىۙۖ","verse_simplified":"الَّذِي خَلَقَ فَسَوَّى","page":591,"juz_number":30,"transcription":"Ellezi halaka fesevva.","transcription_en":"Allathee khalaqa fasawwa","translation":{"id":313109,"text":"O ki yarattı ve düzene koydu.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5951,"surah_id":87,"verse_number":3,"verse":"وَالَّذ۪ي قَدَّرَ فَهَدٰىۙۖ","verse_simplified":"وَالَّذِي قَدَّرَ فَهَدَى","page":591,"juz_number":30,"transcription":"Vellezi kaddere fe heda.","transcription_en":"Wallathee qaddara fahada","translation":{"id":313110,"text":"O ki takdir etti[1] ve yol gösterdi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26644,"text":"Her varlığa kendisine özgü özellikler (fıtrat) verdi.","number":1}]}},{"id":5952,"surah_id":87,"verse_number":4,"verse":"وَالَّـذ۪ٓي اَخْرَجَ الْمَرْعٰىۙۖ","verse_simplified":"وَالَّذِي أَخْرَجَ الْمَرْعَى","page":591,"juz_number":30,"transcription":"Vellezi ahrecel mer'a.","transcription_en":"Wallathee akhraja almarAAa","translation":{"id":313111,"text":"O ki yerden bitkiler, yeşillikler çıkardı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5953,"surah_id":87,"verse_number":5,"verse":"فَجَعَلَهُ غُثَٓاءً اَحْوٰىۜ","verse_simplified":"فَجَعَلَهُ غُثَاء أَحْوَى","page":591,"juz_number":30,"transcription":"Fe cealehu gusaen ahva.","transcription_en":"FajaAAalahu ghuthaan ahwa","translation":{"id":313112,"text":"Derken onu kuru, kararmış çer çöp haline getirdi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5954,"surah_id":87,"verse_number":6,"verse":"سَنُقْرِئُكَ فَلَا تَنْسٰىۙ","verse_simplified":"سَنُقْرِؤُكَ فَلَا تَنسَى","page":591,"juz_number":30,"transcription":"Senukriuke fe la tensa.","transcription_en":"Sanuqri-oka fala tansa","translation":{"id":313113,"text":"Sana okutacağız;[1] bir daha unutmayacaksın;[2]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26645,"text":"Sana ne yapacağını bildireceğiz. Gideceğin yolu göstereceğiz.","number":1},{"id":26646,"text":"Bir daha şaşırmayacaksın.","number":2}]}},{"id":5955,"surah_id":87,"verse_number":7,"verse":"اِلَّا مَا شَٓاءَ اللّٰهُۜ  اِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۜ","verse_simplified":"إِلَّا مَا شَاء اللَّهُ إِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفَى","page":591,"juz_number":30,"transcription":"İlla ma şaallah, innehu ya'lemul cehre ve ma yahfa.","transcription_en":"Illa ma shaa Allahuinnahu yaAAlamu aljahra wama yakhfa","translation":{"id":313114,"text":"Allah, aksini dilemedikçe. Kuşkusuz O, açık ve gizli olanı bilir.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26647,"text":"Mesajı iletmede ne yapıp ne yapmadığını bilir.","number":1}]}},{"id":5956,"surah_id":87,"verse_number":8,"verse":"وَنُيَسِّرُكَ لِلْيُسْرٰىۚ","verse_simplified":"وَنُيَسِّرُكَ لِلْيُسْرَى","page":591,"juz_number":30,"transcription":"Ve nuyessiruke lil yusra.","transcription_en":"Wanuyassiruka lilyusra","translation":{"id":313115,"text":"Kolay gelmesi için, sana yeterince kolaylaştıracağız.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26648,"text":"Bu yolda karşılaşacağın zorluklardan çekinme, Biz sana yardım edeceğiz.","number":1}]}},{"id":5957,"surah_id":87,"verse_number":9,"verse":"فَذَكِّرْ اِنْ نَفَعَتِ الذِّكْرٰىۜ","verse_simplified":"فَذَكِّرْ إِن نَّفَعَتِ الذِّكْرَى","page":591,"juz_number":30,"transcription":"Fe zekkir in nefeatiz zikra.","transcription_en":"Fathakkir in nafaAAati aththikra","translation":{"id":313116,"text":"O halde öğüt ver,[1] öğüt yararlı olacaksa!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26649,"text":"Yararlı olup olmadığına bakmaksızın sen öğüt vermeye devam et.","number":1}]}},{"id":5958,"surah_id":87,"verse_number":10,"verse":"سَيَذَّكَّرُ مَنْ يَخْشٰىۙ","verse_simplified":"سَيَذَّكَّرُ مَن يَخْشَى","page":591,"juz_number":30,"transcription":"Seyezzekkeru men yahşa.","transcription_en":"Sayaththakkaru man yakhsha","translation":{"id":313117,"text":"Huşu[1] duyan kimse öğüt alacaktır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26650,"text":"Derin saygı ve içtenlik.","number":1}]}},{"id":5959,"surah_id":87,"verse_number":11,"verse":"وَيَتَجَنَّبُهَا الْاَشْقٰىۙ","verse_simplified":"وَيَتَجَنَّبُهَا الْأَشْقَى","page":591,"juz_number":30,"transcription":"Ve yetecennebuhel eşka.","transcription_en":"Wayatajannabuha al-ashqa","translation":{"id":313118,"text":"Şaki[1] olan ondan kaçınır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26651,"text":"Bahtsız, azgınlaşan.","number":1}]}},{"id":5960,"surah_id":87,"verse_number":12,"verse":"اَلَّذ۪ي يَصْلَى النَّارَ الْـكُبْرٰىۚ","verse_simplified":"الَّذِي يَصْلَى النَّارَ الْكُبْرَى","page":591,"juz_number":30,"transcription":"Ellezi yaslen narel kubra.","transcription_en":"Allathee yasla annaraalkubra","translation":{"id":313119,"text":"Ki o, büyük ateşe atılacaktır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5961,"surah_id":87,"verse_number":13,"verse":"ثُمَّ لَا يَمُوتُ ف۪يهَا وَلَا يَحْيٰىۜ","verse_simplified":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَى","page":591,"juz_number":30,"transcription":"Summe la yemutu fiha ve la yahya.","transcription_en":"Thumma la yamootu feeha walayahya","translation":{"id":313120,"text":"Sonra orada ölüm de yok, yaşam da.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26652,"text":"Ölüp kurtulmak da yok, rahat yüzü görmek de.","number":1}]}},{"id":5962,"surah_id":87,"verse_number":14,"verse":"قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ","verse_simplified":"قَدْ أَفْلَحَ مَن تَزَكَّى","page":591,"juz_number":30,"transcription":"Kad efleha men tezekka.","transcription_en":"Qad aflaha man tazakka","translation":{"id":313121,"text":"Doğrusu arınan kimse kurtuluşa ermiştir;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5963,"surah_id":87,"verse_number":15,"verse":"وَذَكَرَ اسْمَ رَبِّه۪ فَصَلّٰىۜ","verse_simplified":"وَذَكَرَ اسْمَ رَبِّهِ فَصَلَّى","page":591,"juz_number":30,"transcription":"Ve zekeresme rabbihi fe salla.","transcription_en":"Wathakara isma rabbihi fasalla","translation":{"id":313122,"text":"Rabb'inin adını anıp salla[1] eden.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26653,"text":"Ayette yer alan \"salla\" kelimesine \"namaz kılmak\" anlamı verilmek önemli bir yanılgıdır. \"Salla\" kelimesi, bu ayette, \"namaz kılmak\" anlamında değil, yönelmek, destek olmak anlamındadır. Salat, ibadete layık yegane ilahın Allah olduğuna inanmak, şirkten arınmış bir bilinçle Allah'a yönelme demektir. Bu yönelme: Sürekli destek olmak, dayanışmak, ilgi duymak, duyarlı olmak, izleyici kalmamak, yanında yer almaktır. Salatın diğer anlamları şunlardır: Ritüel salat (Namaz), daa etmek, din, havra. Salatın hangi anlamı ifade ettiği, içinde yer aldığı ayet ve konu bağlamından rahatlıkla anlaşılabilir.","number":1}]}},{"id":5964,"surah_id":87,"verse_number":16,"verse":"بَلْ تُؤْثِرُونَ الْحَيٰوةَ الدُّنْيَاۘ","verse_simplified":"بَلْ تُؤْثِرُونَ الْحَيَاةَ الدُّنْيَا","page":591,"juz_number":30,"transcription":"Bel tu'sırunel hayated dunya.","transcription_en":"Bal tu/thiroona alhayata addunya","translation":{"id":313123,"text":"Ne var ki siz[1] dünya hayatını tercih ediyorsunuz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26654,"text":"Siz zamirinden kasıt, Müşrikler ve Kafirlerdir. Salla etmeyenlerdir.","number":1}]}},{"id":5965,"surah_id":87,"verse_number":17,"verse":"وَالْاٰخِرَةُ خَيْرٌ وَاَبْـقٰىۜ","verse_simplified":"وَالْآخِرَةُ خَيْرٌ وَأَبْقَى","page":591,"juz_number":30,"transcription":"Vel ahıretu hayrun ve ebka.","transcription_en":"Wal-akhiratu khayrun waabqa","translation":{"id":313124,"text":"Oysaki ahiret hayatı daha hayırlı ve daha kalıcıdır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5966,"surah_id":87,"verse_number":18,"verse":"اِنَّ هٰذَا لَفِي الصُّحُفِ الْاُو۫لٰىۙ","verse_simplified":"إِنَّ هَذَا لَفِي الصُّحُفِ الْأُولَى","page":591,"juz_number":30,"transcription":"İnne haza le fis suhufil ula.","transcription_en":"Inna hatha lafee assuhufial-oola","translation":{"id":313125,"text":"Bu, önceki sahifelerde[1] de vardı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26655,"text":"Vahiylerde. Gönderilen Kitaplarda.","number":1}]}},{"id":5967,"surah_id":87,"verse_number":19,"verse":"صُحُفِ اِبْرٰه۪يمَ وَمُوسٰى","verse_simplified":"صُحُفِ إِبْرَاهِيمَ وَمُوسَى","page":591,"juz_number":30,"transcription":"Suhufi ibrahime ve musa.","transcription_en":"Suhufi ibraheema wamoosa","translation":{"id":313126,"text":"İbrahim'ın ve Musa'nın sahifelerinde.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}