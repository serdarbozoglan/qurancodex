{"data":{"id":79,"name":"Naziat","name_en":"An-Nazi'at","name_original":"سورة النازعات","name_translation_tr":"Söküp Çıkaranlar","name_translation_en":"Those who drag forth","slug":"naziat","verse_count":46,"page_number":582,"audio":{"mp3":"https://audio.acikkuran.com/tr/79.mp3","duration":205,"mp3_en":"https://audio.acikkuran.com/en/079.mp3","duration_en":190},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5713,"surah_id":79,"verse_number":1,"verse":"وَالنَّازِعَاتِ غَرْقاًۙ","verse_simplified":"وَالنَّازِعَاتِ غَرْقًا","page":582,"juz_number":30,"transcription":"Ven naziati garka.","transcription_en":"WannaziAAati gharqa","translation":{"id":312872,"text":"Ant olsun şiddetle çekip alanlara.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5714,"surah_id":79,"verse_number":2,"verse":"وَالنَّاشِطَاتِ نَشْطاًۙ","verse_simplified":"وَالنَّاشِطَاتِ نَشْطًا","page":582,"juz_number":30,"transcription":"Ven naşitati neşta.","transcription_en":"Wannashitati nashta","translation":{"id":312873,"text":"Ant olsun kolayca çekip alanlara.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5715,"surah_id":79,"verse_number":3,"verse":"وَالسَّابِحَاتِ سَبْحاًۙ","verse_simplified":"وَالسَّابِحَاتِ سَبْحًا","page":582,"juz_number":30,"transcription":"Ves sabihati sebha.","transcription_en":"Wassabihati sabha","translation":{"id":312874,"text":"Ant olsun yüzdükçe yüzenlere.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5716,"surah_id":79,"verse_number":4,"verse":"فَالسَّابِقَاتِ سَبْقاًۙ","verse_simplified":"فَالسَّابِقَاتِ سَبْقًا","page":582,"juz_number":30,"transcription":"Fes sabikati sebka.","transcription_en":"Fassabiqati sabqa","translation":{"id":312875,"text":"Ve de yarıştıkça yarışanlara.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5717,"surah_id":79,"verse_number":5,"verse":"فَالْمُدَبِّرَاتِ اَمْراًۢ","verse_simplified":"فَالْمُدَبِّرَاتِ أَمْرًا","page":582,"juz_number":30,"transcription":"Fel mudebbirati emra.","transcription_en":"Falmudabbirati amra","translation":{"id":312876,"text":"Ve de işi yerine getirenlere.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26557,"text":"İlk beş ayete; yıldızlarla veya meleklerle bağlantı kurarak anlam verenlerin yanı sıra; meleklerle, atlarla ve gemilerle bağlantı kurarak anlam verenler de bulunmaktadır. Bu ayetlerde, Rabb'imiz yıldız, gemi, at gibi nimetlere, o nimetleri yaratan güce, evrendeki mükemmelliğe vurgu yapmaktadır.","number":1}]}},{"id":5718,"surah_id":79,"verse_number":6,"verse":"يَوْمَ تَرْجُفُ الرَّاجِفَةُۙ","verse_simplified":"يَوْمَ تَرْجُفُ الرَّاجِفَةُ","page":582,"juz_number":30,"transcription":"Yevme tercufur racifeh.","transcription_en":"Yawma tarjufu arrajifa","translation":{"id":312877,"text":"O Gün sarsan sarsacak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5719,"surah_id":79,"verse_number":7,"verse":"تَتْبَعُهَا الرَّادِفَةُۜ","verse_simplified":"تَتْبَعُهَا الرَّادِفَةُ","page":582,"juz_number":30,"transcription":"Tetbeuher radifeh.","transcription_en":"TatbaAAuha arradifa","translation":{"id":312878,"text":"Arkasından gelen onu izleyecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5720,"surah_id":79,"verse_number":8,"verse":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌۙ","verse_simplified":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","page":582,"juz_number":30,"transcription":"Kulubun yevmeizin vacifeh.","transcription_en":"Quloobun yawma-ithin wajifa","translation":{"id":312879,"text":"O Gün kalpler endişe ile çarpar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5721,"surah_id":79,"verse_number":9,"verse":"اَبْصَارُهَا خَاشِعَةٌۢ","verse_simplified":"أَبْصَارُهَا خَاشِعَةٌ","page":582,"juz_number":30,"transcription":"Ebsaruha haşiah.","transcription_en":"Absaruha khashiAAa","translation":{"id":312880,"text":"Bakışları korku içindedir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5722,"surah_id":79,"verse_number":10,"verse":"يَقُولُونَ ءَاِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِۜ","verse_simplified":"يَقُولُونَ أَئِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِ","page":582,"juz_number":30,"transcription":"Yekulune e inna le merdudune fil hafireh.","transcription_en":"Yaqooloona a-inna lamardoodoona feealhafira","translation":{"id":312881,"text":"\"Biz, tekrar eski halimize mi döndürülecekmişiz?\" diyorlar;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5723,"surah_id":79,"verse_number":11,"verse":"ءَاِذَا كُنَّا عِظَاماً نَخِرَةًۜ","verse_simplified":"أَئِذَا كُنَّا عِظَامًا نَّخِرَةً","page":582,"juz_number":30,"transcription":"E iza kunna izamen nahıreh.","transcription_en":"A-itha kunna AAithamannakhira","translation":{"id":312882,"text":"Çürümüş, dağılmış kemikler olmuşken?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5724,"surah_id":79,"verse_number":12,"verse":"قَالُوا تِلْكَ اِذاً كَرَّةٌ خَاسِرَةٌۢ","verse_simplified":"قَالُوا تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","page":582,"juz_number":30,"transcription":"Kalu tilke izen kerretun hasireh.","transcription_en":"Qaloo tilka ithan karratun khasira","translation":{"id":312883,"text":"\"Öyleyse, bu hüsranlı bir dönüştür.\" dediler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5725,"surah_id":79,"verse_number":13,"verse":"فَاِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌۙ","verse_simplified":"فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ","page":582,"juz_number":30,"transcription":"Fe innema hiye zecretun vahıdeh.","transcription_en":"Fa-innama hiya zajratun wahida","translation":{"id":312884,"text":"Oysaki o, tek bir haykırıştır!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5726,"surah_id":79,"verse_number":14,"verse":"فَاِذَا هُمْ بِالسَّاهِرَةِۜ","verse_simplified":"فَإِذَا هُم بِالسَّاهِرَةِ","page":582,"juz_number":30,"transcription":"Fe iza hum bis sahireh.","transcription_en":"Fa-itha hum bissahira","translation":{"id":312885,"text":"Bir de bakmışsın meydandalar.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26558,"text":"Mahşer yerindedirler.","number":1}]}},{"id":5727,"surah_id":79,"verse_number":15,"verse":"هَلْ اَتٰيكَ حَد۪يثُ مُوسٰىۢ","verse_simplified":"هَلْ أتَاكَ حَدِيثُ مُوسَى","page":583,"juz_number":30,"transcription":"Hel etake hadisu musa.","transcription_en":"Hal ataka hadeethu moosa","translation":{"id":312886,"text":"Musa'nın hadisi[1] sana geldi mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26559,"text":"Haberi.","number":1}]}},{"id":5728,"surah_id":79,"verse_number":16,"verse":"اِذْ نَادٰيهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًىۚ","verse_simplified":"إِذْ نَادَاهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًى","page":583,"juz_number":30,"transcription":"İz nadahu rabbuhu bil vadil mukaddesi tuva.","transcription_en":"Ith nadahu rabbuhu bilwadialmuqaddasi tuwa","translation":{"id":312887,"text":"Hani, Rabb'i ona kutsal vadi Tuva'da seslenmişti!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5729,"surah_id":79,"verse_number":17,"verse":"اِذْهَبْ اِلٰى فِرْعَوْنَ اِنَّهُ طَغٰىۘ","verse_simplified":"اذْهَبْ إِلَى فِرْعَوْنَ إِنَّهُ طَغَى","page":583,"juz_number":30,"transcription":"İzheb ila fir'avne innehu taga.","transcription_en":"Ithhab ila firAAawna innahu tagha","translation":{"id":312888,"text":"\"Firavun'a git. Kuşkusuz o azgınlaştı.\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5730,"surah_id":79,"verse_number":18,"verse":"فَقُلْ هَلْ لَكَ اِلٰٓى اَنْ تَزَكّٰىۙ","verse_simplified":"فَقُلْ هَل لَّكَ إِلَى أَن تَزَكَّى","page":583,"juz_number":30,"transcription":"Fe kul hel leke ila en tezekka.","transcription_en":"Faqul hal laka ila an tazakka","translation":{"id":312889,"text":"\"Git ona de ki: Arınmak ister misin?\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5731,"surah_id":79,"verse_number":19,"verse":"وَاَهْدِيَكَ اِلٰى رَبِّكَ فَتَخْشٰىۚ","verse_simplified":"وَأَهْدِيَكَ إِلَى رَبِّكَ فَتَخْشَى","page":583,"juz_number":30,"transcription":"Ve ehdiyeke ila rabbike fe tahşa.","transcription_en":"Waahdiyaka ila rabbika fatakhsha","translation":{"id":312890,"text":"\"Sana Rabb'inin yolunu göstereyim de içtenlikle O'na yönelmiş ol.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5732,"surah_id":79,"verse_number":20,"verse":"فَاَرٰيهُ الْاٰيَةَ الْـكُبْرٰىۘ","verse_simplified":"فَأَرَاهُ الْآيَةَ الْكُبْرَى","page":583,"juz_number":30,"transcription":"Fe erahul ayetel kubra.","transcription_en":"Faarahu al-ayata alkubra","translation":{"id":312891,"text":"Sonra Musa, Firavun'a büyük ayeti[1] gösterdi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26560,"text":"Göstergeyi, mucizeyi.","number":1}]}},{"id":5733,"surah_id":79,"verse_number":21,"verse":"فَـكَذَّبَ وَعَصٰىۘ","verse_simplified":"فَكَذَّبَ وَعَصَى","page":583,"juz_number":30,"transcription":"Fe kezzebe ve asa.","transcription_en":"Fakaththaba waAAasa","translation":{"id":312892,"text":"Fakat yalanladı ve karşı çıktı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5734,"surah_id":79,"verse_number":22,"verse":"ثُمَّ اَدْبَرَ يَسْعٰىۘ","verse_simplified":"ثُمَّ أَدْبَرَ يَسْعَى","page":583,"juz_number":30,"transcription":"Summe edbere yes'a.","transcription_en":"Thumma adbara yasAAa","translation":{"id":312893,"text":"Sonra aleyhte çalışmaya koyuldu.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5735,"surah_id":79,"verse_number":23,"verse":"فَحَشَرَ فَنَادٰىۘ","verse_simplified":"فَحَشَرَ فَنَادَى","page":583,"juz_number":30,"transcription":"Fehaşere fe nada.","transcription_en":"Fahashara fanada","translation":{"id":312894,"text":"Adamlarını toplayarak seslendi:","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5736,"surah_id":79,"verse_number":24,"verse":"فَقَالَ اَنَا۬ رَبُّكُمُ الْاَعْلٰىۘ","verse_simplified":"فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَى","page":583,"juz_number":30,"transcription":"Fe kale ene rabbukumul a'la.","transcription_en":"Faqala ana rabbukumu al-aAAla","translation":{"id":312895,"text":"\"Ben sizin yüce rabbinizim.\" dedi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5737,"surah_id":79,"verse_number":25,"verse":"فَاَخَذَهُ اللّٰهُ نَكَالَ الْاٰخِرَةِ وَالْاُو۫لٰىۜ","verse_simplified":"فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَى","page":583,"juz_number":30,"transcription":"Fe ehazehullahu nekalel ahıreti vel ula.","transcription_en":"Faakhathahu Allahu nakalaal-akhirati wal-oola","translation":{"id":312896,"text":"Allah da onu dünya ve ahiret azabıyla cezalandırdı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5738,"surah_id":79,"verse_number":26,"verse":"اِنَّ ف۪ي ذٰلِكَ لَعِبْرَةً لِمَنْ يَخْشٰىۜ۟","verse_simplified":"إِنَّ فِي ذَلِكَ لَعِبْرَةً لِّمَن يَخْشَى","page":583,"juz_number":30,"transcription":"İnne fi zalike le ıbreten li men yahşa.","transcription_en":"Inna fee thalika laAAibratan limanyakhsha","translation":{"id":312897,"text":"Kuşkusuz bunda huşu[1] duyan kimse için ibret vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26561,"text":"Allah'a karşı derin saygı, içten sevgi duymak, cani gönülden Allah'a yönelmek, alçak gönüllü, bilinçli ve duyarlı olmak. Derin saygı ve içten sevgi beslediği; üstün ve yüce görmenin sonucu olarak hayranlık duyduğu yüce varlıktan ayrı düşme, uzak kalma endişesini/korkusunu taşımak.","number":1}]}},{"id":5739,"surah_id":79,"verse_number":27,"verse":"ءَاَنْتُمْ اَشَدُّ خَلْقاً اَمِ السَّمَٓاءُۜ بَنٰيهَا۠","verse_simplified":"أَأَنتُمْ أَشَدُّ خَلْقًا أَمِ السَّمَاء بَنَاهَا","page":583,"juz_number":30,"transcription":"E entum eşeddu halkan emis sema', benaha.","transcription_en":"Aantum ashaddu khalqan ami assamaobanaha","translation":{"id":312898,"text":"Sizi yaratmak mı daha zor, yoksa göğü bina etmek mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5740,"surah_id":79,"verse_number":28,"verse":"رَفَعَ سَمْكَهَا فَسَوّٰيهَاۙ","verse_simplified":"رَفَعَ سَمْكَهَا فَسَوَّاهَا","page":583,"juz_number":30,"transcription":"Refea semkeha fe sevvaha.","transcription_en":"RafaAAa samkaha fasawwaha","translation":{"id":312899,"text":"Onu yükseltti ve düzene koydu.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5741,"surah_id":79,"verse_number":29,"verse":"وَاَغْطَشَ لَيْلَهَا وَاَخْرَجَ ضُحٰيهَاۖ","verse_simplified":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَاهَا","page":583,"juz_number":30,"transcription":"Ve agtaşe leyleha ve ahrece duhaha.","transcription_en":"Waaghtasha laylaha waakhraja duhaha","translation":{"id":312900,"text":"Gecesini kararttı, gündüzünü aydınlattı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5742,"surah_id":79,"verse_number":30,"verse":"وَالْاَرْضَ بَعْدَ ذٰلِكَ دَحٰيهَاۜ","verse_simplified":"وَالْأَرْضَ بَعْدَ ذَلِكَ دَحَاهَا","page":583,"juz_number":30,"transcription":"Vel arda ba'de zalike dehaha.","transcription_en":"Wal-arda baAAda thalikadahaha","translation":{"id":312901,"text":"Yeryüzünü yayıp yuvarlattı.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26562,"text":"Devekuşu yumurtası biçimine soktu.","number":1}]}},{"id":5743,"surah_id":79,"verse_number":31,"verse":"اَخْرَجَ مِنْهَا مَٓاءَهَا وَمَرْعٰيهَاۖ","verse_simplified":"أَخْرَجَ مِنْهَا مَاءهَا وَمَرْعَاهَا","page":583,"juz_number":30,"transcription":"Ahrece minha maeha ve mer'aha.","transcription_en":"Akhraja minha maahawamarAAaha","translation":{"id":312902,"text":"Ondan suyunu ve yeşilliğini çıkardı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5744,"surah_id":79,"verse_number":32,"verse":"وَالْجِبَالَ اَرْسٰيهَاۙ","verse_simplified":"وَالْجِبَالَ أَرْسَاهَا","page":583,"juz_number":30,"transcription":"Vel cibale ersaha.","transcription_en":"Waljibala arsaha","translation":{"id":312903,"text":"Ona dağlar yerleştirdi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5745,"surah_id":79,"verse_number":33,"verse":"مَتَاعاً لَكُمْ وَلِاَنْعَامِكُمْۜ","verse_simplified":"مَتَاعًا لَّكُمْ وَلِأَنْعَامِكُمْ","page":583,"juz_number":30,"transcription":"Metaan lekum ve li en amikum.","transcription_en":"MataAAan lakum wali-anAAamikum","translation":{"id":312904,"text":"Sizin ve hayvanlarınızın geçimi için.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5746,"surah_id":79,"verse_number":34,"verse":"فَاِذَا جَٓاءَتِ الطَّٓامَّةُ الْكُبْرٰىۘ","verse_simplified":"فَإِذَا جَاءتِ الطَّامَّةُ الْكُبْرَى","page":583,"juz_number":30,"transcription":"Fe iza caetit tammetul kubra.","transcription_en":"Fa-itha jaati attammatualkubra","translation":{"id":312905,"text":"Fakat o en büyük olay[1] gerçekleştiği zaman.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26563,"text":"Kıyamet vakti.","number":1}]}},{"id":5747,"surah_id":79,"verse_number":35,"verse":"يَوْمَ يَتَذَكَّرُ الْاِنْسَانُ مَا سَعٰىۙ","verse_simplified":"يَوْمَ يَتَذَكَّرُ الْإِنسَانُ مَا سَعَى","page":583,"juz_number":30,"transcription":"Yevme yetezekkerul insanu ma sea.","transcription_en":"Yawma yatathakkaru al-insanu masaAAa","translation":{"id":312906,"text":"O Gün insan ne yaptığını hatırlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5748,"surah_id":79,"verse_number":36,"verse":"وَبُرِّزَتِ الْجَح۪يمُ لِمَنْ يَرٰى","verse_simplified":"وَبُرِّزَتِ الْجَحِيمُ لِمَن يَرَى","page":583,"juz_number":30,"transcription":"Ve burrizetil cahimu li men yera.","transcription_en":"Waburrizati aljaheemu liman yara","translation":{"id":312907,"text":"Gören kimseler için Cehennem açıkça gösterilecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5749,"surah_id":79,"verse_number":37,"verse":"فَاَمَّا مَنْ طَغٰىۙ","verse_simplified":"فَأَمَّا مَن طَغَى","page":583,"juz_number":30,"transcription":"Fe emma men taga.","transcription_en":"Faamma man tagha","translation":{"id":312908,"text":"Fakat kim azgınlaşmış,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5750,"surah_id":79,"verse_number":38,"verse":"وَاٰثَرَ الْحَيٰوةَ الدُّنْيَاۙ","verse_simplified":"وَآثَرَ الْحَيَاةَ الدُّنْيَا","page":583,"juz_number":30,"transcription":"Ve aserel hayated dunya.","transcription_en":"Waathara alhayata addunya","translation":{"id":312909,"text":"Yalnızca dünya hayatını tercih etmişse,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5751,"surah_id":79,"verse_number":39,"verse":"فَاِنَّ الْجَح۪يمَ هِيَ الْمَأْوٰىۜ","verse_simplified":"فَإِنَّ الْجَحِيمَ هِيَ الْمَأْوَى","page":583,"juz_number":30,"transcription":"Fe innel cahime hiyel me'va.","transcription_en":"Fa-inna aljaheema hiya alma/wa","translation":{"id":312910,"text":"Kuşkusuz Cehennem onun için barınaktır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5752,"surah_id":79,"verse_number":40,"verse":"وَاَمَّا مَنْ خَافَ مَقَامَ رَبِّه۪ وَنَهَى النَّفْسَ عَنِ الْهَوٰىۙ","verse_simplified":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِ وَنَهَى النَّفْسَ عَنِ الْهَوَى","page":583,"juz_number":30,"transcription":"Ve emma men hafe makame rabbihi ve nehennefse anil heva.","transcription_en":"Waama man khafa maqamarabbihi wanaha annafsa AAani alhawa","translation":{"id":312911,"text":"Fakat Rabb'inin huzurunda suçlu olmaktan korkarak, kendisini hevasından[1] uzak tutana,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26564,"text":"Tutku, kuruntu, bencil ve çıkarcı isteklere uymak. Sahip olduğu zenginlik, makam, ün, güç, bilgi vb. imkanları imtiyaza dönüştürerek üstünlük taslamak. Vahiy yerine din adamları sınıfının uydurduğu dine uymak.","number":1}]}},{"id":5753,"surah_id":79,"verse_number":41,"verse":"فَاِنَّ الْجَنَّةَ هِيَ الْمَأْوٰىۜ","verse_simplified":"فَإِنَّ الْجَنَّةَ هِيَ الْمَأْوَى","page":583,"juz_number":30,"transcription":"Fe innel cennete hiyel me'va.","transcription_en":"Fa-inna aljannata hiya alma/wa","translation":{"id":312912,"text":"Cennet onun için barınaktır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5754,"surah_id":79,"verse_number":42,"verse":"يَسْـَٔلُونَكَ عَنِ السَّاعَةِ اَيَّانَ مُرْسٰيهَاۜ","verse_simplified":"يَسْأَلُونَكَ عَنِ السَّاعَةِ أَيَّانَ مُرْسَاهَا","page":583,"juz_number":30,"transcription":"Yes'eluneke anis saati eyyane mursaha.","transcription_en":"Yas-aloonaka AAani assaAAatiayyana mursaha","translation":{"id":312913,"text":"Sana o Sa'at'ten[1] soruyorlar; ne zaman gelip çatacakmış diye.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26565,"text":"Kıyamet'in kopuş zamanından.","number":1}]}},{"id":5755,"surah_id":79,"verse_number":43,"verse":"ف۪يمَ اَنْتَ مِنْ ذِكْرٰيهَاۜ","verse_simplified":"فِيمَ أَنتَ مِن ذِكْرَاهَا","page":583,"juz_number":30,"transcription":"Fime ente min zikraha.","transcription_en":"Feema anta min thikraha","translation":{"id":312914,"text":"Sen onun hakkında ne bilebilirsin ki?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5756,"surah_id":79,"verse_number":44,"verse":"اِلٰى رَبِّكَ مُنْتَهٰيهَاۜ","verse_simplified":"إِلَى رَبِّكَ مُنتَهَاهَا","page":583,"juz_number":30,"transcription":"İla rabbike muntehaha.","transcription_en":"Ila rabbika muntahaha","translation":{"id":312915,"text":"Onun sonu Rabb'inedir.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26566,"text":"Onun ne zaman gelip çatacağını yalnızca Rabb'in bilir.","number":1}]}},{"id":5757,"surah_id":79,"verse_number":45,"verse":"اِنَّمَٓا اَنْتَ مُنْذِرُ مَنْ يَخْشٰيهَاۜ","verse_simplified":"إِنَّمَا أَنتَ مُنذِرُ مَن يَخْشَاهَا","page":583,"juz_number":30,"transcription":"İnnema ente munziru men yahşaha.","transcription_en":"Innama anta munthiru manyakhshaha","translation":{"id":312916,"text":"Sen ancak ona huşu duyanlar için bir uyarıcısın.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5758,"surah_id":79,"verse_number":46,"verse":"كَاَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُٓوا اِلَّا عَشِيَّةً اَوْ ضُحٰيهَا","verse_simplified":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوا إِلَّا عَشِيَّةً أَوْ ضُحَاهَا","page":583,"juz_number":30,"transcription":"Ke ennehum yevme yerevneha lem yelbesu illa aşiyyeten ev duhaha.","transcription_en":"Kaannahum yawma yarawnaha lamyalbathoo illa AAashiyyatan aw duhaha","translation":{"id":312917,"text":"Onlar onu[1] görecekleri gün, dünyada bir akşam veya kuşluğundan[2] başka kalmamış sanacaklar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26567,"text":"Kıyameti.","number":1},{"id":26568,"text":"Kuşluk vakti kadar.","number":2}]}}]}}