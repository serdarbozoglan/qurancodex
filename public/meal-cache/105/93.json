{"data":{"id":93,"name":"Duha","name_en":"Ad-Duhaa","name_original":"سورة الضحى","name_translation_tr":"Kuşluk Vakti","name_translation_en":"The Morning Hours","slug":"duha","verse_count":11,"page_number":595,"audio":{"mp3":"https://audio.acikkuran.com/tr/93.mp3","duration":53,"mp3_en":"https://audio.acikkuran.com/en/093.mp3","duration_en":53},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6080,"surah_id":93,"verse_number":1,"verse":"وَالضُّحٰىۙ","verse_simplified":"وَالضُّحَى","page":595,"juz_number":30,"transcription":"Ved duha.","transcription_en":"Wadduha","translation":{"id":313239,"text":"Duha[1] vaktine ant olsun.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26697,"text":"Kuşluk.","number":1}]}},{"id":6081,"surah_id":93,"verse_number":2,"verse":"وَالَّيْلِ اِذَا سَجٰىۙ","verse_simplified":"وَاللَّيْلِ إِذَا سَجَى","page":595,"juz_number":30,"transcription":"Vel leyli iza seca.","transcription_en":"Wallayli itha saja","translation":{"id":313240,"text":"Gecenin karanlıktaki dinginliğine,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6082,"surah_id":93,"verse_number":3,"verse":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىۜ","verse_simplified":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَى","page":595,"juz_number":30,"transcription":"Ma veddeake rabbuke ve ma kala.","transcription_en":"Ma waddaAAaka rabbuka wama qala","translation":{"id":313241,"text":"Rabb'in seni bırakmadı ve sana darılmadı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6083,"surah_id":93,"verse_number":4,"verse":"وَلَلْاٰخِرَةُ خَيْرٌ لَكَ مِنَ الْاُو۫لٰىۜ","verse_simplified":"وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَى","page":596,"juz_number":30,"transcription":"Ve lel ahıretu hayrun leke minel ula.","transcription_en":"Walal-akhiratu khayrun laka minaal-oola","translation":{"id":313242,"text":"Senin için gelecek, geçmişten hayırlı olacak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6084,"surah_id":93,"verse_number":5,"verse":"وَلَسَوْفَ يُعْط۪يكَ رَبُّكَ فَتَـرْضٰىۜ","verse_simplified":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَى","page":596,"juz_number":30,"transcription":"Ve le sevfe yu'tike rabbuke fe terda.","transcription_en":"Walasawfa yuAAteeka rabbuka fatarda","translation":{"id":313243,"text":"Yakında Rabb'in sana verecek, sen de hoşnut olacaksın.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6085,"surah_id":93,"verse_number":6,"verse":"اَلَمْ يَجِدْكَ يَت۪ـيـماً فَاٰوٰىۖ","verse_simplified":"أَلَمْ يَجِدْكَ يَتِيمًا فَآوَى","page":596,"juz_number":30,"transcription":"E lem yecidke yetimen fe ava.","transcription_en":"Alam yajidka yateeman faawa","translation":{"id":313244,"text":"Seni yetim bulup, barındırmadı mı?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6086,"surah_id":93,"verse_number":7,"verse":"وَوَجَدَكَ ضَٓالاًّ فَهَدٰىۖ","verse_simplified":"وَوَجَدَكَ ضَالًّا فَهَدَى","page":596,"juz_number":30,"transcription":"Ve vecedeke dallen fe heda.","transcription_en":"Wawajadaka dallan fahada","translation":{"id":313245,"text":"Seni şaşırmış bulup, doğru yolu göstermedi mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6087,"surah_id":93,"verse_number":8,"verse":"وَوَجَدَكَ عَٓائِلاً فَاَغْنٰىۜ","verse_simplified":"وَوَجَدَكَ عَائِلًا فَأَغْنَى","page":596,"juz_number":30,"transcription":"Ve vecedeke ailen fe agna.","transcription_en":"Wawajadaka AAa-ilan faaghna","translation":{"id":313246,"text":"Seni muhtaç durumda bulup ğına[1] etmedi mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26698,"text":"Çevirilerde ayete, \"Seni yoksul bulup, zenginleştirmedi mi?\" şeklinde anlam verilmektedir. Oysaki burada söz konusu olan servet zenginliği değil; \"ğına\" kelimesi ile kastedilen, ona verilen görevin, bir insan için en büyük zenginlik, en büyük nimet olduğudur.","number":1}]}},{"id":6088,"surah_id":93,"verse_number":9,"verse":"فَاَمَّا الْيَت۪يمَ فَلَا تَقْهَرْۜ","verse_simplified":"فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ","page":596,"juz_number":30,"transcription":"Fe emmel yetime fe la takher.","transcription_en":"Faamma alyateema fala taqhar","translation":{"id":313247,"text":"Öyleyse sakın yetimi[1] hor görme.[2]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26699,"text":"Kimsesizi.","number":1},{"id":26700,"text":"Güçsüzü zayıfı önemsiz görme.","number":2}]}},{"id":6089,"surah_id":93,"verse_number":10,"verse":"وَاَمَّا السَّٓائِلَ فَلَا تَنْهَرْۜ","verse_simplified":"وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ","page":596,"juz_number":30,"transcription":"Ve emmes saile fe la tenher.","transcription_en":"Waamma assa-ila falatanhar","translation":{"id":313248,"text":"Sakın isteyeni[1] geri çevirme.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26701,"text":"İstenilen şey somut olarak belirtilmemiş olmakla birlikte, bağlama bakıldığında; istenilen şeyin \"bilgi edinme, Hakk'ı öğrenme, korunup gözetilme olduğu\" anlaşılmaktadır. Bir sonraki ayetten de bu anlaşılmaktadır.","number":1}]}},{"id":6090,"surah_id":93,"verse_number":11,"verse":"وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","verse_simplified":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","page":596,"juz_number":30,"transcription":"Ve emma bi ni'meti rabbike fe haddis.","transcription_en":"Waamma biniAAmati rabbika fahaddith","translation":{"id":313249,"text":"Ve Rabb'inin nimetini[1] her fırsatta hadis et.[2]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26702,"text":"Gönderdiği vahyi.","number":1},{"id":26703,"text":"Anlat.","number":2}]}}]}}