ge":591,"juz_number":30,"transcription":"La yusminu ve la yugni min cu'.","transcription_en":"La yusminu wala yughnee minjooAA","translation":{"id":313133,"text":"O, beslemez ve açlığı gidermez.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5975,"surah_id":88,"verse_number":8,"verse":"وُجُوهٌ يَوْمَئِذٍ نَاعِمَةٌۙ","verse_simplified":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","page":591,"juz_number":30,"transcription":"Vucuhun yevmeizin naımeh.","transcription_en":"Wujoohun yawma-ithin naAAima","translation":{"id":313134,"text":"O Gün birtakım yüzler[1] nimetler içindedirler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26661,"text":"Kimseler.","number":1}]}},{"id":5976,"surah_id":88,"verse_number":9,"verse":"لِسَعْيِهَا رَاضِيَةٌۙ","verse_simplified":"لِسَعْيِهَا رَاضِيَةٌ","page":591,"juz_number":30,"transcription":"Li sa'yiha radiyeh.","transcription_en":"LisaAAyiha radiya","translation":{"id":313135,"text":"Yaptıklarından dolayı hoşnutturlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5977,"surah_id":88,"verse_number":10,"verse":"ف۪ي جَنَّةٍ عَالِيَةٍۙ","verse_simplified":"فِي جَنَّةٍ عَالِيَةٍ","page":591,"juz_number":30,"transcription":"Fi cennetin aliyeh.","transcription_en":"Fee jannatin AAaliya","translation":{"id":313136,"text":"Mükemmel bir bahçededirler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5978,"surah_id":88,"verse_number":11,"verse":"لَا تَسْمَعُ ف۪يهَا لَاغِيَةًۜ","verse_simplified":"لَّا تَسْمَعُ فِيهَا لَاغِيَةً","page":591,"juz_number":30,"transcription":"La tesmeu fiha lagıyeh.","transcription_en":"La tasmaAAu feeha laghiya","translation":{"id":313137,"text":"Orada boş söz duymazlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5979,"surah_id":88,"verse_number":12,"verse":"ف۪يهَا عَيْنٌ جَارِيَةٌۢ","verse_simplified":"فِيهَا عَيْنٌ جَارِيَةٌ","page":592,"juz_number":30,"transcription":"Fiha aynun cariyeh.","transcription_en":"Feeha AAaynun jariya","translation":{"id":313138,"text":"Orada devamlı akan bir pınar vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5980,"surah_id":88,"verse_number":13,"verse":"ف۪يهَا سُرُرٌ مَرْفُوعَةٌۙ","verse_simplified":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","page":592,"juz_number":30,"transcription":"Fiha sururun merfuah.","transcription_en":"Feeha sururun marfooAAa","translation":{"id":313139,"text":"Yükseklere kurulmuş divanlar,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5981,"surah_id":88,"verse_number":14,"verse":"وَاَكْوَابٌ مَوْضُوعَةٌۙ","verse_simplified":"وَأَكْوَابٌ مَّوْضُوعَةٌ","page":592,"juz_number":30,"transcription":"Ve ekvabun mevduah.","transcription_en":"Waakwabun mawdooAAa","translation":{"id":313140,"text":"İçime hazır içecekler,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5982,"surah_id":88,"verse_number":15,"verse":"وَنَمَارِقُ مَصْفُوفَةٌۙ","verse_simplified":"وَنَمَارِقُ مَصْفُوفَةٌ","page":592,"juz_number":30,"transcription":"Ve nemarıku masfufeh.","transcription_en":"Wanamariqu masfoofa","translation":{"id":313141,"text":"Sıra sıra yastıklar,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5983,"surah_id":88,"verse_number":16,"verse":"وَزَرَابِيُّ مَبْثُوثَةٌۜ","verse_simplified":"وَزَرَابِيُّ مَبْثُوثَةٌ","page":592,"juz_number":30,"transcription":"Ve zerabiyyu mebsuseh.","transcription_en":"Wazarabiyyu mabthootha","translation":{"id":313142,"text":"Serilmiş halılar vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5984,"surah_id":88,"verse_number":17,"verse":"اَفَلَا يَنْظُرُونَ اِلَى الْاِبِلِ كَيْفَ خُلِقَتْ۠","verse_simplified":"أَفَلَا يَنظُرُونَ إِلَى الْإِبِلِ كَيْفَ خُلِقَتْ","page":592,"juz_number":30,"transcription":"E fe la yanzurune ilel ibili keyfe hulikat.","transcription_en":"Afala yanthuroona ilaal-ibili kayfa khuliqat","translation":{"id":313143,"text":"Hiç mi deveye[1] bakmıyorlar, nasıl yaratılmış?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26662,"text":"Diğer bir okuyuşa göre \"bulutlara.\" \"İbil,\" deve demektir. Bu kelime \"ibbil\" olarak okunduğunda ise \"bulut\" anlamına gelmektedir.","number":1}]}},{"id":5985,"surah_id":88,"verse_number":18,"verse":"وَاِلَى السَّمَٓاءِ كَيْفَ رُفِعَتْ۠","verse_simplified":"وَإِلَى السَّمَاء كَيْفَ رُفِعَتْ","page":592,"juz_number":30,"transcription":"Ve iles semai keyfe rufiat.","transcription_en":"Wa-ila assama-i kayfarufiAAat","translation":{"id":313144,"text":"Ve gökyüzüne, nasıl yükseltilmiş?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5986,"surah_id":88,"verse_number":19,"verse":"وَاِلَى الْجِبَالِ كَيْفَ نُصِبَتْ۠","verse_simplified":"وَإِلَى الْجِبَالِ كَيْفَ نُصِبَتْ","page":592,"juz_number":30,"transcription":"Ve ilel cibali keyfe nusıbet.","transcription_en":"Wa-ila aljibali kayfa nusibat","translation":{"id":313145,"text":"Ve dağlara, nasıl dikilmişler?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5987,"surah_id":88,"verse_number":20,"verse":"وَاِلَى الْاَرْضِ كَيْفَ سُطِحَتْ۠","verse_simplified":"وَإِلَى الْأَرْضِ كَيْفَ سُطِحَتْ","page":592,"juz_number":30,"transcription":"Ve ilel ardı keyfe sutıhat.","transcription_en":"Wa-ila al-ardi kayfa sutihat","translation":{"id":313146,"text":"Ve yeryüzüne, nasıl yayılıp döşenmiş?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5988,"surah_id":88,"verse_number":21,"verse":"فَذَكِّرْ اِنَّـمَٓا اَنْتَ مُذَكِّرٌۜ","verse_simplified":"فَذَكِّرْ إِنَّمَا أَنتَ مُذَكِّرٌ","page":592,"juz_number":30,"transcription":"Fezekkir innema ente muzekkir.","transcription_en":"Fathakkir innama anta muthakkir","translation":{"id":313147,"text":"Öğüt ver; sen yalnızca öğüt vericisin.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5989,"surah_id":88,"verse_number":22,"verse":"لَسْتَ عَلَيْهِمْ بِمُصَيْطِرٍۙ","verse_simplified":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","page":592,"juz_number":30,"transcription":"Leste aleyhim bi musaytır.","transcription_en":"Lasta AAalayhim bimusaytir","translation":{"id":313148,"text":"Kimseyi zorla inandıracak değilsin.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5990,"surah_id":88,"verse_number":23,"verse":"اِلَّا مَنْ تَوَلّٰى وَكَفَرَۙ","verse_simplified":"إِلَّا مَن تَوَلَّى وَكَفَرَ","page":592,"juz_number":30,"transcription":"İlla men tevella ve kefer.","transcription_en":"Illa man tawalla wakafar","translation":{"id":313149,"text":"Ancak kim yüz çevirir ve kafir olursa,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5991,"surah_id":88,"verse_number":24,"verse":"فَيُعَذِّبُهُ اللّٰهُ الْعَذَابَ الْاَكْبَرَۜ","verse_simplified":"فَيُعَذِّبُهُ اللَّهُ الْعَذَابَ الْأَكْبَرَ","page":592,"juz_number":30,"transcription":"Fe yuazzibuhullahul azabel ekber.","transcription_en":"FayuAAaththibuhu Allahu alAAathabaal-akbar","translation":{"id":313150,"text":"Allah, ona en büyük azapla azap eder.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5992,"surah_id":88,"verse_number":25,"verse":"اِنَّ اِلَيْنَٓا اِيَابَهُمْۙ","verse_simplified":"إِنَّ إِلَيْنَا إِيَابَهُمْ","page":592,"juz_number":30,"tra