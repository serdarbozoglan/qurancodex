{"data":{"id":88,"name":"Gaşiye","name_en":"Al-Ghashiyah","name_original":"سورة الغاشية","name_translation_tr":"Kuşatan","name_translation_en":"The Overwhelming","slug":"gasiye","verse_count":26,"page_number":591,"audio":{"mp3":"https://audio.acikkuran.com/tr/88.mp3","duration":98,"mp3_en":"https://audio.acikkuran.com/en/088.mp3","duration_en":97},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5968,"surah_id":88,"verse_number":1,"verse":"هَلْ اَتٰيكَ حَد۪يثُ الْغَاشِيَةِۜ","verse_simplified":"هَلْ أَتَاكَ حَدِيثُ الْغَاشِيَةِ","page":591,"juz_number":30,"transcription":"Hel etake hadisul gaşiyeh.","transcription_en":"Hal ataka hadeethu alghashiyat","translation":{"id":313127,"text":"Ğaşiyenin[1] hadisi[2] sana geldi mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26656,"text":"Dehşeti her şeyi kaplayıp kuşatacak olanın.","number":1},{"id":26657,"text":"Haberi.","number":2}]}},{"id":5969,"surah_id":88,"verse_number":2,"verse":"وُجُوهٌ يَوْمَئِذٍ خَاشِعَةٌۙ","verse_simplified":"وُجُوهٌ يَوْمَئِذٍ خَاشِعَةٌ","page":591,"juz_number":30,"transcription":"Vucuhun yevmeizin haşiah.","transcription_en":"Wujoohun yawma-ithin khashiAAa","translation":{"id":313128,"text":"O Gün[1] birtakım yüzler öne düşüktür;[2]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26658,"text":"Hesap sorma günü, yalnızca Allah'ın belirlediği ilke ve kuralların geçerli olduğu gün.","number":1},{"id":26659,"text":"Müşrikler ve Kafirler dünyada göst