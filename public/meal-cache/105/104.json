{"data":{"id":104,"name":"Hümeze","name_en":"Al-Humazah","name_original":"سورة الهمزة","name_translation_tr":"Dedikoducu","name_translation_en":"The Traducer","slug":"humeze","verse_count":9,"page_number":601,"audio":{"mp3":"https://audio.acikkuran.com/tr/104.mp3","duration":49,"mp3_en":"https://audio.acikkuran.com/en/104.mp3","duration_en":39},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6180,"surah_id":104,"verse_number":1,"verse":"وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍۨۙ","verse_simplified":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","page":601,"juz_number":30,"transcription":"Veylun li kulli humezetin lumezeh.","transcription_en":"Waylun likulli humazatin lumaza","translation":{"id":313339,"text":"Arkadan çekiştirenlerin, kaş göz hareketiyle alay edenlerin vay haline![1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26754,"text":"Nebi'ye ve davetine karşı küçümseyici tavır takınan, onu alaya alanların vay haline.","number":1}]}},{"id":6181,"surah_id":104,"verse_number":2,"verse":"اَلَّذ۪ي جَمَعَ مَالاً وَعَدَّدَهُۙ","verse_simplified":"الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ","page":601,"juz_number":30,"transcription":"Ellezi cemea malen ve addedeh.","transcription_en":"Allathee jamaAAa malanwaAAaddadah","translation":{"id":313340,"text":"O ki malı toplayıp, onun hesabını yapıp durur.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6182,"surah_id":104,"verse_number":3,"verse":"يَحْسَبُ اَنَّ مَالَهُٓ اَخْلَدَهُۚ","verse_simplified":"يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ","page":601,"juz_number":30,"transcription":"Yahsebu enne malehu ahledeh.","transcription_en":"Yahsabu anna malahu akhladah","translation":{"id":313341,"text":"Malın kendisini sonsuza dek yaşatacağını sanıyor.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6183,"surah_id":104,"verse_number":4,"verse":"كَلَّا لَيُنْبَذَنَّ فِي الْحُطَمَةِۘ","verse_simplified":"كَلَّا لَيُنبَذَنَّ فِي الْحُطَمَةِ","page":601,"juz_number":30,"transcription":"Kella le yunbezenne fil hutameh.","transcription_en":"Kalla layunbathanna fee alhutama","translation":{"id":313342,"text":"Hayır, kesinlikle bildiği gibi değil, kesinlikle o Hutame'ye atılacak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6184,"surah_id":104,"verse_number":5,"verse":"وَمَٓا اَدْرٰيكَ مَا الْحُطَمَةُۜ","verse_simplified":"وَمَا أَدْرَاكَ مَا الْحُطَمَةُ","page":601,"juz_number":30,"transcription":"Ve ma edrake mel hutameh.","transcription_en":"Wama adraka ma alhutama","translation":{"id":313343,"text":"Hutame'nin ne olduğunu sen nereden bileceksin?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6185,"surah_id":104,"verse_number":6,"verse":"نَارُ اللّٰهِ الْمُوقَدَةُۙ","verse_simplified":"نَارُ اللَّهِ الْمُوقَدَةُ","page":601,"juz_number":30,"transcription":"Narullahil mukadeh.","transcription_en":"Naru Allahi almooqada","translation":{"id":313344,"text":"Allah'ın tutuşturulmuş ateşidir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6186,"surah_id":104,"verse_number":7,"verse":"اَلَّت۪ي تَطَّلِعُ عَلَى الْاَفْـِٔدَةِۜ","verse_simplified":"الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ","page":601,"juz_number":30,"transcription":"Elleti tettaliu alel ef'ideh.","transcription_en":"Allatee tattaliAAu AAalaal-af-ida","translation":{"id":313345,"text":"Yüreklere işleyen bir ateş.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6187,"surah_id":104,"verse_number":8,"verse":"اِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌۙ","verse_simplified":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","page":601,"juz_number":30,"transcription":"İnneha aleyhim mu'sadeh.","transcription_en":"lnnaha AAalayhim mu/sada","translation":{"id":313346,"text":"Kuşkusuz o, onların üzerine kapatılmıştır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6188,"surah_id":104,"verse_number":9,"verse":"ف۪ي عَمَدٍ مُمَدَّدَةٍ","verse_simplified":"فِي عَمَدٍ مُّمَدَّدَةٍ","page":601,"juz_number":30,"transcription":"Fi amedin mumeddedeh.","transcription_en":"Fee AAamadin mumaddada","translation":{"id":313347,"text":"Uzatılmış sütunlar arasında.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}