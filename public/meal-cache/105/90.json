{"data":{"id":90,"name":"Beled","name_en":"Al-Balad","name_original":"سورة البلد","name_translation_tr":"Şehir","name_translation_en":"The City","slug":"beled","verse_count":20,"page_number":593,"audio":{"mp3":"https://audio.acikkuran.com/tr/90.mp3","duration":80,"mp3_en":"https://audio.acikkuran.com/en/090.mp3","duration_en":84},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6024,"surah_id":90,"verse_number":1,"verse":"لَٓا اُقْسِمُ بِهٰذَا الْبَلَدِۙ","verse_simplified":"لَا أُقْسِمُ بِهَذَا الْبَلَدِ","page":593,"juz_number":30,"transcription":"La uksimu bi hazel beled.","transcription_en":"La oqsimu bihatha albalad","translation":{"id":313183,"text":"Hayır! Bu beldeye yemin ederim!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6025,"surah_id":90,"verse_number":2,"verse":"وَاَنْتَ حِلٌّ بِهٰذَا الْبَلَدِۙ","verse_simplified":"وَأَنتَ حِلٌّ بِهَذَا الْبَلَدِ","page":593,"juz_number":30,"transcription":"Ve ente hıllun bi hazel beled.","transcription_en":"Waanta hillun bihatha albalad","translation":{"id":313184,"text":"Senin de içinde yaşadığın beldeye,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6026,"surah_id":90,"verse_number":3,"verse":"وَوَالِدٍ وَمَا وَلَدَۙ","verse_simplified":"وَوَالِدٍ وَمَا وَلَدَ","page":593,"juz_number":30,"transcription":"Ve validin ve ma veled.","transcription_en":"Wawalidin wama walad","translation":{"id":313185,"text":"Ant olsun doğurana ve doğurduğuna!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6027,"surah_id":90,"verse_number":4,"verse":"لَقَدْ خَلَقْنَا الْاِنْسَانَ ف۪ي كَبَدٍۜ","verse_simplified":"لَقَدْ خَلَقْنَا الْإِنسَانَ فِي كَبَدٍ","page":593,"juz_number":30,"transcription":"Lekad halaknel insane fi kebed.","transcription_en":"Laqad khalaqna al-insana feekabad","translation":{"id":313186,"text":"Biz insanı gerçekten zorluk arasında yarattık.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6028,"surah_id":90,"verse_number":5,"verse":"اَيَحْسَبُ اَنْ لَنْ يَقْدِرَ عَلَيْهِ اَحَدٌۢ","verse_simplified":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ","page":593,"juz_number":30,"transcription":"E yahsebu en len yakdira aleyhi ehad.","transcription_en":"Ayahsabu an lan yaqdira AAalayhi ahad","translation":{"id":313187,"text":"Kendisine hiç kimsenin güç yetiremeyeceğini mi sanıyor?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6029,"surah_id":90,"verse_number":6,"verse":"يَقُولُ اَهْلَكْتُ مَالاً لُبَداًۜ","verse_simplified":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا","page":593,"juz_number":30,"transcription":"Yekulu ehlektu malen lubeda.","transcription_en":"Yaqoolu ahlaktu malan lubada","translation":{"id":313188,"text":"\"Yığınlarca mal harcadım.\" diyor.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6030,"surah_id":90,"verse_number":7,"verse":"اَيَحْسَبُ اَنْ لَمْ يَرَهُٓ  اَحَدٌۜ","verse_simplified":"أَيَحْسَبُ أَن لَّمْ يَرَهُ أَحَدٌ","page":593,"juz_number":30,"transcription":"E yahsebu en lem yerahu ehad.","transcription_en":"Ayahsabu an lam yarahu ahad","translation":{"id":313189,"text":"Kendisini hiç kimsenin görmediğini mi sanıyor?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6031,"surah_id":90,"verse_number":8,"verse":"اَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِۙ","verse_simplified":"أَلَمْ نَجْعَل لَّهُ عَيْنَيْنِ","page":594,"juz_number":30,"transcription":"E lem nec'al lehu ayneyn.","transcription_en":"Alam najAAal lahu AAaynayn","translation":{"id":313190,"text":"Ona iki gözü Biz vermedik mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6032,"surah_id":90,"verse_number":9,"verse":"وَلِسَاناً وَشَفَتَيْنِۙ","verse_simplified":"وَلِسَانًا وَشَفَتَيْنِ","page":594,"juz_number":30,"transcription":"Ve lisanen ve şefeteyn.","transcription_en":"Walisanan washafatayn","translation":{"id":313191,"text":"Bir dil ve iki dudak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6033,"surah_id":90,"verse_number":10,"verse":"وَهَدَيْنَاهُ النَّجْدَيْنِۚ","verse_simplified":"وَهَدَيْنَاهُ النَّجْدَيْنِ","page":594,"juz_number":30,"transcription":"Ve hedeynahun necdeyn.","transcription_en":"Wahadaynahu annajdayn","translation":{"id":313192,"text":"Ona iki yol[1] gösterdik.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26675,"text":"Doğru ve eğri, Hakk ve Batıl, İman ve Küfür, iyilik ve kötülük…","number":1}]}},{"id":6034,"surah_id":90,"verse_number":11,"verse":"فَلَا اقْتَحَمَ الْعَقَبَةَۘ","verse_simplified":"فَلَا اقْتَحَمَ الْعَقَبَةَ","page":594,"juz_number":30,"transcription":"Fe laktehamel akabete.","transcription_en":"Fala iqtahama alAAaqaba","translation":{"id":313193,"text":"Ne var ki o, sarp yokuşu aşmayı göze alamadı.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26676,"text":"Köleye özgürlüğünü vermedi. Tutku ve kuruntuların isteklerine karşı koyamadı. Hakk'ı, hayrı, adaleti tercih etmek işine gelmedi.","number":1}]}},{"id":6035,"surah_id":90,"verse_number":12,"verse":"وَمَٓا اَدْرٰيكَ مَا الْعَقَبَةُۜ","verse_simplified":"وَمَا أَدْرَاكَ مَا الْعَقَبَةُ","page":594,"juz_number":30,"transcription":"Ve ma edrake mel akabeh.","transcription_en":"Wama adraka maalAAaqaba","translation":{"id":313194,"text":"Bilir misin nedir sarp yokuş?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6036,"surah_id":90,"verse_number":13,"verse":"فَكُّ رَقَبَةٍۙ","verse_simplified":"فَكُّ رَقَبَةٍ","page":594,"juz_number":30,"transcription":"Fekku rekabetin.","transcription_en":"Fakku raqaba","translation":{"id":313195,"text":"Boynu çözmektir,[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26677,"text":"Köleyi özgürleştirmektir. Rekabe özgürlüğüne kavuşmak isteyen köle demektir. Rekabe, boyun demektir; özgürlüğü kısıtlı olan kimseler için kullanılmaktadır. Kelime anlamı olarak; gözetlenmek, gözetlemek, korumak, korunmak anlamlarına gelmektedir. Vahiy, köleliği ilk yıllarında gündemine almış ve tamamıyla kaldırmak, yok etmek sürecini başlatmıştır. Köle edinmenin tek yolu olan savaş esirleriydi. 47:4. ayetiyle bu yol tamamıyla kapatılarak bu süreç tamamlanmış kölelik sona erdirilmiştir.","number":1}]}},{"id":6037,"surah_id":90,"verse_number":14,"verse":"اَوْ اِطْعَامٌ ف۪ي يَوْمٍ ذ۪ي مَسْغَبَةٍۙ","verse_simplified":"أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ","page":594,"juz_number":30,"transcription":"Ev ıt'amun fi yevmin zi mesgabeh.","transcription_en":"Aw itAAamun fee yawmin theemasghaba","translation":{"id":313196,"text":"Veya darlık ve yoklukta doyurmaktır;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6038,"surah_id":90,"verse_number":15,"verse":"يَت۪يماً ذَا مَقْرَبَةٍۙ","verse_simplified":"يَتِيمًا ذَا مَقْرَبَةٍ","page":594,"juz_number":30,"transcription":"Yetimen za makrabeh.","transcription_en":"Yateeman tha maqraba","translation":{"id":313197,"text":"Yakınlık sahibi olan yetimi,[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26678,"text":"Yakınında, çevrende bulunan sahipsiz, kimsesiz kalmışları.","number":1}]}},{"id":6039,"surah_id":90,"verse_number":16,"verse":"اَوْ مِسْك۪يناً ذَا مَتْرَبَةٍۜ","verse_simplified":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","page":594,"juz_number":30,"transcription":"Ev miskinen za metrabeh.","transcription_en":"Aw miskeenan tha matraba","translation":{"id":313198,"text":"Veya hiçbir şeyi olmayan miskini,[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26679,"text":"Çalışacak gücü ve işi olmayan, yerlerde sürünen yoksul. Hiçbir şeyi olmayan.","number":1}]}},{"id":6040,"surah_id":90,"verse_number":17,"verse":"ثُمَّ كَانَ مِنَ الَّذ۪ينَ اٰمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِۜ","verse_simplified":"ثُمَّ كَانَ مِنَ الَّذِينَ آمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ","page":594,"juz_number":30,"transcription":"Summe kane minellezine amenu ve tevasav bis sabri ve tevasav bil merhame.","transcription_en":"Thumma kana mina allatheena amanoowatawasaw bissabri watawasaw bilmarhama","translation":{"id":313199,"text":"Sonra birbirlerine sabrı[1] ve merhameti tavsiye eden iman edenlerden olmaktır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26680,"text":"Direnmeyi, zorluklara göğüs germeyi, yılgınlık göstermemeyi.","number":1}]}},{"id":6041,"surah_id":90,"verse_number":18,"verse":"اُو۬لٰٓئِكَ اَصْحَابُ الْمَيْمَنَةِۜ","verse_simplified":"أُوْلَئِكَ أَصْحَابُ الْمَيْمَنَةِ","page":594,"juz_number":30,"transcription":"Ulaike ashabul meymeneh.","transcription_en":"Ola-ika as-habualmaymana","translation":{"id":313200,"text":"İşte onlar, Ashab-ı Meymene'dir.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26681,"text":"Meymene, kelime olarak \"sağ el\" veya \"uğurlu, bereketli\" anlamındadır. \"Amel defterleri sağdan verilenler\", veya \"sağın sahibi,\" \"sağın taraftarları\" şeklinde yanlış anlam verilen \"Ashabı Meymene;\" Arapça'da bir deyim olup, bahtı iyi olan, bereketli, yüksek makam, güçlü, çok değerli, şerefli, onurlu ve önemli kimseler için kullanılmaktadır. Keza Türkçe'de de birisine \"bu benim sağ kolumdur\" dendiği zaman, ona verilen değer gösterilmiş olunmaktadır.","number":1}]}},{"id":6042,"surah_id":90,"verse_number":19,"verse":"وَالَّذ۪ينَ كَفَرُوا بِاٰيَاتِنَا هُمْ اَصْحَابُ الْمَشْـَٔمَةِۜ","verse_simplified":"وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ","page":594,"juz_number":30,"transcription":"Vellezine keferu bi ayatina hum ashabul meş'emeh.","transcription_en":"Wallatheena kafaroo bi-ayatinahum as-habu almash-ama","translation":{"id":313201,"text":"Ayetlerimizi küfredenler Ashab-ı Meşeme'dir.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26682,"text":"Kelime olarak, \"uğursuzluk, talihsizlik demektir. \"Sol el\" anlamı da bulunmaktadır. \"Amel defterleri solundan verilenler\" veya \"solun Ashabı,\" \"solun taraftarları\" şeklinde yanlış anlam verilen Ashabı Meş'eme; Arapça'da deyim olarak, zillet içerisinde, aşağılık, değersiz, onursuz kimseler demektir.","number":1}]}},{"id":6043,"surah_id":90,"verse_number":20,"verse":"عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ","verse_simplified":"عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌ","page":594,"juz_number":30,"transcription":"Aleyhim narun mu'sadeh.","transcription_en":"AAalayhim narun mu/sada","translation":{"id":313202,"text":"Onlara, üzerlerine kapıları kapatılmış bir ateş vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}