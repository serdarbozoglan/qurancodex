"author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5649,"surah_id":77,"verse_number":27,"verse":"وَجَعَلْنَا ف۪يهَا رَوَاسِيَ شَامِخَاتٍ وَاَسْقَيْنَاكُمْ مَٓاءً فُرَاتاًۜ","verse_simplified":"وَجَعَلْنَا فِيهَا رَوَاسِيَ شَامِخَاتٍ وَأَسْقَيْنَاكُم مَّاء فُرَاتًا","page":580,"juz_number":29,"transcription":"Ve cealna fiha revasiye şamihatin ve eskaynakum maen furata.","transcription_en":"WajaAAalna feeha rawasiyashamikhatin waasqaynakum maan furata","translation":{"id":312808,"text":"Orada oturaklı ağır baskılar yaptık. Size tatlı su içirdik.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5650,"surah_id":77,"verse_number":28,"verse":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ","verse_simplified":"وَيْلٌ يوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz_number":29,"transcription":"Veylun yevmeizin lil mukezzibin.","transcription_en":"Waylun yawma-ithin lilmukaththibeen","translation":{"id":312809,"text":"O Gün yalanlayanların vay haline!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5651,"surah_id":77,"verse_number":29,"verse":"اِنْطَلِقُٓوا اِلٰى مَا كُنْتُمْ بِه۪ تُكَذِّبُونَۚ","verse_simplified":"انطَلِقُوا إِلَى مَا كُنتُم بِهِ تُكَذِّبُونَ","page":580,"juz_number":29,"transcription":"İntaliku ila ma kuntum bihi tukezzibun.","transcription_en":"Intaliqoo ila ma kuntumbihi tukaththiboon","translation":{"id":312810,"text":"Haydi, kendisini yalanlamış olduğunuz şeye gidin bakalım!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5652,"surah_id":77,"verse_number":30,"verse":"اِنْطَلِقُٓوا اِلٰى ظِلٍّ ذ۪ي ثَلٰثِ شُعَبٍۙ","verse_simplified":"انطَلِقُوا إِلَى ظِلٍّ ذِي ثَلَاثِ شُعَبٍ","page":580,"juz_number":29,"transcription":"İntaliku ila zıllin zi selasi şuab.","transcription_en":"Intaliqoo ila thillinthee thalathi shuAAab","translation":{"id":312811,"text":"Üç çatal[1] sahibi gölgeye gidin;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26545,"text":"Üç kol, üç bölüm.","number":1}]}},{"id":5653,"surah_id":77,"verse_number":31,"verse":"لَا ظَل۪يلٍ وَلَا يُغْن۪ي مِنَ اللَّهَبِۜ","verse_simplified":"لَا ظَلِيلٍ وَلَا يُغْنِي مِنَ اللَّهَبِ","page":580,"juz_number":29,"transcription":"La zalilin ve la yugni minel leheb.","transcription_en":"La thaleelin walayughnee mina allahab","translation":{"id":312812,"text":"Gölge yapmayan ve alevden de korumayan.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5654,"surah_id":77,"verse_number":32,"verse":"اِنَّهَا تَرْم۪ي بِشَرَرٍ كَالْقَصْرِۚ","verse_simplified":"إِنَّهَا تَرْمِي بِشَرَرٍ كَالْقَصْرِ","page":580,"juz_number":29,"transcription":"İnneha termi bi şerarin kel kasr.","transcription_en":"Innaha tarmee bishararin kalqasr","translation":{"id":312813,"text":"O, kocaman kütükler gibi kıvılcımlar saçar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5655,"surah_id":77,"verse_number":33,"verse":"كَاَنَّهُ جِمَالَتٌ صُفْرٌۜ","verse_simplified":"كَأَنَّهُ جِمَالَتٌ صُفْرٌ","page":580,"juz_number":29,"transcription":"Ke ennehu cimaletun sufr.","transcription_en":"Kaannahu jimalatun sufr","translation":{"id":312814,"text":"Sanki o sarı deve sürüsüdür.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5656,"surah_id":77,"verse_number":34,"verse":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ","verse_simplified":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz_number":29,"transcription":"Veylun yevmeizin lil mukezzibin.","transcription_en":"Waylun yawma-ithin lilmukaththibeen","translation":{"id":312815,"text":"O Gün, yalanlayanların vay haline!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5657,"surah_id":77,"verse_number":35,"verse":"هٰذَا يَوْمُ لَا يَنْطِقُونَۙ","verse_simplified":"هَذَا يَوْمُ لَا يَنطِقُونَ","page":580,"juz_number":29,"transcription":"Haza yevmu la yentıkun.","transcription_en":"Hatha yawmu la yantiqoon","translation":{"id":312816,"text":"Bu, konuşamayacakları gündür.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5658,"surah_id":77,"verse_number":36,"verse":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","verse_simplified":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ","page":580,"juz_number":29,"transcription":"Ve la yu'zenu lehum fe ya'tezirun.","transcription_en":"Wala yu/thanu lahum fayaAAtathiroon","translation":{"id":312817,"text":"Onlara izin verilmez ki, özür dilesinler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5659,"surah_id":77,"verse_number":37,"verse":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ","verse_simplified":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz_number":29,"transcription":"Veylun yevmeizin lil mukezzibin.","transcription_en":"Waylun yawma-ithin lilmukaththibeen","translation":{"id":312818,"text":"O Gün, yalanlayanların vay haline!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5660,"surah_id":77,"verse_number":38,"verse":"هٰذَا يَوْمُ الْفَصْلِۚ جَمَعْنَاكُمْ وَالْاَوَّل۪ينَ","verse_simplified":"هَذَا يَوْمُ الْفَصْلِ جَمَعْنَاكُمْ وَالْأَوَّلِينَ","page":580,"juz_number":29,"transcription":"Haza yevmul fasl, cema'nakum vel evvelin.","transcription_en":"Hatha yawmu alfasli jamaAAnakumwal-awwaleen","translation":{"id":312819,"text":"Bu, sizi ve öncekileri topladığımız, ayırma günüdür.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26546,"text":"Yargılama günü. Suçluyu suçsuzu belli etme.","number":1}]}},{"id":5661,"surah_id":77,"verse_number":39,"verse":"فَاِنْ كَانَ لَكُمْ كَيْدٌ فَك۪يدُونِ","verse_simplified":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ","page":580,"juz_number":29,"transcription":"Fe in kane lekum keydun fe kidun.","transcription_en":"Fa-in kana lakum kaydun fakeedoon","translation":{"id":312820,"text":"Haydi! Eğer kurtulmak için bir planınız varsa, Bana karşı hemen planınızı uygulayın!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5662,"surah_id":77,"verse_number":40,"verse":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ۟","verse_simplified":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz_number":29,"transcription":"Veylun yevmeizin lil mukezzibin.","transcription_en":"Waylun yawma-ithin lilmukaththibeen","translation":{"id":312821,"text":"O Gün, yalanlayanların vay haline!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5663,"surah_id":77,"verse_number":41,"verse":"اِنَّ الْمُتَّق۪ينَ ف۪ي ظِلَالٍ وَعُيُونٍۙ","verse_simplified":"إِنَّ الْمُتَّقِينَ فِي ظِلَالٍ وَعُيُونٍ","page":580,"juz_number":29,"transcription":"İnnel muttekine fi zılalin ve uyun.","transcription_en":"Inna almuttaqeena fee thilalinwaAAuyoon","translation":{"id":312822,"text":"Takva[1] sahipleri gölgelerde ve pınar başlarındadırlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26547,"text":"Takva, korunmak demektir. Allah'ın buyruklarına içtenlikle uyarak fucur, günah, kötü, zararlı ve tehlikeli şeylere karşı kendisini korumak ve güvene almaktır. Takva, kelime anlamı olarak zarar verecek şey ile korunacak şey arasına konan engel demektir. Muttaki: Takva sahibi olan. Takva \"Fucur\"un karşıtıdır (38:28; 91:8). Facir, fütursuzca günaha dalan, Hakk'tan Batıl'a sapan kimse demektir.","number":1}]}},{"id":5664,"surah_id":77,"verse_number":42,"verse":"وَفَوَاكِهَ مِمَّا يَشْتَهُونَۜ","verse_simplified":"وَفَوَاكِهَ مِمَّا يَشْتَهُونَ","page":580,"juz_number":29,"transcription":"Ve fevakihe mimma yeştehun.","transcription_en":"Wafawakiha mimma yashtahoon","translation":{"id":312823,"text":"Ve canlarının çektiği meyveler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5665,"surah_id":77,"verse_number":43,"verse":"كُلُوا وَاشْرَبُوا هَن۪ٓيـٔاً بِمَا كُنْتُمْ تَعْمَلُونَ","verse_simplified":"كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنتُمْ تَعْمَلُونَ","page":580,"juz_number":29,"transcription":"Kulu veşrebu henien bima kuntum ta'melun.","transcription_en":"Kuloo washraboo hanee-an bimakuntum taAAmaloon","translation":{"id":312824,"text":"Yaptıklarınıza karşılık afiyetle yiyin ve için.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5666,"surah_id":77,"verse_number":44,"verse":"اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِن۪ينَ","verse_simplified":"إِنَّا كَذَلِكَ نَجْزِي الْمُحْسِنينَ","page":580,"juz_number":29,"transcription":"İnna kezalike neczil muhsinin.","transcription_en":"Inna kathalika najzee almuhsineen","translation":{"id":312825,"text":"İyi olanları işte böyle ödüllendiririz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5667,"surah_id":77,"verse_number":45,"verse":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ","verse_simplified":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz_number":29,"transcription":"Veylun yevmeizin lil mukezzibin.","transcription_en":"Waylun yawma-ithin lilmukaththibeen","translation":{"id":312826,"text":"O Gün, yalanlayanların vay haline!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5668,"surah_id":77,"verse_number":46,"verse":"كُلُوا وَتَمَتَّعُوا قَل۪يلاً اِنَّكُمْ مُجْرِمُونَ","verse_simplified":"كُلُوا وَتَمَتَّعُوا قَلِيلًا إِنَّكُم مُّجْرِمُونَ","page":580,"juz_number":29,"transcription":"Kulu ve temetteu kalilen innekum mucrimun.","transcription_en":"Kuloo watamattaAAoo qaleelan innakummujrimoon","translation":{"id":312827,"text":"Yiyin ve yararlanın biraz. Siz suçlularsınız.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26548,"text":"Ey Müşrikler ve Kafirler, dünya nimetlerinden yararlanın bakalım!","number":1}]}},{"id":5669,"surah_id":77,"verse_number":47,"verse":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ","verse_simplified":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz_number":29,"transcription":"Veylun yevmeizin lil mukezzibin.","transcription_en":"Waylun yawma-ithin lilmukaththibeen","translation":{"id":312828,"text":"O Gün, yalanlayanların vay haline!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5670,"surah_id":77,"verse_number":48,"verse":"وَاِذَا ق۪يلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ","verse_simplified":"وَإِذَا قِيلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ","page":580,"juz_number":29,"transcription":"Ve iza kile lehumurkeu la yerkeun.","transcription_en":"Wa-itha qeela lahumu irkaAAoo layarkaAAoon","translation":{"id":312829,"text":"Onlara, \"Ruku[1] edin.\" denildiği zaman ruku etmezler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26549,"text":"Şirk koşmaksızın Allah'a itaat etmek, emrine amade olmak, değerini takdir etmek, yüceliğini, üstünlüğünü kabul etmek ve saygı göstermek. İçtenlikle boyun eğmek. Cahiliye Arapları puta tapmayıp yalnızca Allah'a tapanlara \"rakea ilellah;\" Allah'a ruku etti, derlerdi. Kur'an'da geçen ruku kelimeleri ile kast edilen şey namaz kılarken yapılan ve adına \"ruku\" denilen hareket değildir. Ancak namazdaki ruku ile amaçlanan şey de Allah'a bağlılık ve içtenliktir.","number":1}]}},{"id":5671,"surah_id":77,"verse_number":49,"verse":"وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ","verse_simplified":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","page":580,"juz_number":29,"transcription":"Veylun yevmeizin lil mukezzibin.","transcription_en":"Waylun yawma-ithin lilmukaththibeen","translation":{"id":312830,"text":"O Gün, yalanlayanların vay haline!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5672,"surah_id":77,"verse_number":50,"verse":"فَبِاَيِّ حَد۪يثٍ بَعْدَهُ يُؤْمِنُونَ","verse_simplified":"فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ","page":580,"juz_number":29,"transcription":"Fe bi eyyi hadisin ba'dehu yu'minun.","transcription_en":"Fabi-ayyi hadeethin baAAdahuyu/minoon","translation":{"id":312831,"text":"Artık bundan başka hangi hadise[1] inanacaklar?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26550,"text":"Kur'an'a inanmadıktan sonra hangi kitaba inanacaklar?","number":1}]}}]}}