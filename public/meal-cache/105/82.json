{"data":{"id":82,"name":"İnfitar","name_en":"Al-Infitar","name_original":"سورة الإنفطار","name_translation_tr":"Yarılma","name_translation_en":"The Cleaving","slug":"infitar","verse_count":19,"page_number":586,"audio":{"mp3":"https://audio.acikkuran.com/tr/82.mp3","duration":80,"mp3_en":"https://audio.acikkuran.com/en/082.mp3","duration_en":93},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5830,"surah_id":82,"verse_number":1,"verse":"اِذَا السَّمَٓاءُ انْفَطَرَتْۙ","verse_simplified":"إِذَا السَّمَاء انفَطَرَتْ","page":586,"juz_number":30,"transcription":"İzes semaunfetaret.","transcription_en":"Itha assamao infatarat","translation":{"id":312989,"text":"Göğün yasaları yeniden belirlendiği zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5831,"surah_id":82,"verse_number":2,"verse":"وَاِذَا الْـكَوَاكِبُ انْتَثَرَتْۙ","verse_simplified":"وَإِذَا الْكَوَاكِبُ انتَثَرَتْ","page":586,"juz_number":30,"transcription":"Ve izel kevakibunteseret.","transcription_en":"Wa-itha alkawakibu intatharat","translation":{"id":312990,"text":"Yıldızlar dağıldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5832,"surah_id":82,"verse_number":3,"verse":"وَاِذَا الْبِحَارُ فُجِّرَتْۙ","verse_simplified":"وَإِذَا الْبِحَارُ فُجِّرَتْ","page":586,"juz_number":30,"transcription":"Ve izel biharu fucciret.","transcription_en":"Wa-itha albiharu fujjirat","translation":{"id":312991,"text":"Denizler kabarıp taştığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5833,"surah_id":82,"verse_number":4,"verse":"وَاِذَا الْقُبُورُ بُعْثِرَتْۙ","verse_simplified":"وَإِذَا الْقُبُورُ بُعْثِرَتْ","page":586,"juz_number":30,"transcription":"Ve izel kuburu bu'siret.","transcription_en":"Wa-itha alqubooru buAAthirat","translation":{"id":312992,"text":"Kabirler alt üst edildiği zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5834,"surah_id":82,"verse_number":5,"verse":"عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَاَخَّرَتْۜ","verse_simplified":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","page":586,"juz_number":30,"transcription":"Alimet nefsun ma kaddemet ve ahharet.","transcription_en":"AAalimat nafsun ma qaddamatwaakhkharat","translation":{"id":312993,"text":"Herkes yaptığını ve yapmadığını bilecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5835,"surah_id":82,"verse_number":6,"verse":"يَٓا اَيُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْـكَر۪يمِۙ","verse_simplified":"يَا أَيُّهَا الْإِنسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ","page":586,"juz_number":30,"transcription":"Ya eyyuhel insanu ma garreke bi rabbikel kerim.","transcription_en":"Ya ayyuha al-insanu magharraka birabbika alkareem","translation":{"id":312994,"text":"Ey insan! Kerim[1] olan Rabb'ine karşı seni aldatan nedir?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26592,"text":"Şerefli. Cömert.","number":1}]}},{"id":5836,"surah_id":82,"verse_number":7,"verse":"اَلَّذ۪ي خَلَقَكَ فَسَوّٰيكَ فَعَدَلَكَۙ","verse_simplified":"الَّذِي خَلَقَكَ فَسَوَّاكَ فَعَدَلَكَ","page":586,"juz_number":30,"transcription":"Ellezi halakake fe sevvake fe adelek.","transcription_en":"Allathee khalaqaka fasawwakafaAAadalak","translation":{"id":312995,"text":"Seni yarattı, sonra sana şekil verdi, organlarını uyumlu ve dengeli yaptı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5837,"surah_id":82,"verse_number":8,"verse":"ف۪ٓي اَيِّ صُورَةٍ مَا شَٓاءَ رَكَّبَكَۜ","verse_simplified":"فِي أَيِّ صُورَةٍ مَّا شَاء رَكَّبَكَ","page":586,"juz_number":30,"transcription":"Fi eyyi suretin ma şae rekkebek.","transcription_en":"Fee ayyi sooratin ma shaarakkabak","translation":{"id":312996,"text":"Seni dilediği şekilde düzenledi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5838,"surah_id":82,"verse_number":9,"verse":"كَلَّا بَلْ تُكَذِّبُونَ بِالدّ۪ينِۙ","verse_simplified":"كَلَّا بَلْ تُكَذِّبُونَ بِالدِّينِ","page":586,"juz_number":30,"transcription":"Kella bel tukezzibune bid din.","transcription_en":"Kalla bal tukaththiboona biddeen","translation":{"id":312997,"text":"Hayır! Bilakis, siz dini[1] yalanlıyorsunuz!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26593,"text":"Hesap vermeyi. Yargılanmayı.","number":1}]}},{"id":5839,"surah_id":82,"verse_number":10,"verse":"وَاِنَّ عَلَيْكُمْ لَحَافِظ۪ينَۙ","verse_simplified":"وَإِنَّ عَلَيْكُمْ لَحَافِظِينَ","page":586,"juz_number":30,"transcription":"Ve inne aleykum le hafızin.","transcription_en":"Wa-inna AAalaykum lahafitheen","translation":{"id":312998,"text":"Sizin üzerinizde kesinlikle kaydediciler var,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5840,"surah_id":82,"verse_number":11,"verse":"كِرَاماً كَاتِب۪ينَۙ","verse_simplified":"كِرَامًا كَاتِبِينَ","page":586,"juz_number":30,"transcription":"Kiramen katibin.","transcription_en":"Kiraman katibeen","translation":{"id":312999,"text":"Şerefli yazıcılar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5841,"surah_id":82,"verse_number":12,"verse":"يَعْلَمُونَ مَا تَفْعَلُونَ","verse_simplified":"يَعْلَمُونَ مَا تَفْعَلُونَ","page":586,"juz_number":30,"transcription":"Ya'lemune ma tef'alun.","transcription_en":"YaAAlamoona ma tafAAaloon","translation":{"id":313000,"text":"Yaptığınız her şeyi bilirler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5842,"surah_id":82,"verse_number":13,"verse":"اِنَّ الْاَبْرَارَ لَف۪ي نَع۪يمٍۚ","verse_simplified":"إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ","page":586,"juz_number":30,"transcription":"İnnel ebrare lefi naim.","transcription_en":"Inna al-abrara lafee naAAeem","translation":{"id":313001,"text":"Birr[1] olanlar nimet[2] içindedirler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26594,"text":"İyi, yararlı ve doğru olan her şey, bütün iyilikler, bağışlamak, sadakat, samimiyet, doğruluk, adalet, gerçeklik, erdem, gönül.","number":1},{"id":26595,"text":"Cennet.","number":2}]}},{"id":5843,"surah_id":82,"verse_number":14,"verse":"وَاِنَّ الْفُجَّارَ لَف۪ي جَح۪يمٍۚ","verse_simplified":"وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ","page":586,"juz_number":30,"transcription":"Ve innel fuccare lefi cahim.","transcription_en":"Wa-inna alfujjara lafee jaheem","translation":{"id":313002,"text":"Facirler[1] Cehennem'dedirler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26596,"text":"Kötü, bozguncu, samimiyetsiz, yalancı, hak hukuk tanımaz, düzenbaz, zalim; din diyanet tanımayan, dinin sınırlarını çiğneyerek onun dışına çıkmak demektir. Facir Birr'in zıt anlamlısıdır.","number":1}]}},{"id":5844,"surah_id":82,"verse_number":15,"verse":"يَصْلَوْنَهَا يَوْمَ الدّ۪ينِ","verse_simplified":"يَصْلَوْنَهَا يَوْمَ الدِّينِ","page":586,"juz_number":30,"transcription":"Yaslevneha yevmed din.","transcription_en":"Yaslawnaha yawma addeen","translation":{"id":313003,"text":"Din Günü[1] ona yaslanırlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26597,"text":"Hesap görme günü, yargı günü.","number":1}]}},{"id":5845,"surah_id":82,"verse_number":16,"verse":"وَمَا هُمْ عَنْهَا بِغَٓائِب۪ينَۜ","verse_simplified":"وَمَا هُمْ عَنْهَا بِغَائِبِينَ","page":586,"juz_number":30,"transcription":"Ve ma hum anha bi gaibin.","transcription_en":"Wama hum AAanha bigha-ibeen","translation":{"id":313004,"text":"Onlar, onda yanıp bitecek değillerdir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5846,"surah_id":82,"verse_number":17,"verse":"وَمَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۙ","verse_simplified":"وَمَا أَدْرَاكَ مَا يَوْمُ الدِّينِ","page":586,"juz_number":30,"transcription":"Ve ma edrake ma yevmud din.","transcription_en":"Wama adraka ma yawmu addeeni","translation":{"id":313005,"text":"Din Günü'nün ne olduğunu sen nereden bileceksin?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5847,"surah_id":82,"verse_number":18,"verse":"ثُمَّ مَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۜ","verse_simplified":"ثُمَّ مَا أَدْرَاكَ مَا يَوْمُ الدِّينِ","page":586,"juz_number":30,"transcription":"Summe ma edrake ma yevmud din.","transcription_en":"Thumma ma adraka mayawmu addeen","translation":{"id":313006,"text":"Evet, Din Günü'nün ne olduğunu sen nereden bileceksin?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5848,"surah_id":82,"verse_number":19,"verse":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْـٔاًۜ وَالْاَمْرُ يَوْمَئِذٍ لِلّٰهِ","verse_simplified":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْئًا وَالْأَمْرُ يَوْمَئِذٍ لِلَّهِ","page":586,"juz_number":30,"transcription":"Yevme la temliku nefsun li nefsin şey'a, vel emru yevmeizin lillah.","transcription_en":"Yawma la tamliku nafsun linafsinshay-an wal-amru yawma-ithin lillah","translation":{"id":313007,"text":"O, kimsenin kimseye yardım etmeye gücünün yetmeyeceği bir gündür. O gün karar vermek bütünüyle Allah'a aittir.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26598,"text":"Ayetten de açıkça anlaşılmaktadır ki Kur'an, \"şefaat\" anlayışını ve inancını kesin olarak reddetmektedir. Kur'an'a göre, kesinlikle şefaat yoktur ve bu nedenle şefaatin varlığına inanan bir kimse Allah'a eş koşmuş olur.","number":1}]}}]}}