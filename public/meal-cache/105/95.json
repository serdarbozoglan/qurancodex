{"data":{"id":95,"name":"Tin","name_en":"At-Tin","name_original":"سورة التين","name_translation_tr":"İncir","name_translation_en":"The Fig","slug":"tin","verse_count":8,"page_number":596,"audio":{"mp3":"https://audio.acikkuran.com/tr/95.mp3","duration":38,"mp3_en":"https://audio.acikkuran.com/en/095.mp3","duration_en":38},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6099,"surah_id":95,"verse_number":1,"verse":"وَالتّ۪ينِ وَالزَّيْتُونِۙ","verse_simplified":"وَالتِّينِ وَالزَّيْتُونِ","page":596,"juz_number":30,"transcription":"Vet tini vez zeytun.","transcription_en":"Watteeni wazzaytoon","translation":{"id":313258,"text":"İncire ve zeytine ant olsun,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6100,"surah_id":95,"verse_number":2,"verse":"وَطُورِ س۪ين۪ينَۙ","verse_simplified":"وَطُورِ سِينِينَ","page":596,"juz_number":30,"transcription":"Ve turi sinin.","transcription_en":"Watoori seeneen","translation":{"id":313259,"text":"Ve Tur-i Sinin'e. [1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26709,"text":"Mübarek dağ. Bereket dağı. Aynı zamanda mübarek yani nimeti bereketli kılan, çoğaltan, bol bol nimet veren bereketli dağ, diğer bir deyimle bereketli topraklar anlamına da gelen bu kelimeye \"Sina Dağı\" anlamı vermek doğru değildir.","number":1}]}},{"id":6101,"surah_id":95,"verse_number":3,"verse":"وَهٰذَا الْبَلَدِ الْاَم۪ينِۙ","verse_simplified":"وَهَذَا الْبَلَدِ الْأَمِينِ","page":596,"juz_number":30,"transcription":"Ve hazel beledil emin.","transcription_en":"Wahatha albaladi al-ameen","translation":{"id":313260,"text":"Ve bu güvenli kente.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6102,"surah_id":95,"verse_number":4,"verse":"لَقَدْ خَلَقْنَا الْاِنْسَانَ ف۪ٓي اَحْسَنِ تَقْو۪يمٍۘ","verse_simplified":"لَقَدْ خَلَقْنَا الْإِنسَانَ فِي أَحْسَنِ تَقْوِيمٍ","page":596,"juz_number":30,"transcription":"Lekad halaknel insane fi ahseni takvim.","transcription_en":"Laqad khalaqna al-insana fee ahsanitaqweem","translation":{"id":313261,"text":"Ant olsun ki insanı en iyi biçimde yarattık.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6103,"surah_id":95,"verse_number":5,"verse":"ثُمَّ رَدَدْنَاهُ اَسْفَلَ سَافِل۪ينَۙ","verse_simplified":"ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ","page":596,"juz_number":30,"transcription":"Summe redednahu esfele safilin.","transcription_en":"Thumma radadnahu asfala safileen","translation":{"id":313262,"text":"Sonra onu aşağıların aşağısına indirdik.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6104,"surah_id":95,"verse_number":6,"verse":"اِلَّا الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ اَجْرٌ غَيْرُ مَمْنُونٍۜ","verse_simplified":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","page":597,"juz_number":30,"transcription":"İllellezine amenu ve amilus salihati fe lehum ecrun gayru memnun.","transcription_en":"Illa allatheena amanoowaAAamiloo assalihati falahum ajrun ghayrumamnoon","translation":{"id":313263,"text":"Ancak iman eden ve salihatı yapanlar[1] hariç. Onlar için minnet altında bırakmayan bir ödül vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26710,"text":"Bkz. 84:28. ayetin dipnotu.","number":1}]}},{"id":6105,"surah_id":95,"verse_number":7,"verse":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدّ۪ينِۜ","verse_simplified":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِ","page":597,"juz_number":30,"transcription":"Fe ma yukezzibuke ba'du bid din.","transcription_en":"Fama yukaththibuka baAAdu biddeen","translation":{"id":313264,"text":"Hal böyleyken, sana[1] dini[2] yalanlatan nedir?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26711,"text":"İnkar eden, müşrik olan kimse.","number":1},{"id":26712,"text":"Hesap Verme Günü'nü.","number":2}]}},{"id":6106,"surah_id":95,"verse_number":8,"verse":"اَلَيْسَ اللّٰهُ بِاَحْكَمِ الْحَاكِم۪ينَ","verse_simplified":"أَلَيْسَ اللَّهُ بِأَحْكَمِ الْحَاكِمِينَ","page":597,"juz_number":30,"transcription":"E leysallahu bi ahkemil hakimin.","transcription_en":"Alaysa Allahu bi-ahkami alhakimeen","translation":{"id":313265,"text":"Allah; hüküm verenlerin, en iyi hüküm vereni değil mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}