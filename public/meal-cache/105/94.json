{"data":{"id":94,"name":"İnşirah","name_en":"Ash-Sharh","name_original":"سورة الشرح","name_translation_tr":"Ferahlık","name_translation_en":"The Consolation","slug":"insirah","verse_count":8,"page_number":596,"audio":{"mp3":"https://audio.acikkuran.com/tr/94.mp3","duration":37,"mp3_en":"https://audio.acikkuran.com/en/094.mp3","duration_en":33},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6091,"surah_id":94,"verse_number":1,"verse":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ","verse_simplified":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","page":596,"juz_number":30,"transcription":"E lem neşrah leke sadrek.","transcription_en":"Alam nashrah laka sadrak","translation":{"id":313250,"text":"Senin için göğsünü açmadık mı?[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26704,"text":"Sıkıntılarına, kara kara düşünmene, ne yapacağını bilmemene son vermedik mi? Seni rahatlatmadık mı?","number":1}]}},{"id":6092,"surah_id":94,"verse_number":2,"verse":"وَوَضَعْنَا عَنْكَ وِزْرَكَۙ","verse_simplified":"وَوَضَعْنَا عَنكَ وِزْرَكَ","page":596,"juz_number":30,"transcription":"Ve vedagna anke vizrek.","transcription_en":"WawadaAAna AAanka wizrak","translation":{"id":313251,"text":"Yükünü üzerinden atmadık mı?[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26705,"text":"Ne yapacağını bilmezken, sana yol gösterdik mi?","number":1}]}},{"id":6093,"surah_id":94,"verse_number":3,"verse":"اَلَّـذ۪ٓي اَنْقَضَ ظَهْرَكَۙ","verse_simplified":"الَّذِي أَنقَضَ ظَهْرَكَ","page":596,"juz_number":30,"transcription":"Ellezi enkada zahrek.","transcription_en":"Allathee anqada thahrak","translation":{"id":313252,"text":"Belini büken yükünü?[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26706,"text":"İnsanlığın içinde bulunduğu durumun sana verdiği üzüntüyü.","number":1}]}},{"id":6094,"surah_id":94,"verse_number":4,"verse":"وَرَفَعْنَا لَكَ ذِكْرَكَۜ","verse_simplified":"وَرَفَعْنَا لَكَ ذِكْرَكَ","page":596,"juz_number":30,"transcription":"Ve refa'na leke zikrek.","transcription_en":"WarafaAAna laka thikrak","translation":{"id":313253,"text":"Senin zikrini yükseltmedik mi?[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26707,"text":"Bu denli önemli bir görevi (Nebi'lik/Resul'lük) sana vererek, herkes tarafından bilinmene ve anılmana neden olmadık mı?","number":1}]}},{"id":6095,"surah_id":94,"verse_number":5,"verse":"فَاِنَّ مَعَ الْعُسْرِ يُسْراًۙ","verse_simplified":"فَإِنَّ مَعَ الْعُسْرِ يُسْرًا","page":596,"juz_number":30,"transcription":"Fe inne maal usri yusra.","transcription_en":"Fa-inna maAAa alAAusri yusra","translation":{"id":313254,"text":"Zira zorlukla beraber bir kolaylık vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6096,"surah_id":94,"verse_number":6,"verse":"اِنَّ مَعَ الْعُسْرِ يُسْراًۜ","verse_simplified":"إِنَّ مَعَ الْعُسْرِ يُسْرًا","page":596,"juz_number":30,"transcription":"İnne maal usri yusra.","transcription_en":"Inna maAAa alAAusri yusra","translation":{"id":313255,"text":"Elbette zorlukla beraber bir kolaylık vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6097,"surah_id":94,"verse_number":7,"verse":"فَاِذَا فَرَغْتَ فَانْصَبْۙ","verse_simplified":"فَإِذَا فَرَغْتَ فَانصَبْ","page":596,"juz_number":30,"transcription":"Fe iza feragte fensab.","transcription_en":"Fa-itha faraghta fansab","translation":{"id":313256,"text":"O halde her fırsatta kararlılıkla yeni şeyler yapmaya giriş.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6098,"surah_id":94,"verse_number":8,"verse":"وَاِلٰى رَبِّكَ فَارْغَبْ","verse_simplified":"وَإِلَى رَبِّكَ فَارْغَبْ","page":596,"juz_number":30,"transcription":"Ve ila rabbike fergab.","transcription_en":"Wa-ila rabbika farghab","translation":{"id":313257,"text":"Ve yalnızca Rabb'ine yönel.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26708,"text":"Yardım ve desteği yalnızca Allah'tan iste. İsteklerini yalnızca Rabb'ine yönelt.","number":1}]}}]}}