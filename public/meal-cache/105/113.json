{"data":{"id":113,"name":"Felak","name_en":"Al-Falaq","name_original":"سورة الفلق","name_translation_tr":"Açılma","name_translation_en":"The Dawn","slug":"felak","verse_count":5,"page_number":604,"audio":{"mp3":"https://audio.acikkuran.com/tr/113.mp3","duration":26,"mp3_en":"https://audio.acikkuran.com/en/113.mp3","duration_en":28},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6226,"surah_id":113,"verse_number":1,"verse":"قُلْ اَعُوذُ بِرَبِّ الْفَلَقِۙ","verse_simplified":"قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ","page":604,"juz_number":30,"transcription":"Kul euzu bi rabbil felak.","transcription_en":"Qul aAAoothu birabbi alfalaq","translation":{"id":313385,"text":"De ki: \"Felak'ın[1] Rabb'ine sığınırım.\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26783,"text":"Felak, kelime olarak \"yarıp çıkaran\" demektir. Bu yarılmayı karanlığı yaran aydınlıkla sınırlamak doğru değildir. Felak'ın Rabb'i isim tamlaması olarak, evrende karanlığı yaran aydınlık da dahil olmak üzere, bitki, toprak, hücre, kısacası üreyerek, yarılarak, bölünerek çoğalan, değişikliğe uğrayarak yenilenen ne varsa onların tamamının programlayıcısı, düzenleyicisi demektir.","number":1}]}},{"id":6227,"surah_id":113,"verse_number":2,"verse":"مِنْ شَرِّ مَا خَلَقَۙ","verse_simplified":"مِن شَرِّ مَا خَلَقَ","page":604,"juz_number":30,"transcription":"Min şerri ma halak.","transcription_en":"Min sharri ma khalaq","translation":{"id":313386,"text":"\"Yarattığı şeylerin şerrinden,\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6228,"surah_id":113,"verse_number":3,"verse":"وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ","verse_simplified":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","page":604,"juz_number":30,"transcription":"Ve min şerri gasikın iza vekab.","transcription_en":"Wamin sharri ghasiqin ithawaqab","translation":{"id":313387,"text":"\"Ve çöktüğü zaman karanlığın[1] şerrinden,\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26784,"text":"Ayette gece kelimesi yer almamaktadır. Bu karanlık gecenin karanlığı olabileceği gibi mecazen cehaletin karanlığı anlamına da gelmektedir. Ve korkulması gereken en koyu karanlık da cehalet karanlığıdır. Cehalet, yalnızca bilgisizlik demek değildir; aynı zamanda gerçeğin dışında bir şeye inanmak ve doğru olanın, Hakk'ın tersini yapmaktır.","number":1}]}},{"id":6229,"surah_id":113,"verse_number":4,"verse":"وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِۙ","verse_simplified":"وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ","page":604,"juz_number":30,"transcription":"Ve min şerrin neffasati fil ukad.","transcription_en":"Wamin sharri annaffathatifee alAAuqad","translation":{"id":313388,"text":"\"Düğümlere üfleyenlerin[1] şerrinden,\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26785,"text":"Her türlü falcılık, büyü, yıldızname, astroloji/müneccimlik vb. şeyler, şerlerinden Allah'a sığınılacak türden şeyler olup şeytani şeylerdir. Mü'minler bu tür şirk içeren şeylerden uzak durmalıdırlar.","number":1}]}},{"id":6230,"surah_id":113,"verse_number":5,"verse":"وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ","verse_simplified":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","page":604,"juz_number":30,"transcription":"Ve min şerri hasidin iza hased.","transcription_en":"Wamin sharri hasidin itha hasad","translation":{"id":313389,"text":"\"Ve kıskandığı zaman, kıskananın şerrinden.\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}