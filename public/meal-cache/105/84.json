{"data":{"id":84,"name":"İnşikak","name_en":"Al-Inshiqaq","name_original":"سورة الإنشقاق","name_translation_tr":"Yarılma","name_translation_en":"The Splitting Open","slug":"insikak","verse_count":25,"page_number":588,"audio":{"mp3":"https://audio.acikkuran.com/tr/84.mp3","duration":113,"mp3_en":"https://audio.acikkuran.com/en/084.mp3","duration_en":110},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5885,"surah_id":84,"verse_number":1,"verse":"اِذَا السَّمَٓاءُ انْشَقَّتْۙ","verse_simplified":"إِذَا السَّمَاء انشَقَّتْ","page":588,"juz_number":30,"transcription":"İzes semaunşakkat.","transcription_en":"Itha assamao inshaqqat","translation":{"id":313044,"text":"Gök yarıldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5886,"surah_id":84,"verse_number":2,"verse":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۙ","verse_simplified":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":588,"juz_number":30,"transcription":"Ve ezinet li rabbiha ve hukkat.","transcription_en":"Waathinat lirabbiha wahuqqat","translation":{"id":313045,"text":"Rabb'inin buyruğunu yerine getirdiği zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5887,"surah_id":84,"verse_number":3,"verse":"وَاِذَا الْاَرْضُ مُدَّتْۙ","verse_simplified":"وَإِذَا الْأَرْضُ مُدَّتْ","page":588,"juz_number":30,"transcription":"Ve izel ardu muddet.","transcription_en":"Wa-itha al-ardu muddat","translation":{"id":313046,"text":"Yeryüzü uzatıldığı[1] zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26615,"text":"Dümdüz edildiği zaman.","number":1}]}},{"id":5888,"surah_id":84,"verse_number":4,"verse":"وَاَلْقَتْ مَا ف۪يهَا وَتَخَلَّتْۙ","verse_simplified":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","page":588,"juz_number":30,"transcription":"Ve elkat ma fiha ve tehallet.","transcription_en":"Waalqat ma feeha watakhallat","translation":{"id":313047,"text":"İçinde ne varsa atıp boşaldığı zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5889,"surah_id":84,"verse_number":5,"verse":"وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۜ","verse_simplified":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":588,"juz_number":30,"transcription":"Ve ezinet li rabbiha ve hukkat.","transcription_en":"Waathinat lirabbiha wahuqqat","translation":{"id":313048,"text":"Rabb'inin buyruğunu yerine getirdiği zaman,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5890,"surah_id":84,"verse_number":6,"verse":"يَٓا اَيُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدْحاً فَمُلَاق۪يهِۚ","verse_simplified":"يَا أَيُّهَا الْإِنسَانُ إِنَّكَ كَادِحٌ إِلَى رَبِّكَ كَدْحًا فَمُلَاقِيهِ","page":588,"juz_number":30,"transcription":"Ya eyyuhel insanu inneke kadihun ila rabbike kedhan fe mulakih.","transcription_en":"Ya ayyuha al-insanuinnaka kadihun ila rabbika kadhanfamulaqeeh","translation":{"id":313049,"text":"Ey İnsan! Rabb'ine kavuşuncaya kadar didinip duracak ve sonunda O'na kavuşacaksın.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26616,"text":"Ey İnsan! Aklını başına al, bütün çabaların bir gün sona erecek ve sen hesap vermek için Rabb'inin huzuruna çıkacaksın. Gidecek hiçbir yerin yok.","number":1}]}},{"id":5891,"surah_id":84,"verse_number":7,"verse":"فَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِيَم۪ينِه۪ۙ","verse_simplified":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ","page":588,"juz_number":30,"transcription":"Fe emma men utiye kitabehu bi yeminih.","transcription_en":"Faama man ootiya kitabahubiyameenih","translation":{"id":313050,"text":"Kime kitabı sağından[1] verilirse,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26617,"text":"Bu bir deyimdir. Araplarda sağ taraf deyimi, \"uğur, mutluluk, sağlamlık ve kurtuluşu\" ifade etmektedir.","number":1}]}},{"id":5892,"surah_id":84,"verse_number":8,"verse":"فَسَوْفَ يُحَاسَبُ حِسَاباً يَس۪يراًۙ","verse_simplified":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","page":588,"juz_number":30,"transcription":"Fe sevfe yuhasebu hısaben yesira.","transcription_en":"Fasawfa yuhasabu hisabanyaseera","translation":{"id":313051,"text":"Hesabı çok kolay görülecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5893,"surah_id":84,"verse_number":9,"verse":"وَيَنْقَلِبُ اِلٰٓى اَهْلِه۪ مَسْرُوراًۜ","verse_simplified":"وَيَنقَلِبُ إِلَى أَهْلِهِ مَسْرُورًا","page":588,"juz_number":30,"transcription":"Ve yenkalibu ila ehlihi mesrura.","transcription_en":"Wayanqalibu ila ahlihi masroora","translation":{"id":313052,"text":"Ve sevinç içinde yakınlarına dönecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5894,"surah_id":84,"verse_number":10,"verse":"وَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ وَرَٓاءَ ظَهْرِه۪ۙ","verse_simplified":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاء ظَهْرِهِ","page":588,"juz_number":30,"transcription":"Ve emma men utiye kitabehu verae zahrih.","transcription_en":"Waamma man ootiya kitabahu waraathahrih","translation":{"id":313053,"text":"Fakat kime kitabı arkasından[1] verilirse,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26618,"text":"Hesaba katmadıkları bir şekilde.","number":1}]}},{"id":5895,"surah_id":84,"verse_number":11,"verse":"فَسَوْفَ يَدْعُوا ثُبُوراًۙ","verse_simplified":"فَسَوْفَ يَدْعُو ثُبُورًا","page":588,"juz_number":30,"transcription":"Fe sevfe yed'u subura.","transcription_en":"Fasawfa yadAAoo thuboora","translation":{"id":313054,"text":"Ölüp yok olmak isteyecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5896,"surah_id":84,"verse_number":12,"verse":"وَيَصْلٰى سَع۪يراًۜ","verse_simplified":"وَيَصْلَى سَعِيرًا","page":588,"juz_number":30,"transcription":"Ve yasla saira.","transcription_en":"Wayasla saAAeera","translation":{"id":313055,"text":"Fakat alevli ateşe girecek.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5897,"surah_id":84,"verse_number":13,"verse":"اِنَّهُ  كَانَ ف۪ٓي اَهْلِه۪ مَسْرُوراً","verse_simplified":"إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا","page":588,"juz_number":30,"transcription":"İnnehu kane fi ehlihi mesrura.","transcription_en":"Innahu kana fee ahlihi masroora","translation":{"id":313056,"text":"O, dünyada yakınları içindeyken sevinçliydi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5898,"surah_id":84,"verse_number":14,"verse":"اِنَّهُ ظَنَّ اَنْ لَنْ يَحُورَۚۛ","verse_simplified":"إِنَّهُ ظَنَّ أَن لَّن يَحُورَ","page":589,"juz_number":30,"transcription":"İnnehu zanne en len yahur.","transcription_en":"Innahu thanna an lan yahoor","translation":{"id":313057,"text":"O, kesinlikle dönmeyeceğini[1] sanıyordu.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26619,"text":"Ölümden sonra diriltilmeyeceğine inanıyordu.","number":1}]}},{"id":5899,"surah_id":84,"verse_number":15,"verse":"بَلٰىۚۛ  اِنَّ رَبَّهُ  كَانَ بِه۪ بَص۪يراًۜ","verse_simplified":"بَلَى إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا","page":589,"juz_number":30,"transcription":"Bela, inne rabbehu kane bihi basira.","transcription_en":"Bala inna rabbahu kana bihi baseera","translation":{"id":313058,"text":"Bilakis! Rabb'i onu çok iyi görüyordu.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5900,"surah_id":84,"verse_number":16,"verse":"فَلَٓا اُقْسِمُ بِالشَّفَقِۙ","verse_simplified":"فَلَا أُقْسِمُ بِالشَّفَقِ","page":589,"juz_number":30,"transcription":"Fe la uksimu biş şefak.","transcription_en":"Fala oqsimu bishshafaq","translation":{"id":313059,"text":"Şafak vaktine yemin ederim;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5901,"surah_id":84,"verse_number":17,"verse":"وَالَّيْلِ وَمَا وَسَقَۙ","verse_simplified":"وَاللَّيْلِ وَمَا وَسَقَ","page":589,"juz_number":30,"transcription":"Vel leyli ve ma vesak.","transcription_en":"Wallayli wama wasaq","translation":{"id":313060,"text":"Geceye ve barındırdıklarına,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5902,"surah_id":84,"verse_number":18,"verse":"وَالْقَمَرِ اِذَا اتَّسَقَۙ","verse_simplified":"وَالْقَمَرِ إِذَا اتَّسَقَ","page":589,"juz_number":30,"transcription":"Vel kameri izet tesak.","transcription_en":"Walqamari itha ittasaq","translation":{"id":313061,"text":"Dolunay halindeki Ay'a,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5903,"surah_id":84,"verse_number":19,"verse":"لَتَرْكَبُنَّ طَبَقاً عَنْ طَبَقٍۜ","verse_simplified":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","page":589,"juz_number":30,"transcription":"Le terkebunne tabakan an tabakın.","transcription_en":"Latarkabunna tabaqan AAan tabaq","translation":{"id":313062,"text":"Kesinlikle tabakadan tabakaya bineceksiniz.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26620,"text":"Kıyamet günü halden hale sürekli değişecek ama asla yok olup gitmeyeceksiniz.","number":1}]}},{"id":5904,"surah_id":84,"verse_number":20,"verse":"فَمَا لَهُمْ لَا يُؤْمِنُونَۙ","verse_simplified":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","page":589,"juz_number":30,"transcription":"Fe ma lehum la yu'minun.","transcription_en":"Fama lahum la yu/minoon","translation":{"id":313063,"text":"Onların nesi var ki iman etmiyorlar?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5905,"surah_id":84,"verse_number":21,"verse":"وَاِذَا قُرِئَ عَلَيْهِمُ الْقُرْاٰنُ لَا يَسْجُدُونَۜ","verse_simplified":"وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ*","page":589,"juz_number":30,"transcription":"Ve iza kurıe aleyhimul kur'anu la yescudun.","transcription_en":"Wa-itha quri-a AAalayhimu alqur-anula yasjudoon","translation":{"id":313064,"text":"Kendilerine Kur'an okunduğu[1] zaman secde[2] etmiyorlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26621,"text":"Allah'ın buyrukları onlara duyurulduğu zaman, iletildiği zaman.","number":1},{"id":26622,"text":"Buyruklarını önemseyip gereğini yapmıyorlar. O'na teslim olmuyorlar.","number":2}]}},{"id":5906,"surah_id":84,"verse_number":22,"verse":"بَلِ الَّذ۪ينَ كَفَرُوا يُكَذِّبُونَۘ","verse_simplified":"بَلِ الَّذِينَ كَفَرُواْ يُكَذِّبُونَ","page":589,"juz_number":30,"transcription":"Belillezine keferu yukezzibun.","transcription_en":"Bali allatheena kafaroo yukaththiboon","translation":{"id":313065,"text":"Aksine, Kafirler yalanlıyorlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5907,"surah_id":84,"verse_number":23,"verse":"وَاللّٰهُ اَعْلَمُ بِمَا يُوعُونَۘ","verse_simplified":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ","page":589,"juz_number":30,"transcription":"Vallahu a'lemu bima yuun.","transcription_en":"Wallahu aAAlamu bimayooAAoon","translation":{"id":313066,"text":"Allah, onların içlerinde ne sakladıklarını en iyi bilendir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5908,"surah_id":84,"verse_number":24,"verse":"فَبَشِّرْهُمْ بِعَذَابٍ اَل۪يمٍۙ","verse_simplified":"فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ","page":589,"juz_number":30,"transcription":"Fe beşşirhum bi azabin elim.","transcription_en":"Fabashshirhum biAAathabin aleem","translation":{"id":313067,"text":"O halde onları elem verici azapla haberdar et!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5909,"surah_id":84,"verse_number":25,"verse":"اِلَّا الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ اَجْرٌ غَيْرُ مَمْنُونٍ","verse_simplified":"إِلَّا الَّذِينَ آمَنُواْ وَعَمِلُواْ الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","page":589,"juz_number":30,"transcription":"İllellezine amenu ve amilus salihati lehum ecrun gayru memnun.","transcription_en":"Illa allatheena amanoowaAAamiloo assalihati lahum ajrun ghayrumamnoon","translation":{"id":313068,"text":"Ancak iman eden ve salihatı yapanlar[1] hariç. Onlar için minnet altında bırakmayan bir ödül vardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26623,"text":"\"İman edip, salihatı yapanlar\" terkibini \"iman edip iyi işler yapanlar\" diye çevirmek doğru değildir. Salihat, davranış yolu ile bütünüyle dışa yansıyan imandır. Salihat, bozgunculuk ve kötülükle mücadele etmek, bozuk olan şeyi düzeltmeye çalışmak, yapıcı olmak, iyi olmak ve iyiye yönlendirmek demektir. Bu kelimenin karşıtı \"seyyiat\" yani kötülük ve \"fesad\" yani bozgunculuk kelimeleridir.","number":1}]}}]}}