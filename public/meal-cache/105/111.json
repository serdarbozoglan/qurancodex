{"data":{"id":111,"name":"Tebbet","name_en":"Al-Masad","name_original":"سورة المسد","name_translation_tr":"Diken","name_translation_en":"The Palm Fibre","slug":"tebbet","verse_count":5,"page_number":603,"audio":{"mp3":"https://audio.acikkuran.com/tr/111.mp3","duration":26,"mp3_en":"https://audio.acikkuran.com/en/111.mp3","duration_en":28},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6217,"surah_id":111,"verse_number":1,"verse":"تَبَّتْ  يَدَٓا اَب۪ي لَهَبٍ وَتَبَّۜ","verse_simplified":"تَبَّتْ يَدَا أَبِي لَهَبٍ وَتَبَّ","page":603,"juz_number":30,"transcription":"Tebbet yeda ebi lehebin ve tebb.","transcription_en":"Tabbat yada abee lahabin watab","translation":{"id":313376,"text":"Ebu Leheb'in iki eli[1] kurudu.[2] Ve kendisi de yok oldu.[3]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26774,"text":"Gücü, malı mülkü, imkanı.","number":1},{"id":26775,"text":"Yok oldu.","number":2},{"id":26776,"text":"Kur'an, anlatım üslubu olarak, ileride olacak bir şeyin, kesinlikle olacağını vurgulamak için gelecek zaman yerine geniş veya geçmiş zaman kipini kullanmaktadır.","number":3}]}},{"id":6218,"surah_id":111,"verse_number":2,"verse":"مَٓا اَغْنٰى عَنْهُ مَالُهُ وَمَا كَسَبَۜ","verse_simplified":"مَا أَغْنَى عَنْهُ مَالُهُ وَمَا كَسَبَ","page":603,"juz_number":30,"transcription":"Ma agna anhu maluhu ve ma keseb.","transcription_en":"Ma aghna AAanhu maluhuwama kasab","translation":{"id":313377,"text":"Malı da kazandıkları da ona bir yarar sağlamadı.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6219,"surah_id":111,"verse_number":3,"verse":"سَيَصْلٰى نَاراً ذَاتَ لَهَبٍۚ","verse_simplified":"سَيَصْلَى نَارًا ذَاتَ لَهَبٍ","page":603,"juz_number":30,"transcription":"Se yasla naren zate leheb.","transcription_en":"Sayasla naran thatalahab","translation":{"id":313378,"text":"Alevli ateşe atılacak.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6220,"surah_id":111,"verse_number":4,"verse":"وَامْرَاَتُهُۜ  حَمَّالَةَ الْحَطَبِۚ","verse_simplified":"وَامْرَأَتُهُ حَمَّالَةَ الْحَطَبِ","page":603,"juz_number":30,"transcription":"Vemreetuh, hammaletel hatab.","transcription_en":"Wamraatuhu hammalata alhatab","translation":{"id":313379,"text":"Odun hamalı karısı da.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6221,"surah_id":111,"verse_number":5,"verse":"ف۪ي ج۪يدِهَا حَبْلٌ مِنْ مَسَدٍ","verse_simplified":"فِي جِيدِهَا حَبْلٌ مِّن مَّسَدٍ","page":603,"juz_number":30,"transcription":"Fi cidiha hablun min mesed.","transcription_en":"Fee jeediha hablun min masad","translation":{"id":313380,"text":"Boynunda liften bir urgan.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26777,"text":"Benzetme ile boynundaki urgan/kalın iple kocası ve kendisi için Cehennem ateşine odun taşıyacağı ifade edilmektedir. \"Odun taşımak\", Arapça'da deyim olarak, \"koğuculuk yapmak, laf taşımak\" anlamına gelmektedir.","number":1}]}}]}}