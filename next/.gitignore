# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# RAG corpus artifacts
# corpus-raw.json: intermediate file (~6MB), regenerable via build-corpus.mjs
src/lib/corpus-raw.json
# corpus-embeddings.json (~75 MB): COMMITTED via Git LFS (see .gitattributes)
# corpus-manifest.json: COMMITTED small (~800KB), needed for incremental rebuilds


# Playwright test artifacts
test-results/
playwright-report/
