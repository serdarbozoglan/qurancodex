{"data":{"id":107,"name":"Maun","name_en":"Al-Ma'un","name_original":"سورة الماعون","name_translation_tr":"Yardımlaşma","name_translation_en":"Almsgiving","slug":"maun","verse_count":7,"page_number":602,"audio":{"mp3":"https://audio.acikkuran.com/tr/107.mp3","duration":31,"mp3_en":"https://audio.acikkuran.com/en/107.mp3","duration_en":29},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":6198,"surah_id":107,"verse_number":1,"verse":"اَرَاَيْتَ الَّذ۪ي يُكَذِّبُ بِالدّ۪ينِۜ","verse_simplified":"أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ","page":602,"juz_number":30,"transcription":"E raeytellezi yukezzibu bid din.","transcription_en":"Araayta allathee yukaththibu biddeen","translation":{"id":313357,"text":"Dini[1] yalanlayanı görüyorsun değil mi?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26758,"text":"Ceza/karşılık. Hesap Günü'nü. Borcunu: Kendisine verilen nimetleri yok sayanı gördün mü? Din, deyn/borç kelimesinden türemiştir.","number":1}]}},{"id":6199,"surah_id":107,"verse_number":2,"verse":"فَذٰلِكَ الَّذ۪ي يَدُعُّ الْيَت۪يمَۙ","verse_simplified":"فَذَلِكَ الَّذِي يَدُعُّ الْيَتِيمَ","page":602,"juz_number":30,"transcription":"Fe zalikellezi yedu'ul yetim.","transcription_en":"Fathalika allathee yaduAAAAualyateem","translation":{"id":313358,"text":"İşte o, yetimi itip kakar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6200,"surah_id":107,"verse_number":3,"verse":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْك۪ينِۜ","verse_simplified":"وَلَا يَحُضُّ عَلَى طَعَامِ الْمِسْكِينِ","page":602,"juz_number":30,"transcription":"Ve la yahuddu ala taamil miskin.","transcription_en":"Wala yahuddu AAalataAAami almiskeen","translation":{"id":313359,"text":"Miskini doyurmaya teşvik etmez.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26759,"text":"Çalışmaya gücü yetmeyenin, kendi malında bulunan payını vermez.","number":1}]}},{"id":6201,"surah_id":107,"verse_number":4,"verse":"فَوَيْلٌ لِلْمُصَلّ۪ينَۙ","verse_simplified":"فَوَيْلٌ لِّلْمُصَلِّينَ","page":602,"juz_number":30,"transcription":"Fe veylun lil musallin.","transcription_en":"Fawaylun lilmusalleen","translation":{"id":313360,"text":"Vay haline salat edenlerin![1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26760,"text":"Destek olanların, yardım edenlerin! Gösteriş olsun diye veya çıkarları için yardım edenlerin vay haline. Söz konusu bu kimseler, Mekke'li Müşriklerdir. Ayete, \"Gösteriş yapmak için namaz kılanların vay haline.\" şeklinde anlam verilmesi doğru değildir. Mekke koşullarında Müslim olduğunu bile gizlemek zorunda olanların, gösteriş için namaz kılmaları söz konusu olabilir mi? Surenin, bu ve bundan sonraki ayetlerinin Medeni olduğunu söylemek ise, bu yanılgıdaki tutarsızlığı izah etme düşüncesinden kaynaklanan ikinci bir yanılgıdır. Bu yanılgının esas nedeni, karşılaşılan her \"salat\" kelimesine \"namaz\" anlamı verilmesidir. Oysaki bu ayetteki salat kelimesinin anlamı \"yardım etmek, destek olmak\" tır. Sonraki ayetler de zaten konunun yardımla ilgili olduğunu açıkça ifade etmektedir.","number":1}]}},{"id":6202,"surah_id":107,"verse_number":5,"verse":"اَلَّذ۪ينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَۙ","verse_simplified":"الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","page":602,"juz_number":30,"transcription":"Ellezine hum an salatihim sahun.","transcription_en":"Allatheena hum AAan salatihimsahoon","translation":{"id":313361,"text":"Onlar ki salatlarından[1] gafletteler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26761,"text":"Yardım etme, destek olma bilincinden, erdeminden, samimiyetinden yoksundurlar.","number":1}]}},{"id":6203,"surah_id":107,"verse_number":6,"verse":"اَلَّذ۪ينَ هُمْ يُرَٓاؤُ۫نَۙ","verse_simplified":"الَّذِينَ هُمْ يُرَاؤُونَ","page":602,"juz_number":30,"transcription":"Ellezine hum yuraun.","transcription_en":"Allatheena hum yuraoon","translation":{"id":313362,"text":"Onlar gösteriş yapanlardır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":6204,"surah_id":107,"verse_number":7,"verse":"وَيَمْنَعُونَ الْمَاعُونَ","verse_simplified":"وَيَمْنَعُونَ الْمَاعُونَ","page":602,"juz_number":30,"transcription":"Ve yemneunel maun.","transcription_en":"WayamnaAAoona almaAAoon","translation":{"id":313363,"text":"Ve küçük, basit, sıradan yardımı bile esirgerler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}}]}}