{"data":{"id":74,"name":"Müddessir","name_en":"Al-Muddaththir","name_original":"سورة المدثر","name_translation_tr":"Gizlenen","name_translation_en":"The Cloaked One","slug":"muddessir","verse_count":56,"page_number":574,"audio":{"mp3":"https://audio.acikkuran.com/tr/74.mp3","duration":252,"mp3_en":"https://audio.acikkuran.com/en/074.mp3","duration_en":253},"zero":{"id":1,"surah_id":1,"verse_number":1,"verse":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ","verse_simplified":"بِسْمِ اللّهِ الرَّحْمَنِ الرَّحِيمِ","page":0,"juz_number":1,"transcription":"Bismillahir rahmanir rahim.","transcription_en":"Bismi Allahi arrahmani arraheem","translation":{"id":307160,"author":{"id":105,"name":"Erhan Aktaş","description":"Kerim Kur'an","language":"tr","url":null},"text":"Rahmeti Bol ve Kesintisiz Olan Allah'ın Adıyla.","footnotes":null}},"verses":[{"id":5496,"surah_id":74,"verse_number":1,"verse":"يَٓا اَيُّهَا الْمُدَّثِّرُۙ","verse_simplified":"يَا أَيُّهَا الْمُدَّثِّرُ","page":574,"juz_number":29,"transcription":"Ya eyyuhel muddessir.","transcription_en":"Ya ayyuha almuddaththir","translation":{"id":312655,"text":"Ey örtüye bürünmüş olan.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26484,"text":"Bu bir benzetmedir: \"İçine kapanıp toplumdan soyutlanan, yılgınlık gösteren\" gibi anlamlara gelmektedir.","number":1}]}},{"id":5497,"surah_id":74,"verse_number":2,"verse":"قُمْ فَاَنْذِرْۙ","verse_simplified":"قُمْ فَأَنذِرْ","page":574,"juz_number":29,"transcription":"Kum fe enzir.","transcription_en":"Qum faanthir","translation":{"id":312656,"text":"Kalk ve uyarmaya başla.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5498,"surah_id":74,"verse_number":3,"verse":"وَرَبَّكَ فَـكَبِّرْۙ","verse_simplified":"وَرَبَّكَ فَكَبِّرْ","page":574,"juz_number":29,"transcription":"Ve rabbeke fe kebbir.","transcription_en":"Warabbaka fakabbir","translation":{"id":312657,"text":"Rabb'ini tekbir[1] et!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26485,"text":"Büyüklüğünü, yüceliğini anlat.","number":1}]}},{"id":5499,"surah_id":74,"verse_number":4,"verse":"وَثِيَابَكَ فَطَهِّرْۙ","verse_simplified":"وَثِيَابَكَ فَطَهِّرْ","page":574,"juz_number":29,"transcription":"Ve siyabeke fe tahhir.","transcription_en":"Wathiyabaka fatahhir","translation":{"id":312658,"text":"Ve örtünü hemen temizle.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26486,"text":"Kaygılarından bir an önce kurtul. Boşuna endişelenme. Sorumluluğunun gereğini yerine getir.","number":1}]}},{"id":5500,"surah_id":74,"verse_number":5,"verse":"وَالرُّجْزَ فَاهْجُرْۙ","verse_simplified":"وَالرُّجْزَ فَاهْجُرْ","page":574,"juz_number":29,"transcription":"Verrucze fehcur.","transcription_en":"Warrujza fahjur","translation":{"id":312659,"text":"Kirlilikten kaçın.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26487,"text":"Kelimesi kelimesine olarak \"ricz\" den kaçın. Üzen, sıkıntıya sokan, rahatsız eden, acı veren, azaba yol açan şeyden kaçın.","number":1}]}},{"id":5501,"surah_id":74,"verse_number":6,"verse":"وَلَا تَمْنُنْ تَسْتَكْثِرُۙ","verse_simplified":"وَلَا تَمْنُن تَسْتَكْثِرُ","page":574,"juz_number":29,"transcription":"Ve la temnun testeksir.","transcription_en":"Wala tamnun tastakthir","translation":{"id":312660,"text":"Karşılık bekleyerek iyilik yapma.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26488,"text":"Sen yalnızca görevini yap, sonuç üzerinde beklentiye girme. Davetin kabul görmese de sen kararlılıkla hizmetine devam et.","number":1}]}},{"id":5502,"surah_id":74,"verse_number":7,"verse":"وَلِرَبِّكَ فَاصْبِرْۜ","verse_simplified":"وَلِرَبِّكَ فَاصْبِرْ","page":574,"juz_number":29,"transcription":"Ve li rabbike fasbir.","transcription_en":"Walirabbika fasbir","translation":{"id":312661,"text":"Rabb'in için sabret.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26489,"text":"Zorluklara karşı diren, yılmadan, usanmadan tam bir kararlılıkla gayret göster.","number":1}]}},{"id":5503,"surah_id":74,"verse_number":8,"verse":"فَاِذَا نُقِرَ فِي النَّاقُورِۙ","verse_simplified":"فَإِذَا نُقِرَ فِي النَّاقُورِ","page":574,"juz_number":29,"transcription":"Fe iza nukıre fin naku.","transcription_en":"Fa-itha nuqira fee annaqoor","translation":{"id":312662,"text":"Nakur'a[1] üflendiği zaman.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26490,"text":"Boru.","number":1}]}},{"id":5504,"surah_id":74,"verse_number":9,"verse":"فَذٰلِكَ يَوْمَئِذٍ يَوْمٌ عَس۪يرٌۙ","verse_simplified":"فَذَلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","page":574,"juz_number":29,"transcription":"Fe zalike yevme izin yevmun asi.","transcription_en":"Fathalika yawma-ithin yawmunAAaseer","translation":{"id":312663,"text":"İşte O Gün,[1] çok zorlu bir gündür;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26491,"text":"Hesap sorma günü, yalnızca Allah'ın belirlediği ilke ve kuralların geçerli olduğu gün.","number":1}]}},{"id":5505,"surah_id":74,"verse_number":10,"verse":"عَلَى الْـكَافِر۪ينَ غَيْرُ يَس۪يرٍ","verse_simplified":"عَلَى الْكَافِرِينَ غَيْرُ يَسِيرٍ","page":574,"juz_number":29,"transcription":"Alel kafirine gayru yesir.","transcription_en":"AAala alkafireena ghayruyaseer","translation":{"id":312664,"text":"Kafirler için kolay olmayan.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5506,"surah_id":74,"verse_number":11,"verse":"ذَرْن۪ي وَمَنْ خَلَقْتُ وَح۪يداًۙ","verse_simplified":"ذَرْنِي وَمَنْ خَلَقْتُ وَحِيدًا","page":574,"juz_number":29,"transcription":"Zerni ve men halaktu vahida.","transcription_en":"Tharnee waman khalaqtu waheeda","translation":{"id":312665,"text":"Tek olarak yarattığım kişiyi Bana bırak.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26492,"text":"Hiçbir şeye sahip değilken; birçok şeye sahip kıldığım kişiyi.","number":1}]}},{"id":5507,"surah_id":74,"verse_number":12,"verse":"وَجَعَلْتُ لَهُ مَالاً مَمْدُوداًۙ","verse_simplified":"وَجَعَلْتُ لَهُ مَالًا مَّمْدُودًا","page":574,"juz_number":29,"transcription":"Ve ce'altu lehu malen memduda.","transcription_en":"WajaAAaltu lahu malan mamdooda","translation":{"id":312666,"text":"Ona hesapsız mal verdim;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5508,"surah_id":74,"verse_number":13,"verse":"وَبَن۪ينَ شُهُوداًۙ","verse_simplified":"وَبَنِينَ شُهُودًا","page":574,"juz_number":29,"transcription":"Ve benine şuhuda.","transcription_en":"Wabaneena shuhooda","translation":{"id":312667,"text":"Ve her zaman yanında olan evlatlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5509,"surah_id":74,"verse_number":14,"verse":"وَمَهَّدْتُ لَهُ تَمْه۪يداًۙ","verse_simplified":"وَمَهَّدتُّ لَهُ تَمْهِيدًا","page":574,"juz_number":29,"transcription":"Ve mehhedtu lehu temhida.","transcription_en":"Wamahhadtu lahu tamheeda","translation":{"id":312668,"text":"Ona, geniş imkanlar sağladım.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5510,"surah_id":74,"verse_number":15,"verse":"ثُمَّ يَطْمَعُ اَنْ اَز۪يدَۗ","verse_simplified":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","page":574,"juz_number":29,"transcription":"Summe yatmau en ezid.","transcription_en":"Thumma yatmaAAu an azeed","translation":{"id":312669,"text":"Sonra hırsla daha da artırmamı ister.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5511,"surah_id":74,"verse_number":16,"verse":"كَلَّاۜ اِنَّهُ كَانَ لِاٰيَاتِنَا عَن۪يداًۜ","verse_simplified":"كَلَّا إِنَّهُ كَانَ لِآيَاتِنَا عَنِيدًا","page":574,"juz_number":29,"transcription":"Kella, innehu kane li ayatina anida.","transcription_en":"Kalla innahu kana li-ayatinaAAaneeda","translation":{"id":312670,"text":"Hayır, asla! O Biz'im ayetlerimize karşı inat etti.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5512,"surah_id":74,"verse_number":17,"verse":"سَاُرْهِقُهُ صَعُوداًۜ","verse_simplified":"سَأُرْهِقُهُ صَعُودًا","page":574,"juz_number":29,"transcription":"Se urhikuhu sauda.","transcription_en":"Saorhiquhu saAAooda","translation":{"id":312671,"text":"Onu sarp bir yokuşa sardıracağım.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5513,"surah_id":74,"verse_number":18,"verse":"اِنَّهُ فَـكَّرَ وَقَدَّرَۙ","verse_simplified":"إِنَّهُ فَكَّرَ وَقَدَّرَ","page":575,"juz_number":29,"transcription":"İnnehu fekkere ve kadder.","transcription_en":"Innahu fakkara waqaddar","translation":{"id":312672,"text":"Düşündü ve karar verdi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5514,"surah_id":74,"verse_number":19,"verse":"فَقُتِلَ كَيْفَ قَدَّرَۙ","verse_simplified":"فَقُتِلَ كَيْفَ قَدَّرَ","page":575,"juz_number":29,"transcription":"Fe kutile keyfe kadder.","transcription_en":"Faqutila kayfa qaddar","translation":{"id":312673,"text":"O mahvoldu, nasıl bir karar verdi![1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26493,"text":"Kur'an'a karşı nasıl da haince plan yaptı!","number":1}]}},{"id":5515,"surah_id":74,"verse_number":20,"verse":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَۙ","verse_simplified":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","page":575,"juz_number":29,"transcription":"Summe kutile keyfe kadder.","transcription_en":"Thumma qutila kayfa qaddar","translation":{"id":312674,"text":"Yine o mahvoldu. Nasıl bir karar verdi![1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26494,"text":"Yine o Kur'an'a karşı nasıl da haince plan yaptı!","number":1}]}},{"id":5516,"surah_id":74,"verse_number":21,"verse":"ثُمَّ نَظَرَۙ","verse_simplified":"ثُمَّ نَظَرَ","page":575,"juz_number":29,"transcription":"Summe nazar.","transcription_en":"Thumma nathar","translation":{"id":312675,"text":"Sonra baktı!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5517,"surah_id":74,"verse_number":22,"verse":"ثُمَّ عَبَسَ وَبَسَرَۙ","verse_simplified":"ثُمَّ عَبَسَ وَبَسَرَ","page":575,"juz_number":29,"transcription":"Summe abese ve beser.","transcription_en":"Thumma AAabasa wabasar","translation":{"id":312676,"text":"Sonra kaşlarını çatıp surat astı!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5518,"surah_id":74,"verse_number":23,"verse":"ثُمَّ اَدْبَرَ وَاسْتَكْبَرَۙ","verse_simplified":"ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ","page":575,"juz_number":29,"transcription":"Summe edbere vestekber.","transcription_en":"Thumma adbara wastakbar","translation":{"id":312677,"text":"Sonra kibirlendi ve arkasını döndü!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5519,"surah_id":74,"verse_number":24,"verse":"فَقَالَ اِنْ هٰذَٓا اِلَّا سِحْرٌ يُؤْثَرُۙ","verse_simplified":"فَقَالَ إِنْ هَذَا إِلَّا سِحْرٌ يُؤْثَرُ","page":575,"juz_number":29,"transcription":"Fe kale in haza illa sihrun yu'ser.","transcription_en":"Faqala in hatha illa sihrunyu/thar","translation":{"id":312678,"text":"\"Bu, rivayetle gelen bir büyüden başka bir şey değil.\" dedi.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5520,"surah_id":74,"verse_number":25,"verse":"اِنْ هٰذَٓا اِلَّا قَوْلُ الْبَشَرِۜ","verse_simplified":"إِنْ هَذَا إِلَّا قَوْلُ الْبَشَرِ","page":575,"juz_number":29,"transcription":"İn haza illa kavlul beşer.","transcription_en":"In hatha illa qawlu albashar","translation":{"id":312679,"text":"\"Bu, olsa olsa ancak bir beşer sözüdür!\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5521,"surah_id":74,"verse_number":26,"verse":"سَاُصْل۪يهِ سَقَرَ","verse_simplified":"سَأُصْلِيهِ سَقَرَ","page":575,"juz_number":29,"transcription":"Se uslihi sekar.","transcription_en":"Saosleehi saqar","translation":{"id":312680,"text":"Onu Sakar'a sokacağım.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5522,"surah_id":74,"verse_number":27,"verse":"وَمَٓا اَدْرٰيكَ مَا سَقَرُۜ","verse_simplified":"وَمَا أَدْرَاكَ مَا سَقَرُ","page":575,"juz_number":29,"transcription":"Ve ma edrake ma sekar.","transcription_en":"Wama adraka ma saqar","translation":{"id":312681,"text":"Sakar'ın ne olduğunu sana bildiren nedir?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5523,"surah_id":74,"verse_number":28,"verse":"لَا تُبْق۪ي وَلَا تَذَرُۚ","verse_simplified":"لَا تُبْقِي وَلَا تَذَرُ","page":575,"juz_number":29,"transcription":"La tubki ve la tezer.","transcription_en":"La tubqee wala tathar","translation":{"id":312682,"text":"O bırakmaz ve terk etmez!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5524,"surah_id":74,"verse_number":29,"verse":"لَـوَّاحَةٌ لِلْبَشَرِۚ","verse_simplified":"لَوَّاحَةٌ لِّلْبَشَرِ","page":575,"juz_number":29,"transcription":"Levvahatun lil beşer.","transcription_en":"Lawwahatun lilbashar","translation":{"id":312683,"text":"Beşeri yakıp kavurucudur!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5525,"surah_id":74,"verse_number":30,"verse":"عَلَيْهَا تِسْعَةَ عَشَرَۜ","verse_simplified":"عَلَيْهَا تِسْعَةَ عَشَرَ","page":575,"juz_number":29,"transcription":"Aleyha tis'ate aşer.","transcription_en":"AAalayha tisAAata AAashar","translation":{"id":312684,"text":"Onun üzerinedir on dokuz!","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5526,"surah_id":74,"verse_number":31,"verse":"وَمَا جَعَلْنَٓا اَصْحَابَ النَّارِ اِلَّا مَلٰٓئِكَةًۖ وَمَا جَعَلْنَا عِدَّتَهُمْ اِلَّا فِتْنَةً لِلَّذ۪ينَ كَـفَرُواۙ لِيَسْتَيْقِنَ الَّذ۪ينَ اُو۫تُوا الْـكِتَابَ وَيَزْدَادَ الَّذ۪ينَ اٰمَنُٓوا ا۪يمَاناً وَلَا يَرْتَابَ الَّذ۪ينَ اُو۫تُوا الْـكِتَابَ وَالْمُؤْمِنُونَۙ وَلِيَقُولَ الَّذ۪ينَ ف۪ي قُلُوبِهِمْ مَرَضٌ وَالْـكَافِرُونَ مَاذَٓا اَرَادَ اللّٰهُ بِهٰذَا مَثَلاًۜ   كَذٰلِكَ يُضِلُّ اللّٰهُ مَنْ يَشَٓاءُ وَيَـهْد۪ي مَنْ يَشَٓاءُۜ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ اِلَّا هُوَۜ  وَمَا هِيَ اِلَّا ذِكْرٰى لِلْبَشَرِ۟","verse_simplified":"وَمَا جَعَلْنَا أَصْحَابَ النَّارِ إِلَّا مَلَائِكَةً وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا لِيَسْتَيْقِنَ الَّذِينَ أُوتُوا الْكِتَابَ وَيَزْدَادَ الَّذِينَ آمَنُوا إِيمَانًا وَلَا يَرْتَابَ الَّذِينَ أُوتُوا الْكِتَابَ وَالْمُؤْمِنُونَ وَلِيَقُولَ الَّذِينَ فِي قُلُوبِهِم مَّرَضٌ وَالْكَافِرُونَ مَاذَا أَرَادَ اللَّهُ بِهَذَا مَثَلًا كَذَلِكَ يُضِلُّ اللَّهُ مَن يَشَاء وَيَهْدِي مَن يَشَاء وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ وَمَا هِيَ إِلَّا ذِكْرَى لِلْبَشَرِ","page":575,"juz_number":29,"transcription":"Ve ma cealna ashaben nari illa melaiketen ve ma cealna ıddetehum illa fitneten lillezine keferu li yesteykınellezine utul kitabe ve yezdadellezine amenu imanen ve la yertabellezine utul kitabe vel mu'minune, ve li yekulellezine fi kulubihim maradun vel kafirune maza eradallahu bi haza mesela, kezalike yudıllullahu men yeşau ve yehdi men yeşa, ve ma ya'lemu cunude rabbike illa hu, ve ma hiye illa zikra lil beşer.","transcription_en":"Wama jaAAalna as-habaannari illa mala-ikatan wamajaAAalna AAiddatahum illa fitnatan lillatheenakafaroo liyastayqina allatheena ootoo alkitabawayazdada allatheena amanoo eemananwala yartaba allatheena ootoo alkitabawalmu/minoona waliyaqoola allatheena feequloobihim maradun walkafiroona mathaarada Allahu bihatha mathalan kathalikayudillu Allahu man yashao wayahdee man yashaowama yaAAlamu junooda rabbika illa huwa wamahiya illa thikra lilbashar","translation":{"id":312685,"text":"Cehennem ashabını[1] meleklerden[2] başkasını yapmadık. Onların sayılarını, Kafirler için bir fitneden[3] başka bir şey yapmadık. Kendilerine kitap verilenler; kesin olarak bilsinler, İman Edenler'in imanları artsın. Kendilerine kitap verilmiş iman sahipleri kuşku duymasınlar. Kalplerinde hastalık olanlarla,[4] Kafirler de desinler ki: \"Allah, bu örnekle ne demek istiyor şimdi?\" İşte böyle, Allah, hak edeni[5] dalalette bırakır, hak edeni[5] doğru yolu gösterir. Rabb'inin ordularını,[6] kendisinden başkası bilmez. Bu, beşer için zikirden[7] başka bir şey değildir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26495,"text":"Cehennem görevlilerini.","number":1},{"id":26496,"text":"Güç sahibi olanlardan. \"Mlk\" kökünden türeyen melek kelimesi, aynı zamanda \"güç sahibi, yönetim sahibi, yönetimin gücü\" anlamına da gelmektedir. Mülk, malik, melik kelimeleri de bu kökten türemişlerdir.","number":2},{"id":26497,"text":"Sınavdan.","number":3},{"id":26498,"text":"Müşrikler, gerçeğe kuşku ile bakanlar.","number":4},{"id":26499,"text":"Kelimesi kelimesine, dilediğini. \"Dilediğini demek: Hak edeni demektir; Allah, sapkınlığı gerektiren şeyleri yapanı saptırır; doğru yola iletilmeyi gerektiren şeyleri yapanı da doğru yola iletir, demektir. Allah, \"dilediğimi\" demekle, \"kimin neyi hak ettiğine en doğru kararı Ben veririm,\" demeyi kastetmektedir. Zira burada Allah'ın \"dilemesi\" insanın \"dilemesine\", \"insanın seçimine\" bağlı olarak gerçekleşmektedir. Dilemek anlamına gelen \"Şae\" kelimesinin ayetteki anlamı; \"gayret göstereni, bir şey yapmak isteyeni\" yani \"bir şeyi dileyeni\" anlamındadır. Seçim insana aittir ve belirleyici olan insanın \"dilemesi\"dir 10:108; 76:3).","number":5},{"id":26500,"text":"Görevli meleklerin sayısını.","number":6},{"id":26501,"text":"Öğütten.","number":7}]}},{"id":5527,"surah_id":74,"verse_number":32,"verse":"كَلَّا وَالْقَمَرِۙ","verse_simplified":"كَلَّا وَالْقَمَرِ","page":575,"juz_number":29,"transcription":"Kella vel kamer.","transcription_en":"Kalla walqamar","translation":{"id":312686,"text":"Hayır! Anlayan kim? Ay'a ant olsun;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5528,"surah_id":74,"verse_number":33,"verse":"وَالَّيْلِ اِذْ اَدْبَرَۙ","verse_simplified":"وَاللَّيْلِ إِذْ أَدْبَرَ","page":575,"juz_number":29,"transcription":"Vel leyli iz edber.","transcription_en":"Wallayli ith adbar","translation":{"id":312687,"text":"Ve dönüp gelen geceye;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5529,"surah_id":74,"verse_number":34,"verse":"وَالصُّبْحِ اِذَٓا اَسْفَرَۙ","verse_simplified":"وَالصُّبْحِ إِذَا أَسْفَرَ","page":575,"juz_number":29,"transcription":"Ves subhı iza esfer.","transcription_en":"Wassubhi ithaasfar","translation":{"id":312688,"text":"Ve aydınlatan sabaha.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5530,"surah_id":74,"verse_number":35,"verse":"اِنَّهَا لَاِحْدَى الْـكُبَرِۙ","verse_simplified":"إِنَّهَا لَإِحْدَى الْكُبَرِ","page":575,"juz_number":29,"transcription":"İnneha le ıhdel kuber.","transcription_en":"Innaha la-ihda alkubar","translation":{"id":312689,"text":"Kuşkusuz o en büyüklerden biridir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5531,"surah_id":74,"verse_number":36,"verse":"نَذ۪يراً لِلْبَشَرِۙ","verse_simplified":"نَذِيرًا لِّلْبَشَرِ","page":575,"juz_number":29,"transcription":"Neziren lil beşer.","transcription_en":"Natheeran lilbashar","translation":{"id":312690,"text":"Beşer[1] için uyarıcıdır;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26502,"text":"Sıradan, normal bir insan. İnsan olmanın dışında insanüstü hiçbir özelliği olmayan insan.","number":1}]}},{"id":5532,"surah_id":74,"verse_number":37,"verse":"لِمَنْ شَٓاءَ مِنْكُمْ اَنْ يَتَقَدَّمَ اَوْ يَتَاَخَّرَۜ","verse_simplified":"لِمَن شَاء مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","page":575,"juz_number":29,"transcription":"Li men şae minkum en yetekaddeme ev yeteahhar.","transcription_en":"Liman shaa minkum an yataqaddama awyataakhkhar","translation":{"id":312691,"text":"Sizden, öne geçmek isteyen için de geride kalmak isteyen için de.[1]","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26503,"text":"İman etmeyi veya küfrü seçenler için.","number":1}]}},{"id":5533,"surah_id":74,"verse_number":38,"verse":"كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَه۪ينَةٌۙ","verse_simplified":"كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ","page":575,"juz_number":29,"transcription":"Kullu nefsin bima kesebet rehineh.","transcription_en":"Kullu nafsin bima kasabat raheena","translation":{"id":312692,"text":"Herkes kazancının karşılığında bir rehinedir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5534,"surah_id":74,"verse_number":39,"verse":"اِلَّٓا اَصْحَابَ الْيَم۪ينِۜۛ","verse_simplified":"إِلَّا أَصْحَابَ الْيَمِينِ","page":575,"juz_number":29,"transcription":"İlla ashabel yemin.","transcription_en":"Illa as-haba alyameen","translation":{"id":312693,"text":"Ancak \"Ashabı Yemin[1]\" hariç.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26504,"text":"Sağın taraftarı. \"Yemin\", kelime olarak \"sağ el\" veya \"uğurlu, bereketli\" anlamına gelmektedir. Sağın taraftarı, deyim olarak; \"yüksek mertebe, seçkin, uğurlu, güç ve şeref sahibi\" demektir.","number":1}]}},{"id":5535,"surah_id":74,"verse_number":40,"verse":"ف۪ي جَنَّاتٍۜۛ يَتَسَٓاءَلُونَۙ","verse_simplified":"فِي جَنَّاتٍ يَتَسَاءلُونَ","page":575,"juz_number":29,"transcription":"Fi cennat, yetesaelun.","transcription_en":"Fee jannatin yatasaaloon","translation":{"id":312694,"text":"Cennetler içinde soracaklar;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5536,"surah_id":74,"verse_number":41,"verse":"عَنِ الْمُجْرِم۪ينَۙ","verse_simplified":"عَنِ الْمُجْرِمِينَ","page":575,"juz_number":29,"transcription":"Anil mucrimin.","transcription_en":"AAani almujrimeen","translation":{"id":312695,"text":"Suçlulara,","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5537,"surah_id":74,"verse_number":42,"verse":"مَا سَلَـكَكُمْ ف۪ي سَقَرَ","verse_simplified":"مَا سَلَكَكُمْ فِي سَقَرَ","page":575,"juz_number":29,"transcription":"Ma selekekum fi sekar.","transcription_en":"Ma salakakum fee saqar","translation":{"id":312696,"text":"Sizi Sakar'a[1] sürükleyen nedir?","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26505,"text":"Alevli ateş, Cehennem.","number":1}]}},{"id":5538,"surah_id":74,"verse_number":43,"verse":"قَالُوا لَمْ نَكُ مِنَ الْمُصَلّ۪ينَۙ","verse_simplified":"قَالُوا لَمْ نَكُ مِنَ الْمُصَلِّينَ","page":575,"juz_number":29,"transcription":"Kalu lem neku minel musallin.","transcription_en":"Qaloo lam naku mina almusalleen","translation":{"id":312697,"text":"\"Musallin[1]\" den olmadık.\" dediler.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26506,"text":"Musallin olanların kim oldukları devam eden ayetlerde bildirilmektedir. Çoğunlukla çevirilerde; \"musallin\" kelimesine, \"namaz kılanlar\" olarak anlam verilmekte ve bu ayetin çevirisi \"Namaz kılanlar hariç\" şeklinde yapılmaktadır. Oysaki bu ayetteki musallin kelimesi; şirkten arınmış bir bilinçle Allah'a yönelmek, ibadete layık yegane ilahın Allah olduğuna inanmak; yardımlaşmayı, dayanışmayı ve destek olmayı canlı ve diri tutmak, Allah'ın davasını yüceltmek için bütün gücünü seferber etmek anlamındadır.","number":1}]}},{"id":5539,"surah_id":74,"verse_number":44,"verse":"وَلَمْ نَكُ نُطْعِمُ الْمِسْك۪ينَۙ","verse_simplified":"وَلَمْ نَكُ نُطْعِمُ الْمِسْكِينَ","page":575,"juz_number":29,"transcription":"Ve lem neku nut'ımul miskin.","transcription_en":"Walam naku nutAAimu almiskeen","translation":{"id":312698,"text":"\"Miskine yediren değildik.\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5540,"surah_id":74,"verse_number":45,"verse":"وَكُنَّا نَخُوضُ مَعَ الْخَٓائِض۪ينَۙ","verse_simplified":"وَكُنَّا نَخُوضُ مَعَ الْخَائِضِينَ","page":575,"juz_number":29,"transcription":"Ve kunna nehudu maal haidin.","transcription_en":"Wakunna nakhoodu maAAa alkha-ideen","translation":{"id":312699,"text":"\"Batıl inançlara dalanlarla beraber biz de dalardık.\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5541,"surah_id":74,"verse_number":46,"verse":"وَكُنَّا نُكَذِّبُ بِيَوْمِ الدّ۪ينِۙ","verse_simplified":"وَكُنَّا نُكَذِّبُ بِيَوْمِ الدِّينِ","page":575,"juz_number":29,"transcription":"Ve kunna nukezzibu bi yevmid din.","transcription_en":"Wakunna nukaththibu biyawmi addeen","translation":{"id":312700,"text":"\"Din Günü'nü[1] yalanlardık.\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26507,"text":"Hesaba çekilme gününü.","number":1}]}},{"id":5542,"surah_id":74,"verse_number":47,"verse":"حَتّٰٓى اَتٰينَا الْيَق۪ينُۜ","verse_simplified":"حَتَّى أَتَانَا الْيَقِينُ","page":575,"juz_number":29,"transcription":"Hatta etanel yakin.","transcription_en":"Hatta atanaalyaqeen","translation":{"id":312701,"text":"\"Bize yakin[1] gelene kadar.\"","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26508,"text":"Gerçek olan ölüm gelip çatana kadar.","number":1}]}},{"id":5543,"surah_id":74,"verse_number":48,"verse":"فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشَّافِع۪ينَۜ","verse_simplified":"فَمَا تَنفَعُهُمْ شَفَاعَةُ الشَّافِعِينَ","page":576,"juz_number":29,"transcription":"Fe ma tenfeuhum şefaatuş şafiin.","transcription_en":"Fama tanfaAAuhum shafaAAatu ashshafiAAeen","translation":{"id":312702,"text":"Artık şefaatçilerin[1] şefaati[2] onlara yarar sağlamaz.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26509,"text":"Yardımcıların.","number":1},{"id":26510,"text":"Hiçbir yardımcının yardımı.","number":2}]}},{"id":5544,"surah_id":74,"verse_number":49,"verse":"فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِض۪ينَۙ","verse_simplified":"فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِينَ","page":576,"juz_number":29,"transcription":"Fe ma lehum anit tezkireti mu'rıdin.","transcription_en":"Fama lahum AAani attathkiratimuAArideen","translation":{"id":312703,"text":"Onlara ne oluyor ki zikirden[1] yüz çeviriyorlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26511,"text":"Kur'an'ın öğütlerinden. Hatırlatmalarından.","number":1}]}},{"id":5545,"surah_id":74,"verse_number":50,"verse":"كَاَنَّهُمْ حُمُرٌ مُسْتَنْفِرَةٌۙ","verse_simplified":"كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ","page":576,"juz_number":29,"transcription":"Ke ennehum humurun mustenfireth.","transcription_en":"Kaannahum humurun mustanfira","translation":{"id":312704,"text":"Sanki ürkmüş yabani eşekler gibidirler;","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5546,"surah_id":74,"verse_number":51,"verse":"فَرَّتْ مِنْ قَسْوَرَةٍۜ","verse_simplified":"فَرَّتْ مِن قَسْوَرَةٍ","page":576,"juz_number":29,"transcription":"Ferret min kasvereh.","transcription_en":"Farrat min qaswara","translation":{"id":312705,"text":"Aslandan kaçan.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5547,"surah_id":74,"verse_number":52,"verse":"بَلْ يُر۪يدُ كُلُّ امْرِئٍ مِنْهُمْ اَنْ يُؤْتٰى صُحُفاً مُنَشَّرَةًۙ","verse_simplified":"بَلْ يُرِيدُ كُلُّ امْرِئٍ مِّنْهُمْ أَن يُؤْتَى صُحُفًا مُّنَشَّرَةً","page":576,"juz_number":29,"transcription":"Bel yuridu kullumriin minhum en yu'ta suhufen muneşşereh .","transcription_en":"Bal yureedu kullu imri-in minhum an yu/tasuhufan munashshara","translation":{"id":312706,"text":"Hayır! Onların tamamı, kendileri için yazılmış sahifeler gelmesini ister.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5548,"surah_id":74,"verse_number":53,"verse":"كَلَّاۜ  بَلْ لَا يَخَافُونَ الْاٰخِرَةَۜ","verse_simplified":"كَلَّا بَل لَا يَخَافُونَ الْآخِرَةَ","page":576,"juz_number":29,"transcription":"Kella, bel la yuhafunel ahıreh.","transcription_en":"Kalla bal la yakhafoonaal-akhira","translation":{"id":312707,"text":"Hayır! Doğrusu onlar ahiretten korkmuyorlar.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5549,"surah_id":74,"verse_number":54,"verse":"كَلَّٓا اِنَّهُ تَذْكِرَةٌۚ","verse_simplified":"كَلَّا إِنَّهُ تَذْكِرَةٌ","page":576,"juz_number":29,"transcription":"Kella innehu tezkireh.","transcription_en":"Kalla innahu tathkira","translation":{"id":312708,"text":"Hayır! Kuşkusuz, o bir öğüttür.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5550,"surah_id":74,"verse_number":55,"verse":"فَمَنْ شَٓاءَ ذَكَرَهُۜ","verse_simplified":"فَمَن شَاء ذَكَرَهُ","page":576,"juz_number":29,"transcription":"Fe men şae zekereh.","transcription_en":"Faman shaa thakarah","translation":{"id":312709,"text":"Dileyen ondan öğüt alır.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":null}},{"id":5551,"surah_id":74,"verse_number":56,"verse":"وَمَا يَذْكُرُونَ اِلَّٓا اَنْ يَشَٓاءَ اللّٰهُۜ  هُوَ اَهْلُ التَّقْوٰى وَاَهْلُ الْمَغْفِرَةِ","verse_simplified":"وَمَا يَذْكُرُونَ إِلَّا أَن يَشَاء اللَّهُ هُوَ أَهْلُ التَّقْوَى وَأَهْلُ الْمَغْفِرَةِ","page":576,"juz_number":29,"transcription":"Ve ma yezkurune illa en yeşaallah, huve ehlut takva ve ehlul magfireh.","transcription_en":"Wama yathkuroona illaan yashaa Allahu huwa ahlu attaqwawaahlu almaghfirat","translation":{"id":312710,"text":"Allah dilemedikçe[1] onlar öğüt almazlar. O, takvaya ehildir[2] ve bağışlamaya ehildir.","author":{"id":105,"name":"Erhan Aktaş","language":"tr","description":"Kerim Kur'an"},"footnotes":[{"id":26512,"text":"Zorla yaptırmadıkça. Verdiği irade ve seçme özgürlüğünü yok etmedikçe.","number":1},{"id":26513,"text":"Allah, koyduğu kurallarla, kötü ve zararlı şeylere karşı korumada ve bağışlamada yetkin ve yeterlidir.","number":2}]}}]}}